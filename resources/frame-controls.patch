+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc', default=os.environ.get('CC') or shutil.which('clang') or shutil.which('cc'))
+    args = parser.parse_args()
+    assert args.cc, 'Select a C11 host compiler with --cc'
+    player = (ROOT/'source/game/player_control.c').read_text()
+    platform = (ROOT/'port/linux/src/vr.c').read_text()
+    renderer = (ROOT/'port/linux/game/vr_render.c').read_text()
+    query = function(renderer, 'vr_render_vehicle_driving')
+    assert 'object_get_node_matrix' not in re.sub(r'/\*.*?\*/', '', query, flags=re.S)
+    early, sample, refresh, aim, tail = integration(player)
+    harness = HARNESS.replace('@@QUERY@@',function(renderer,'vr_render_vehicle_yaw')+'\n'+query).replace('@@REGISTER@@',function(player,'player_control_vr_vehicle_controls'))
+    input_function = function(player, 'get_local_player_input_blob')
+    normalize_start = input_function.index('if (magnitude_squared2d(&input->throttle) > 1.f)')
+    normalization = input_function[normalize_start:block_end(input_function,input_function.index('{',normalize_start))]
+    harness = harness.replace('@@NORMALIZE@@',normalization).replace('@@BRAKE@@',function(platform,'halo_vr_vehicle_brake')).replace('@@ACCELERATOR@@',function(platform,'halo_vr_vehicle_accelerator'))
+    for key, code in (('EARLY',early),('SAMPLE',sample),('REFRESH',refresh),('AIM',aim),('TAIL',tail)):
+        harness = harness.replace('@@'+key+'@@',code)
+    with tempfile.TemporaryDirectory(prefix='halo-vr-driving-game-',ignore_cleanup_errors=True) as directory:
+        temp=Path(directory);source=temp/'test.c';executable=temp/('test.exe' if os.name=='nt' else 'test')
+        source.write_text(harness)
+        command=[args.cc,'-std=c11','-Wall','-Wextra','-Werror','-I'+str(ROOT/'port/linux/src'),str(source)]
+        if os.name!='nt': command.append('-lm')
+        subprocess.run([*command,'-o',str(executable)],cwd=temp,check=True)
+        subprocess.run([str(executable)],cwd=temp,check=True)
+
+
+if __name__=='__main__': main()
