+    assert reticle.normalized(old_body) == reticle.normalized(new_body[new_body.index('{'):])
+    reconnect = reticle.function(lights, 'light_reconnect_to_map')
+    assert 'light_compute_render_bounding_sphere' not in reconnect and 'light_compute_bounding_sphere(' in reconnect
+    preprocess = reticle.function(lights, 'lights_preprocess_scene')
+    assert preprocess.index('lights_vr_include_unarmed_flashlights();') < preprocess.index('light_marker_end();')
+    assert preprocess.index('light_vr_unarmed_flashlight_pose(light, &light_parameters.position,') < preprocess.index('rasterizer_light_submit(')
+    helper = reticle.function(render, 'vr_render_player_flashlight_pose')
+    assert 'halo_vr_view(' not in helper and 'weapon_camera.position' in helper
+    names = ['light_vr_unarmed_flashlight_pose', 'lights_vr_include_unarmed_flashlights',
+             'light_compute_bounding_sphere_from_basis', 'light_compute_bounding_sphere',
+             'light_compute_render_bounding_sphere', 'light_render_skips_clusters',
+             'light_get_bounding_sphere', 'lights_render_diffuse', 'lights_render_specular']
+    production = helper + '\n\n' + '\n\n'.join(reticle.function(lights, name) for name in names)
+    extension = LIGHT_FIXTURE.replace('@@FLASHLIGHT_FUNCTIONS@@', production)
+    harness = reticle.HARNESS
+    view_header = (ROOT / 'port/linux/src/vr.h').read_text()
+    view_begin = view_header.index('struct halo_vr_view\n{')
+    view_end = reticle.block_end(view_header, view_header.index('{', view_begin))
+    harness = re.sub(r'struct halo_vr_view \{[^\n]+\};',
+                     lambda match: view_header[view_begin:view_end] + ';', harness)
+    harness = harness.replace('boolean active,crosshairs_drawn;',
