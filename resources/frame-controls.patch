+#!/usr/bin/env python3
+"""Execute production LAN/Internet campaign menu routes in flat and VR builds.
+
+Validate actual generated XML, event dispatch, map and browser filters,
+failure/cancel cleanup and one-player-per-machine campaign guards. No game,
+network or headset is used; compile the extracted C with warnings as errors.
+"""
+import argparse
+import importlib.util
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def mask(text):
+    return re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                  lambda match: re.sub(r'[^\n]', ' ', match.group()), text, flags=re.S)
+
+
+def block(text, start):
+    hidden = mask(text)
+    opening = hidden.index('{', start)
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (hidden[end] == '{') - (hidden[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+def function(text, name):
+    found = re.search(r'(?:static\s+)?(?:boolean|void|short|int|char const\s*\*)\s*' + re.escape(name) +
+                      r'\s*\([^;]*?\)\s*\{', text)
+    if not found:
+        raise AssertionError('Missing production helper: ' + name)
+    return block(text, found.start())
+
+
+def source_integration():
+    menu = (ROOT / 'port/linux/game/menu_functions.c').read_text()
+    events = (ROOT / 'source/interface/ui_widget_event_handler_functions.c').read_text()
+    widget = (ROOT / 'source/interface/ui_widget.c').read_text()
+    asset = ROOT / 'port/assets/menus/ce/main_menu.multiplayer_type_select.coop.xml'
+    spec = importlib.util.spec_from_file_location('coop_settings_generator', ROOT / 'tools/port_settings.py')
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    assert asset.read_text() == '\n'.join(generator.multiplayer_files()[asset.name])
+    xml = ET.parse(asset).getroot()
+    nodes = {node.attrib['name'].rsplit('/', 1)[-1]: node for node in xml}
+    for button in ('a', 'start'):
+        handler = next(node for node in nodes['multiplayer_type_coop_item'] if node.attrib.get('event') == button)
+        assert handler.attrib['run'] == 'port coop begin'
+        assert handler.attrib['open'].endswith('coop/network_screen') and handler.attrib['branch'] == 'true'
+    for button in ('b', 'back'):
+        handler = next(node for node in nodes['network_screen'] if node.attrib.get('event') == button)
+        assert handler.attrib['run'] == 'port coop begin' and handler.attrib['back'] == 'true'
+    captions = {'coop_host_lan': 'HOST LOCAL (LAN)', 'coop_join_lan': 'JOIN LOCAL (LAN)',
+                'coop_host_online': 'HOST ONLINE (INTERNET)', 'coop_join_online': 'JOIN ONLINE (INTERNET)',
+                'coop_join_invite': 'JOIN INVITE LINK'}
+    for name, caption in captions.items():
+        assert nodes[name].attrib['text'] == caption and len(name) <= 31
+        for button in ('a', 'start'):
+            handler = next(node for node in nodes[name] if node.attrib.get('event') == button)
+            assert handler.attrib == {'event': button, 'run': 'port coop begin'}
+    assert 'player_2_profile_screen' not in nodes and 'player_2_profile_list' not in nodes
+    assert not any(node.attrib.get('run', '').startswith('port coop player 2') for node in xml.iter())
+    assert len([name for name in nodes if name.startswith('list_item_')]) == 11
+    assert 'player_2_button_bar' in nodes
+    lobby = ET.parse(ROOT / 'port/assets/menus/ce/main_menu.multiplayer_type_select.lobby.xml').getroot()
+    prefix = 'main_menu/multiplayer_type_select/coop/'
+    for node in lobby.iter():
+        reference = node.attrib.get('widget', '')
+        if reference.startswith(prefix):
+            assert reference[len(prefix):] in nodes
+    assert '"port coop begin"' in (ROOT / 'port/linux/game/menu_tags.c').read_text()
+    assert 'player_spawn_count = 2;' not in menu and 'vr_cooperative_begin' not in menu
+    dispatcher = function(menu, 'pc_menu_event_function_invoke')
+    coop = block(dispatcher, dispatcher.index('else if (!strcmp(name, "port coop begin"))'))
+    assert '#ifdef' not in coop and 'return cooperative_begin(' in coop
+    stale = block(dispatcher, dispatcher.index('else if (!strcmp(name, "port coop player 2 list initialize")'))
