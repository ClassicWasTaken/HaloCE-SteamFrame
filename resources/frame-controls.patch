+        CHECK(vr_render_player_flashlight_pose(0,&position,&forward,&up));
+        point_equal(position,expected_position); direction_equal(forward,expected_forward);
+    }
+    /* Hand/controller height must not be replaced by the observer/HMD origin. */
+    fixture_observer.position.z=12; vr_render.weapon_camera.position.z=-0.2f;
+    CHECK(vr_render_player_flashlight_pose(0,&position,&forward,&up)); CHECK(near(position.z,-0.2f));
+    vr_render.view.hand_forward[0]=0; vr_render.view.hand_forward[1]=0; vr_render.view.hand_forward[2]=1;
+    CHECK(vr_render_player_flashlight_pose(0,&position,&forward,&up));
+    CHECK(near(forward.k,sinf(DEGREES_TO_RADIANS(85.f)))); CHECK(near(dot_product3d(&forward,&up),0));
+    vr_render.view.hand_forward[2]=-1;
+    CHECK(vr_render_player_flashlight_pose(0,&position,&forward,&up)); CHECK(near(forward.k,-sinf(DEGREES_TO_RADIANS(85.f))));
+    vr_render.view.hand_forward[0]=1; vr_render.view.hand_forward[2]=0; vr_render.base_yaw=0;
+    vr_render.weapon_camera.up=(real_vector3d){0,1,0};
+    CHECK(vr_render_player_flashlight_pose(0,&position,&forward,&up)); direction_equal(up,(real_vector3d){0,1,0});
+}
+static void check_flashlight_rejection(void) {
+    int scenario;
+    for(scenario=0;scenario<20;scenario++) {
+        real_point3d position={11,12,13}; real_vector3d forward={14,15,16},up={17,18,19};
+        flashlight_reset();
+        switch(scenario) {
+        case 0: vr_render.active=FALSE; break;
+        case 1: vr_render.weapon_camera_set=FALSE; break;
+        case 2: vr_render.weapon_camera_valid=FALSE; break;
+        case 3: fixture_vr_aiming=FALSE; break;
+        case 4: fixture_tracking_valid=FALSE; break;
+        case 5: render.local_player_index=1; break;
+        case 6: fixture_weapon_count[0]=1; break;
+        case 7: inventory[0]=0; break;
+        case 8: units[0].object.damage_flags=1u<<_object_dead_bit; break;
+        case 9: units[0].object.parent_object_index=1; break;
+        case 10: units[0].unit.gunner_object_index=1; break;
+        case 11: fixture_cinematic=TRUE; break;
+        case 12: fixture_inhibited=TRUE; break;
+        case 13: fixture_perspective=0; break;
+        case 14: vr_render.weapon_camera.position.z=NAN; break;
+        case 15: vr_render.weapon_camera.up.i=NAN; break;
+        case 16: vr_render.weapon_camera.up=(real_vector3d){0,1,0}; break; /* parallel to default pointing */
+        case 17: vr_render.view.hand_forward[1]=NAN; break;
+        case 18: fixture_local_player=NONE; break;
+        case 19: fixture_scripted_camera=TRUE; break;
+        }
+        CHECK(!vr_render_player_flashlight_pose(0,&position,&forward,&up));
+        point_equal(position,(real_point3d){11,12,13}); direction_equal(forward,(real_vector3d){14,15,16});
+        direction_equal(up,(real_vector3d){17,18,19});
+        lights_vr_include_unarmed_flashlights(); CHECK(data_next_calls==0);
+    }
+    flashlight_reset(); {
+        real_point3d position; real_vector3d forward,up;
+        CHECK(!vr_render_player_flashlight_pose(1,&position,&forward,&up));
+        CHECK(!vr_render_player_flashlight_pose(NONE,&position,&forward,&up));
+        CHECK(!vr_render_player_flashlight_pose(0,NULL,&forward,&up));
+        CHECK(!vr_render_player_flashlight_pose(0,&position,NULL,&up));
+        CHECK(!vr_render_player_flashlight_pose(0,&position,&forward,NULL));
