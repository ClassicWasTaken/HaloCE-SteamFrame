+        }
+        switch (corruption) {
+            case 0: case 1: vr.views.head.orientation[1] = NAN; break;
+            case 2: vr.views.head.orientation[3] = INFINITY; break;
+            case 3: memset(vr.views.head.orientation, 0, sizeof(vr.views.head.orientation)); break;
+            case 4: vr.views.head.orientation[3] = 10.0f; break;
+        }
+        /* A pose incorrectly marked valid must neither count movement nor
