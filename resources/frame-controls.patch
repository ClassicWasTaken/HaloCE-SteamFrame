+#!/usr/bin/env python3
+"""Host regressions for production VR tutorial gates; no headset or map required.
+
+An optional --xbox-a10 reads an authorized local Xbox map passively to verify
+the actual tutorial predicates. Its bytes and scripts are never saved or copied.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import struct
+import subprocess
+import tempfile
+import zlib
+
+import test_vr_locomotion as walking
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def function(source, name):
+    match = re.search(r'(?:static\s+)?(?:void|float|int|boolean)\s+' + re.escape(name) +
+                      r'\s*\([^;]*?\)\s*\{', source)
+    assert match, f'Missing production function {name}'
+    code = walking.masked(source)
+    end = code.index('{', match.start()) + 1
+    depth = 1
+    while depth:
+        depth += (code[end] == '{') - (code[end] == '}')
+        end += 1
+    return source[match.start():end]
+
+
+TURN_CHECKS = r'''
+static int camera_enabled = 1, paused;
+enum { _object_dead_bit = 0 };
+static struct unit_datum { struct { unsigned long damage_flags; } object; } living;
+static struct unit_datum *unit_try_and_get(long index) { return index == NONE ? NULL : &living; }
+static int player_control_vr_vehicle_controls(long unit_index,float *hull_yaw) {
+    (void)unit_index; *hull_yaw=0; return 0;
+}
+static int player_control_camera_control_is_active(void) { return camera_enabled && !paused; }
+static void turn_control_dispatch(void) {
+    int vr_driving_mode=0; float vr_hull_yaw=0;
+    @@TURN_CONTROL@@
+    CHECK(vr_driving_mode==0 && vr_hull_yaw==0);
+}
+
+static void note_idle(void) {
+    const real_euler_angles2d still = { 0.f, 0.f };
+    const real_vector2d idle = { 0.f, 0.f };
+    player_control_action_test_note(0, &still, &idle, 0.f);
+}
+static void tutorial_reset(void) {
+    reset_state(); settings.snap_angle = (float)M_PI / 4.f;
+    vr.snap_latched = 0; camera_enabled = 1; paused = inhibited = cinematic = 0;
+    living.object.damage_flags = 0; player->unit_index = 7; local_player_index = 0;
+    player_control_action_test_reset();
+}
+static void check_snap_and_reset(void) {
+    float yaw, pitch, before;
+    tutorial_reset();
+    /* Reproduce input-disabled cryopod: the script freezes game-facing,
+       but free look and the displayed body-yaw turn remain permitted. */
+    turn_control_dispatch(); CHECK(vr.turn_control_allowed);
+    tutorial_turn_input(0.9f, 0.016f); CHECK(close_float(vr.body_yaw, -(float)M_PI / 4.f));
+    note_idle(); CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_right_bit));
+    CHECK(!TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit));
+    player_control_action_test_reset(); before = vr.body_yaw;
+    tutorial_turn_input(0.9f, 0.016f); note_idle();
+    CHECK(close_float(vr.body_yaw, before)); CHECK(tutorial.action_flags == 0); /* held stick */
+    tutorial_turn_input(0.f, 0.016f); tutorial_turn_input(-0.9f, 0.016f); note_idle();
+    CHECK(close_float(vr.body_yaw, 0.f));
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit));
+    /* Multiple render frames between game ticks must retain both directions. */
+    player_control_action_test_reset(); tutorial_turn_input(0.f, 0.016f);
+    tutorial_turn_input(0.9f, 0.016f); tutorial_turn_input(0.f, 0.016f);
+    tutorial_turn_input(-0.9f, 0.016f); note_idle();
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit));
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_right_bit));
+    head_pose(0.f, 0.04f); note_idle(); head_pose(0.f, -0.04f); note_idle();
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_up_bit));
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_down_bit));
+    /* The actual a10 gate requires all four accumulated flags. */
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit) &&
+          TEST_FLAG(tutorial.action_flags, _player_control_look_relative_right_bit) &&
+          TEST_FLAG(tutorial.action_flags, _player_control_look_relative_up_bit) &&
+          TEST_FLAG(tutorial.action_flags, _player_control_look_relative_down_bit));
+    tutorial_reset(); head_pose(0.8f, 0.4f); vr.tutorial_turn_flags = 3;
+    tutorial.action_flags = tutorial.action_test_flags = ~0UL;
+    player_control_action_test_reset(); note_idle();
+    CHECK(tutorial.action_flags == 0 && tutorial.action_test_flags == 0);
+    CHECK(vr.tutorial_head_valid && vr.tutorial_turn_flags == 0);
+    CHECK(close_float(vr.tutorial_head_yaw, 0.8f) && close_float(vr.tutorial_head_pitch, 0.4f));
+    head_pose(0.805f, 0.405f); note_idle(); CHECK(tutorial.action_flags == 0);
+    head_pose(0.83f, 0.44f); note_idle();
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit));
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_up_bit));
+    tutorial_reset(); head_pose(0.6f, 0.2f); player_control_action_test_reset(); recentre(); note_idle();
+    CHECK(tutorial.action_flags == 0); /* rebasing origin is not deliberate looking */
+    tutorial_reset(); halo_vr_turn_control(0); head_pose(0.9f, 0.4f);
+    CHECK(!halo_vr_tutorial_look(&yaw, &pitch) && yaw == 0.f && pitch == 0.f);
+}
+static void check_smooth_and_controls(void) {
+    int exclusion;
+    float before;
+    tutorial_reset(); settings.smooth_turn = 1; settings.smooth_speed = 2.f;
+    tutorial_turn_input(0.6f, 0.25f); CHECK(close_float(vr.body_yaw, -0.25f));
+    note_idle(); CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_right_bit));
+    player_control_action_test_reset(); tutorial_turn_input(-0.6f, 0.25f); note_idle();
+    CHECK(close_float(vr.body_yaw, 0.f));
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit));
+    for (exclusion = 0; exclusion < 6; exclusion++) {
+        tutorial_reset();
+        switch (exclusion) {
+            case 0: camera_enabled = 0; break;
+            case 1: paused = 1; break;
+            case 2: inhibited = 1; break;
+            case 3: cinematic = 1; break;
+            case 4: player->unit_index = NONE; break;
+            case 5: living.object.damage_flags = FLAG(_object_dead_bit); break;
+        }
+        turn_control_dispatch(); CHECK(!vr.turn_control_allowed);
+        before = vr.body_yaw; tutorial_turn_input(0.9f, 0.016f);
+        head_pose(0.9f, 0.4f); note_idle();
+        CHECK(vr.body_yaw == before && tutorial.action_flags == 0 && !vr.tutorial_head_valid);
+    }
+    tutorial_reset(); settings.gamepad_aim = 1;
+    tutorial_turn_input(0.9f, 0.016f); note_idle();
+    CHECK(vr.body_yaw == 0.f && tutorial.action_flags == 0); /* gamepad owns ordinary turn */
+    tutorial_reset(); tutorial_turn_input(NAN, 0.016f); tutorial_turn_input(0.9f, INFINITY);
+    tutorial_turn_input(0.9f, -0.01f); note_idle(); CHECK(vr.body_yaw == 0.f && tutorial.action_flags == 0);
+}
+static void check_pose_masks(void) {
+    int corruption;
+    for (corruption = 0; corruption < 16; corruption++) {
+        tutorial_reset();
+        switch (corruption) {
+            case 0: vr.initialized = 0; break;
+            case 1: vr.frame = vr.pending = 0; break;
+            case 2: vr.views.should_render = 0; break;
+            case 3: vr.views.focused = 0; break;
+            case 4: vr.views.head.valid = 0; break;
+            case 5: vr.menus = 1; break;
+            case 6: vr.origin_valid = 0; break;
+            case 7: vr.aim_synced = 0; break;
+            case 8: vr.origin_yaw = NAN; break;
+            case 9: vr.body_yaw = INFINITY; break;
+            case 10: vr.views.head.orientation[0] = NAN; break;
+            case 11: vr.views.eye[0].valid = 0; break;
+            case 12: vr.views.eye[1].orientation[3] = 0.f; break;
+            case 13: vr.views.eye[0].position[2] = INFINITY; break;
+            case 14: vr.origin_position[1] = NAN; break;
+            case 15: vr.views.eye[1].orientation[0] = NAN; break;
+        }
+        CHECK(!halo_vr_gaze_tracking_valid());
+        tutorial_turn_input(0.9f, 0.016f); note_idle();
+        CHECK(tutorial.action_flags == 0 && !vr.tutorial_head_valid && vr.tutorial_turn_flags == 0);
+    }
+    tutorial_reset(); vr.frame = 0; vr.pending = 1; CHECK(halo_vr_gaze_tracking_valid());
+    vr.views.focused = 0; tutorial_turn_input(0.9f, 0.016f);
