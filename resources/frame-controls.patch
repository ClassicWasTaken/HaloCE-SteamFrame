+}
+static void bounded_steering(void){
+ int sample;float yaw,pitch,previous=-2;
+ reset();register_driver(HALO_VR_DRIVING_WARTHOG);
+ for(sample=-150;sample<=150;sample++){
+  float lateral=sample*.01f,curve=halo_vr_driving_curve(lateral);
+  CHECK(isfinite(curve)&&curve>=-1&&curve<=1&&curve>=previous);previous=curve;
+  CHECK(near(curve,-halo_vr_driving_curve(-lateral)));
