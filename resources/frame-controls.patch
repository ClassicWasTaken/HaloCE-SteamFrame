+#!/usr/bin/env python3
+"""Run production tutorial button consumption and inversion persistence logic.
+
+The same extracted input function is compiled with and without its VR branch,
+so the legacy melee leak and unchanged flat behavior are tested directly. The
+profile setter is also extracted; its disk/HUD boundaries are controlled stubs,
+not a claim that the reported headset crash has been reproduced. VR activity
+links a separate translation unit with the real vr.h declaration and extracted
+vr.c definition; no invented activity API is provided by this harness.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def function(text, name):
+    hidden = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                    lambda match: re.sub(r'[^\n]', ' ', match.group()), text, flags=re.S)
+    found = re.search(r'(?:static\s+)?(?:boolean|void|int)\s+' + re.escape(name) +
+                      r'\s*\([^;]*?\)\s*\{', hidden)
+    if not found:
+        raise AssertionError('Missing production function: ' + name)
+    start = found.start()
+    opening = hidden.index('{', start)
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (hidden[end] == '{') - (hidden[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+HARNESS = r'''
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+@@VR_HEADER@@
+typedef int boolean;
+#define FALSE 0
+#define TRUE 1
+#define NONE (-1)
+#define FLAG(bit) (1u << (bit))
+#define TEST_FLAG(value,bit) ((value) & FLAG(bit))
+#define SET_FLAG(value,bit,on) ((value) = ((value) & ~FLAG(bit)) | ((on) ? FLAG(bit) : 0u))
+#define UNICODE_STRING_LIST_TAG 123
+enum {
+    _player_control_action_bit, _player_control_accept_bit, _player_control_back_bit,
+    _player_control_zoom_bit, _player_control_input_zoom_bit,
+    _player_control_rotate_weapons_bit, _player_control_rotate_grenades_bit
+};
+enum {
+    _unit_control_action_bit, _unit_control_jump_bit, _unit_control_use_equipment_bit,
+    _unit_control_throw_grenade_bit, _unit_control_weapon_secondary_trigger_bit,
+    _unit_control_weapon_primary_trigger_bit
+};
+struct facing { float yaw,pitch; };
+struct throttle { float i,j; };
+struct input_blob {
+    boolean accept,back; unsigned unit_control_flags,player_control_flags;
+    struct facing facing_delta; struct throttle throttle; float primary_trigger;
+};
+struct player_control_globals_data {
+    unsigned action_flags,action_test_flags,suppressed_action_flags;
+};
+static struct player_control_globals_data fixture_globals;
+static struct player_control_globals_data *player_control_globals = &fixture_globals;
+static boolean controls_swapped;
+static int cinematic_skip, coop_skip, voted, skipped, votes, notes, checks;
+void fixture_set_vr_running(int initialized);
+static int cinematic_can_be_skipped(void) { return cinematic_skip; }
+static int network_coop_skip_offered(void) { return coop_skip; }
+static int network_coop_vote_skip(void) { ++votes; return voted; }
+static void main_skip_cinematic(void) { ++skipped; }
+static void player_control_action_test_note(unsigned flags,const struct facing *f,
+        const struct throttle *t,float trigger) {
+    (void)flags; (void)f; (void)t; (void)trigger; ++notes;
+}
+struct player_profile { struct { boolean invert_look; } controller_settings; };
+static struct {
+    struct { struct player_profile profile; long active_profile_index; } local_players[4];
+} player_ui_globals;
+static int saved, messaged, applied, saved_inversion, applied_inversion;
+static long string_tag = 22;
+static const wchar_t message_text[] = L"Profile saved";
+static long tag_loaded(int group,const char *path) {
+    if (group != UNICODE_STRING_LIST_TAG || strcmp(path,"ui\\shell\\strings\\temp_strings")) abort();
+    return string_tag;
+}
+static const wchar_t *unicode_string_list_get_string(long tag,long index) {
+    if(tag != string_tag || index != 1) abort(); return message_text;
+}
+static void hud_message_to_all(const wchar_t *message) { if(!message) abort(); ++messaged; }
+static void player_profile_save(long index,const struct player_profile *profile) {
+    if(index != 7 || !profile) abort(); ++saved; saved_inversion=profile->controller_settings.invert_look;
+}
+static void set_local_player_controls_from_player_profile(short local) {
+    if(local != 0) abort(); ++applied;
+    applied_inversion=player_ui_globals.local_players[0].profile.controller_settings.invert_look;
+}
+#define CHECK(condition) do { ++checks; if(!(condition)) { \
+    fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#condition); exit(1); } } while(0)
+
+/* Compile the actual legacy branch alongside the VR-enabled production code. */
+#undef HALO_VR
+@@LEGACY@@
+#define HALO_VR 1
+@@INPUT@@
+@@BACK@@
+@@ACCEPT@@
+@@INVERT@@
+
+static struct input_blob button_input(boolean down) {
+    struct input_blob input={0};
+    input.back=down;
+    input.unit_control_flags=FLAG(_unit_control_use_equipment_bit) |
+        FLAG(_unit_control_throw_grenade_bit) | FLAG(_unit_control_weapon_secondary_trigger_bit) |
+        FLAG(_unit_control_weapon_primary_trigger_bit);
+    input.player_control_flags=FLAG(_player_control_rotate_weapons_bit) |
+        FLAG(_player_control_rotate_grenades_bit) | FLAG(_player_control_input_zoom_bit);
+    return input;
+}
+static void consumed(const struct input_blob *input) {
+    CHECK(!TEST_FLAG(input->unit_control_flags,_unit_control_use_equipment_bit));
+    CHECK(!TEST_FLAG(input->unit_control_flags,_unit_control_throw_grenade_bit));
+    CHECK(!TEST_FLAG(input->unit_control_flags,_unit_control_weapon_secondary_trigger_bit));
+    CHECK(!TEST_FLAG(input->player_control_flags,_player_control_rotate_weapons_bit));
+    CHECK(!TEST_FLAG(input->player_control_flags,_player_control_rotate_grenades_bit));
+    CHECK(!TEST_FLAG(input->player_control_flags,_player_control_input_zoom_bit));
+    CHECK(TEST_FLAG(input->unit_control_flags,_unit_control_weapon_primary_trigger_bit));
+}
+static void legacy_leak_and_release(void) {
+    int swapped;
+    for(swapped=0;swapped<2;++swapped) {
+        struct input_blob input;
+        controls_swapped=swapped; fixture_set_vr_running(1); memset(&fixture_globals,0,sizeof(fixture_globals));
+        CHECK(halo_vr_running());
+        CHECK(!player_control_action_test_back()); input=button_input(TRUE);
+        original_action_test_input(&input);
+        CHECK(TEST_FLAG(input.unit_control_flags,_unit_control_use_equipment_bit));
+        memset(&fixture_globals,0,sizeof(fixture_globals)); CHECK(!player_control_action_test_back());
+        input=button_input(TRUE); player_control_action_test_check_reset_input_blob(&input);
+        consumed(&input); CHECK(player_control_action_test_back());
+        CHECK(TEST_FLAG(fixture_globals.suppressed_action_flags,_player_control_back_bit));
+        /* Script reset while B remains held must retain suppression. */
+        fixture_globals.action_test_flags=0; fixture_globals.action_flags=0;
+        input=button_input(TRUE); player_control_action_test_check_reset_input_blob(&input);
+        consumed(&input); CHECK(TEST_FLAG(fixture_globals.suppressed_action_flags,_player_control_back_bit));
+        input=button_input(FALSE); player_control_action_test_check_reset_input_blob(&input);
+        consumed(&input); CHECK(!TEST_FLAG(fixture_globals.suppressed_action_flags,_player_control_back_bit));
+        input=button_input(TRUE); player_control_action_test_check_reset_input_blob(&input);
+        CHECK(TEST_FLAG(input.unit_control_flags,_unit_control_use_equipment_bit));
+        CHECK(TEST_FLAG(input.unit_control_flags,_unit_control_throw_grenade_bit));
+        CHECK(TEST_FLAG(input.player_control_flags,_player_control_rotate_weapons_bit));
+        CHECK(TEST_FLAG(input.player_control_flags,_player_control_rotate_grenades_bit));
+    }
+}
+static void flat_equivalence(void) {
+    unsigned requested,suppressed; int swapped,accept,back;
+    fixture_set_vr_running(0);
+    CHECK(!halo_vr_running());
+    for(requested=0;requested<8;++requested) for(suppressed=0;suppressed<8;++suppressed)
+    for(swapped=0;swapped<2;++swapped) for(accept=0;accept<2;++accept) for(back=0;back<2;++back) {
+        struct player_control_globals_data initial={0}, expected;
+        struct input_blob before=button_input(back), original, current;
+        before.accept=accept; before.unit_control_flags|=FLAG(_unit_control_action_bit)|FLAG(_unit_control_jump_bit);
+        initial.action_test_flags=requested;
+        initial.suppressed_action_flags=suppressed;
+        controls_swapped=swapped; fixture_globals=initial; original=before;
+        original_action_test_input(&original); expected=fixture_globals;
+        fixture_globals=initial; current=before; player_control_action_test_check_reset_input_blob(&current);
+        CHECK(!memcmp(&original,&current,sizeof(current)));
+        CHECK(!memcmp(&expected,&fixture_globals,sizeof(fixture_globals)));
+    }
+}
+static void inversion_and_accept(void) {
+    struct input_blob input={0};
+    fixture_set_vr_running(1); controls_swapped=0; memset(&fixture_globals,0,sizeof(fixture_globals));
+    memset(&player_ui_globals,0,sizeof(player_ui_globals));
+    player_ui_globals.local_players[0].active_profile_index=7;
+    player0_look_invert_pitch(TRUE);
+    CHECK(saved==1 && applied==1 && messaged==1 && saved_inversion && applied_inversion);
+    CHECK(!player_control_action_test_accept()); CHECK(!player_control_action_test_back());
+    input=button_input(TRUE); player_control_action_test_check_reset_input_blob(&input);
+    CHECK(!player_control_action_test_accept() && player_control_action_test_back());
+    consumed(&input);
+    /* This is the tutorial's Back branch; persistence remains the real setter. */
+    player0_look_invert_pitch(FALSE);
+    CHECK(saved==2 && applied==2 && messaged==2 && !saved_inversion && !applied_inversion);
+    CHECK(!player_ui_globals.local_players[0].profile.controller_settings.invert_look);
+    player0_look_invert_pitch(TRUE);
+    CHECK(saved==3 && applied==3 && saved_inversion && applied_inversion);
+    player_ui_globals.local_players[0].active_profile_index=NONE;
+    player0_look_invert_pitch(FALSE);
+    CHECK(saved==3 && messaged==3 && applied==4 && !applied_inversion);
+    player_ui_globals.local_players[0].active_profile_index=7; string_tag=NONE;
+    player0_look_invert_pitch(TRUE); CHECK(saved==4 && messaged==4 && applied==5);
+    memset(&fixture_globals,0,sizeof(fixture_globals)); input=(struct input_blob){0}; input.accept=TRUE;
+    input.unit_control_flags=FLAG(_unit_control_jump_bit)|FLAG(_unit_control_action_bit);
+    CHECK(!player_control_action_test_accept());
+    player_control_action_test_check_reset_input_blob(&input);
+    CHECK(player_control_action_test_accept() && !player_control_action_test_back());
+    CHECK(TEST_FLAG(input.unit_control_flags,_unit_control_jump_bit));
+    cinematic_skip=1; coop_skip=1; voted=0;
+    player_control_action_test_check_reset_input_blob(&input); CHECK(votes==1 && skipped==1);
+    voted=1; player_control_action_test_check_reset_input_blob(&input); CHECK(votes==2 && skipped==1);
+}
+int main(void) {
+    legacy_leak_and_release(); flat_equivalence(); inversion_and_accept();
+    CHECK(notes>0);
+    printf("PASS: %d production tutorial-button/inversion assertions\n",checks);
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc')
+    parser.add_argument('--vcvarsall', type=Path)
+    args = parser.parse_args()
+    controls = (ROOT / 'source/game/player_control.c').read_text()
+    profile = (ROOT / 'source/interface/player_ui.c').read_text()
+    vr = (ROOT / 'port/linux/src/vr.c').read_text()
+    vr_header = ROOT / 'port/linux/src/vr.h'
+    header = vr_header.read_text()
+    assert 'input->back = gamepad->buttons[_gamepad_analog_button_b];' in controls
+    assert 'player_profile_save(' in function(profile, 'player0_look_invert_pitch')
+    actual = function(controls, 'player_control_action_test_check_reset_input_blob')
+    assert 'halo_vr_active' not in actual, 'Do not mask a nonexistent VR activity API.'
+    assert 'halo_vr_running() != 0' in actual
+    assert re.search(r'\bint\s+halo_vr_running\s*\(\s*void\s*\)\s*;', header)
+    production_activity = function(vr, 'halo_vr_running')
+    include = '#include "' + vr_header.as_posix() + '"'
+    activity_source = (include + '\nstatic struct { int initialized; } vr;\n' +
+                       production_activity + '\nvoid fixture_set_vr_running(int initialized) {\n' +
+                       '    vr.initialized = initialized;\n}\n')
+    harness = HARNESS.replace('@@INPUT@@', actual).replace('@@LEGACY@@', actual.replace(
+        'player_control_action_test_check_reset_input_blob', 'original_action_test_input'))
+    harness = harness.replace('@@VR_HEADER@@', include)
+    for placeholder,name in (('@@BACK@@','player_control_action_test_back'),
+                             ('@@ACCEPT@@','player_control_action_test_accept')):
+        harness = harness.replace(placeholder,function(controls,name))
+    harness = harness.replace('@@INVERT@@',function(profile,'player0_look_invert_pitch'))
+    compiler = args.cc or os.environ.get('CC')
+    vcvars = args.vcvarsall
+    if not compiler and os.name == 'nt':
+        installations = Path(os.environ.get('ProgramFiles','C:/Program Files')) / 'Microsoft Visual Studio'
+        candidates = sorted(installations.glob('*/**/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe'))
+        if candidates:
+            compiler = str(candidates[-1]); vcvars = vcvars or candidates[-1].parents[6] / 'Auxiliary/Build/vcvarsall.bat'
+    compiler = compiler or shutil.which('cc') or shutil.which('clang') or shutil.which('gcc')
+    if not compiler:
+        raise SystemExit('No C11 host compiler found; select one with --cc.')
+    compiler = str(Path(shutil.which(compiler) or compiler).resolve())
+    with tempfile.TemporaryDirectory(prefix='halo-vr-buttons-',ignore_cleanup_errors=True) as directory:
+        temp=Path(directory); source=temp/'test.c'; executable=temp/('test.exe' if os.name=='nt' else 'test')
+        activity=temp/'vr_activity.c'; activity_object=temp/('vr_activity.obj' if os.name=='nt' else 'vr_activity.o')
+        source.write_text(harness)
+        activity.write_text(activity_source)
+        if Path(compiler).name.lower() in ('cl','cl.exe'):
+            activity_command=[compiler,'/nologo','/std:c11','/W4','/WX','/c',
+                              '/Fo:'+str(activity_object),str(activity)]
+            command=[compiler,'/nologo','/std:c11','/W4','/WX','/D_CRT_SECURE_NO_WARNINGS',
+                     '/Fe:'+str(executable),'/Fo:'+str(temp/'test.obj'),str(source),str(activity_object)]
+        else:
+            activity_command=[compiler,'-std=c11','-Wall','-Wextra','-Werror','-c',str(activity),'-o',str(activity_object)]
+            command=[compiler,'-std=c11','-Wall','-Wextra','-Werror',str(source),str(activity_object),'-o',str(executable)]
+        for index,step in enumerate((activity_command,command)):
+            if vcvars:
+                for path in (vcvars,Path(compiler),temp):
+                    if any(character in str(path) for character in '\r\n"&|<>^%!'):
+                        raise SystemExit('Unsupported shell metacharacter in compiler/temp path.')
+                batch=temp/('compile-'+str(index)+'.cmd')
+                batch.write_text('@echo off\ncall "'+str(vcvars)+'" x64 >nul\nif errorlevel 1 exit /b 1\n'+
+                                 subprocess.list2cmdline(step)+'\n')
+                step=['cmd.exe','/d','/c',str(batch)]
+            subprocess.run(step,cwd=temp,check=True)
+        subprocess.run([str(executable)],cwd=temp,check=True)
+
+
+if __name__ == '__main__':
+    main()
