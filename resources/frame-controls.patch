+	looks around. Only a change in the physical hand line steers it. */
+	(void)halo_vr_locomotion_orientation(vr.views.head.orientation, orientation);
+	quaternion_rotate(orientation, forward, head_forward);
+	if (!halo_vr_driving_wheel(&driving, head_forward,
