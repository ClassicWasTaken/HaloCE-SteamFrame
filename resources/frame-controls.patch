+		unit_get_head_position(unit_index, &head);
+		if (!isfinite(head.x) || !isfinite(head.y) || !isfinite(head.z))
+			goto invalid_seat;
+		matrix4x3_inverse_transform_point(root, &head, &result);
+		if (!isfinite(result.x) || !isfinite(result.y) || !isfinite(result.z))
