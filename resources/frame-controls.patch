+#!/usr/bin/env python3
+"""Compile and run the production VR walking math and integration on a host.
+
+No headset, game data, SDL or OpenXR is required. Uses cc/clang/gcc on POSIX
+or Visual Studio's C11 compiler on Windows; --cc and --vcvarsall can override.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import textwrap
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def masked(text):
+    return re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                  lambda match: re.sub(r'[^\n]', ' ', match.group()), text, flags=re.S)
+
+
+def function(text, name):
+    match = re.search(r'(?:static\s+)?(?:void|float|int)\s+' + re.escape(name) +
+                      r'\s*\([^;]*?\)\s*\{', text)
+    if not match:
+        raise AssertionError(f"Missing production function: {name}")
+    code = masked(text)
+    depth = 1
+    end = code.index('{', match.start()) + 1
+    while depth:
+        depth += (code[end] == '{') - (code[end] == '}')
+        end += 1
+    return text[match.start():end]
+
+
+def source_checks(vr, player):
+    baseline = subprocess.check_output(['git', 'show', '2ae0ee4e3e8a4dfdadfd528a5b085ca699fc9ea4:port/linux/src/vr.c'],
+                                       cwd=ROOT, text=True)
+    # Seat calibration changes only the vehicle basis; the C harness below
+    # exercises original on-foot aim and walking, and test_vr_vehicle covers seats.
+    assert 'if (!vehicle_view_active())' in function(vr, 'halo_vr_aim')
+    assert function(vr, 'weapon_pointing_raw').replace('weapon_pointing_raw', 'weapon_pointing') == function(baseline, 'weapon_pointing'), 'Raw long-gun aim changed'
+    old_pad = masked(function(baseline, 'halo_vr_gamepad'))
+    new_pad = masked(function(vr, 'halo_vr_gamepad'))
+    old_pad = old_pad.replace('XINPUT_GAMEPAD_WHITE, buttons & VR_BUTTON_LEFT_BUMPER',
+                             'XINPUT_GAMEPAD_WHITE, buttons & VR_BUTTON_RIGHT_BUMPER')
+    old_pad = old_pad.replace('XINPUT_GAMEPAD_BLACK, buttons & VR_BUTTON_RIGHT_BUMPER',
+                             'XINPUT_GAMEPAD_BLACK, buttons & VR_BUTTON_LEFT_BUMPER')
+    # The Warthog consumes A/B as accelerator/brake; production driving tests
+    # execute that exception. Strip only that explicitly delimited block to
+    # compare the remaining on-foot Xbox mappings against the pinned source.
+    a_start = new_pad.index('if (!(buttons & VR_BUTTON_A))')
+    a_end = new_pad.index('if (!(buttons & VR_BUTTON_B))', a_start)
+    assert 'pad->bAnalogButtons[XINPUT_GAMEPAD_A] = 0;' in new_pad[a_start:a_end]
+    new_pad = new_pad[:a_start] + 'analog(pad, XINPUT_GAMEPAD_A, buttons & VR_BUTTON_A);\n' + new_pad[a_end:]
+    b_start = new_pad.index('if (!(buttons & VR_BUTTON_B))')
+    b_end = new_pad.index('analog(pad, XINPUT_GAMEPAD_X', b_start)
+    assert 'pad->bAnalogButtons[XINPUT_GAMEPAD_B] = 0;' in new_pad[b_start:b_end]
+    new_pad = new_pad[:b_start] + 'analog(pad, XINPUT_GAMEPAD_B, (buttons & VR_BUTTON_B) || vr.melee_frames > 0);\n' + new_pad[b_end:]
+    # The private menu ray consumes only the right trigger until released;
+    # all remaining Xbox mappings, sticks and native A/B navigation stay identical.
+    old_start = old_pad.index('trigger = (BYTE)(vr.input.right_trigger')
+    new_start = new_pad.index('if (menu_pointer_fire_blocked())')
+    old_end = old_pad.index('if (buttons & VR_BUTTON_DPAD_UP)', old_start)
+    new_end = new_pad.index('if (buttons & VR_BUTTON_DPAD_UP)', new_start)
+    assert 'pad->bAnalogButtons[XINPUT_GAMEPAD_RIGHT_TRIGGER] = 0;' in new_pad[new_start:new_end]
+    old_pad = old_pad[:old_start] + old_pad[old_end:]
+    new_pad = new_pad[:new_start] + new_pad[new_end:]
+    # Driver seats retain native right-stick input; inactive driver behavior
+    # and every original button/axis mapping remain byte-for-byte equivalent.
+    new_pad = new_pad.replace(' || driving_active()', '')
+    assert re.sub(r'\s+', '', old_pad) == re.sub(r'\s+', '', new_pad), 'Xbox controls changed beyond authorized menu trigger/bumper fix'
+    config = (ROOT / 'port/linux/src/port_config.c').read_text()
+    assert re.search(r'"vr\.movement",\s*_config_string,\s*"\\"head\\"",\s*"HALO_VR_MOVEMENT"', config)
+    hook_start = player.index('if (local_player_index == 0 && unit->object.parent_object_index == NONE &&')
+    hook_open = player.index('{', hook_start)
+    hook_end = player.index('}', hook_open) + 1
+    hook = player[hook_start:hook_end]
+    assert '!director_inhibited_facing(local_player_index)' in hook and '!cinematic_in_progress()' in hook
+    assert 'halo_vr_locomotion(player->desired_angles.yaw, &input.throttle.i, &input.throttle.j)' in hook
+    assert player.index('player->desired_angles.yaw = vr_yaw;') < hook_start
+    assert hook_end < player.index('player->throttle = input.throttle;') < player.index('update_client_queue(&action);')
+    guard = re.search(r'if \(vr_aim == 1 && \(!isfinite\(vr_yaw\) \|\| !isfinite\(vr_pitch\)\)\)\s*vr_aim = 0;', player)
+    assert guard and guard.start() < player.index('while (vr_yaw < 0.f)')
+    # Include the production statement's leading indent before dedenting.
+    # The extracted if body must retain its relative indent in generated C.
+    guard_line_start = player.rfind('\n', 0, guard.start()) + 1
+    guard_source = player[guard_line_start:guard.end()].expandtabs(4)
+    return hook, textwrap.indent(textwrap.dedent(guard_source), '    ')
+
+
+HARNESS = r'''
+#define _USE_MATH_DEFINES
+#include <math.h>
+#include <stdio.h>
