+	float ray_orientation[4], panel_orientation[4], inverse[4];
+	float direction[3], offset[3], local_origin[3], local_direction[3];
+	float distance, hit_x, hit_y, pixel_x, pixel_y;
+	int axis;
+	if (!ray || !x || !y || !ray->valid || !menu_pointer_panel_valid(panel, size) ||
+		!halo_vr_locomotion_orientation(ray->orientation, ray_orientation) ||
+		!halo_vr_locomotion_orientation(panel->orientation, panel_orientation))
+		return 0;
