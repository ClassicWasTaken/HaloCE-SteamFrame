+static int driving_tracking_valid(void)
+{
+	float orientation[4];
+	int eye, axis;
+	if (!vr.initialized || !vr.frame || !vr.views.should_render || !vr.views.focused || vr.menus ||
+		(vr.vehicle.active && vr.vehicle.orientation_valid < 0) ||
+		!vr.origin_valid || !isfinite(vr.origin_yaw) || !vr.views.head.valid ||
+		!halo_vr_locomotion_orientation(vr.views.head.orientation, orientation))
+		return 0;
+	for (axis = 0; axis < 3; axis++)
+		if (!isfinite(vr.views.head.position[axis]))
+			return 0;
+	for (eye = 0; eye < 2; eye++)
+	{
+		if (!vr.views.eye[eye].valid ||
+			!halo_vr_locomotion_orientation(vr.views.eye[eye].orientation, orientation))
+			return 0;
+		for (axis = 0; axis < 3; axis++)
+			if (!isfinite(vr.views.eye[eye].position[axis]))
+				return 0;
+	}
+	return 1;
