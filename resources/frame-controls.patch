+	extern double config_real(const char *name);
+	struct render_camera camera = global_window_parameters.camera;
+	struct render_frustum frustum = global_window_parameters.frustum;
+	short eye;
+	if (vr_render_sun_glow_begin(0, &global_window_parameters.camera, &global_window_parameters.frustum))
+	{
+		real glow_strength = rasterizer_vr_sun_glow_strength(config_real("vr.sun_glow_strength"));
