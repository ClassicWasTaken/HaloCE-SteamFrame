+  CHECK(near(yaw,.7f+curve*(float)M_PI/3)&&near(pitch,0));
+ }
+ CHECK(near(halo_vr_driving_curve(.1f),0)&&near(halo_vr_driving_curve(-.1f),0));
+ CHECK(near(halo_vr_driving_curve(1),1)&&near(halo_vr_driving_curve(-1),-1));
+ CHECK(halo_vr_vehicle_steering(8*(float)M_PI,.9f,0,&yaw,&pitch)==1&&fabsf(yaw)<(float)M_PI);
+ CHECK(!halo_vr_vehicle_steering(NAN,0,.016f,&yaw,&pitch));
+ CHECK(!halo_vr_vehicle_steering(0,0,.016f,NULL,&pitch));
+ CHECK(!halo_vr_vehicle_steering(0,0,.016f,&yaw,NULL));
