-	analog(pad, XINPUT_GAMEPAD_BLACK, buttons & VR_BUTTON_RIGHT_BUMPER);
+	/* Keep the user's Xbox layout: left bumper changes grenade, and the
+	right bumper toggles the flashlight. */
+	analog(pad, XINPUT_GAMEPAD_WHITE, buttons & VR_BUTTON_RIGHT_BUMPER);
