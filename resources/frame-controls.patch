+ register_driver(0);memset(&pad,0,sizeof(pad));pad.bAnalogButtons[XINPUT_GAMEPAD_A]=255;
+ halo_vr_gamepad(&pad);CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_A]==0);
+ vr.input.buttons=0;memset(&pad,0,sizeof(pad));halo_vr_gamepad(&pad);CHECK(!driving.accelerator_consumed);
+ vr.input.buttons=VR_BUTTON_A;halo_vr_gamepad(&pad);CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_A]==255);
+ for(mode=2;mode<=4;mode++){
+  reset();register_driver(mode);vr.input.buttons=VR_BUTTON_A;
+  CHECK(halo_vr_vehicle_accelerator(.75f)==.75f);memset(&pad,0,sizeof(pad));halo_vr_gamepad(&pad);
+  CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_A]==255);
+ }
+ reset();settings.gamepad_aim=1;register_driver(1);vr.input.buttons=VR_BUTTON_A;driving.accelerator_consumed=1;
+ CHECK(halo_vr_vehicle_accelerator(.75f)==.75f);memset(&pad,0,sizeof(pad));halo_vr_gamepad(&pad);
+ CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_A]==255);
+ reset();vr.initialized=0;CHECK(halo_vr_vehicle_accelerator(.75f)==.75f);
+ reset();register_driver(1);CHECK(halo_vr_vehicle_accelerator(NAN)==0&&driving.accelerator_blocked);
+}
+static void dedicated_brake(void){
+ int step,mode;float yaw,pitch;XINPUT_GAMEPAD pad;
+ for(step=-100;step<=100;step++){
+  reset();register_driver(1);CHECK(halo_vr_vehicle_accelerator(0)==0);
+  vr.input.buttons=VR_BUTTON_A;CHECK(halo_vr_vehicle_accelerator(0)==1);
+  vr.input.buttons=VR_BUTTON_A|VR_BUTTON_B;
+  CHECK(halo_vr_vehicle_brake()&&driving.brake_consumed);
+  CHECK(halo_vr_vehicle_accelerator(0)==0&&!driving.accelerator_blocked);
+  CHECK(halo_vr_vehicle_accelerator(-.75f)==0);
+  CHECK(halo_vr_vehicle_steering(.7f,step/100.f,.016f,&yaw,&pitch)==1);
+  CHECK(near(yaw,.7f+halo_vr_driving_curve(step/100.f)*(float)M_PI/3));
+  memset(&pad,0,sizeof(pad));pad.bAnalogButtons[XINPUT_GAMEPAD_A]=255;pad.bAnalogButtons[XINPUT_GAMEPAD_B]=255;
+  vr.melee_frames=3;halo_vr_gamepad(&pad);
+  CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_A]==0&&pad.bAnalogButtons[XINPUT_GAMEPAD_B]==0&&vr.melee_frames==0);
+  /* Releasing only B restores continuously held A without a new A edge. */
+  vr.input.buttons=VR_BUTTON_A;CHECK(!halo_vr_vehicle_brake()&&!driving.brake_consumed);
+  CHECK(halo_vr_vehicle_accelerator(0)==1);
+  vr.input.buttons=VR_BUTTON_B;CHECK(halo_vr_vehicle_brake()&&halo_vr_vehicle_accelerator(.75f)==0);
+  CHECK(!driving.accelerator_blocked); /* Released A rearms even while B held. */
+  vr.input.buttons=0;CHECK(!halo_vr_vehicle_brake()&&halo_vr_vehicle_accelerator(-.75f)==-.75f);
+ }
+ /* A physical punch or a duplicate SDL B by itself is never a brake. */
+ reset();vr.melee_frames=3;register_driver(1);CHECK(vr.melee_frames==0);
+ vr.melee_frames=3;memset(&pad,0,sizeof(pad));pad.bAnalogButtons[XINPUT_GAMEPAD_B]=255;
+ halo_vr_gamepad(&pad);CHECK(!halo_vr_vehicle_brake()&&pad.bAnalogButtons[XINPUT_GAMEPAD_B]==0&&vr.melee_frames==0);
