+#!/usr/bin/env python3
+"""Compile the production OpenXR locate functions against deterministic failures.
+
+Uses the checked-in Khronos and guest/host ABI headers. No runtime or headset
+is loaded. Verifies fresh-query validity after prior successful tracking.
+"""
+import argparse
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from tools.test_vr_projectile_reticle import function
+
+
+HARNESS = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <openxr/openxr.h>
+#include "vr_host.h"
+static unsigned checks;
+#define CHECK(c) do { checks++; if(!(c)) { fprintf(stderr,"failed line %d: %s\n",__LINE__,#c); exit(1); } } while(0)
+static struct {
+    int frame_begun;
+    XrFrameState frame;
+    XrSession session;
+    XrSpace play_space,view_space,aim_spaces[2],grip_spaces[2];
+} vr;
+static XrResult views_result,space_result[5];
+static uint32_t view_count;
+static XrViewStateFlags view_flags;
+static XrSpaceLocationFlags space_flags[5];
+static int view_calls,space_calls,generation;
+XRAPI_ATTR XrResult XRAPI_CALL xrLocateViews(XrSession session,
+    const XrViewLocateInfo *info,XrViewState *state,uint32_t capacity,
+    uint32_t *count,XrView *views) {
+    int eye;
+    CHECK(session==vr.session && capacity==2);
+    CHECK(info->type==XR_TYPE_VIEW_LOCATE_INFO && info->next==NULL);
+    CHECK(info->displayTime==vr.frame.predictedDisplayTime && info->space==vr.play_space);
+    CHECK(state->type==XR_TYPE_VIEW_STATE && state->next==NULL);
+    view_calls++;
+    if(views_result!=XR_SUCCESS) return views_result;
+    *count=view_count; state->viewStateFlags=view_flags;
+    for(eye=0;eye<2;eye++) {
+        CHECK(views[eye].type==XR_TYPE_VIEW && views[eye].next==NULL);
+        views[eye].pose.position=(XrVector3f){(float)(10*generation+eye),2,3};
+        views[eye].pose.orientation=(XrQuaternionf){0,0,0,1};
+        views[eye].fov=(XrFovf){-0.5f,0.5f,0.5f,-0.5f};
+    }
+    return XR_SUCCESS;
+}
+XRAPI_ATTR XrResult XRAPI_CALL xrLocateSpace(XrSpace space,XrSpace base,
+    XrTime time,XrSpaceLocation *location) {
+    int slot=(int)(uintptr_t)space-2;
+    CHECK(slot>=0 && slot<5 && base==vr.play_space && time==vr.frame.predictedDisplayTime);
+    CHECK(location->type==XR_TYPE_SPACE_LOCATION && location->next==NULL);
+    space_calls++;
+    if(space_result[slot]!=XR_SUCCESS) return space_result[slot];
+    location->locationFlags=space_flags[slot];
+    location->pose.position=(XrVector3f){(float)(100*generation+slot),4,5};
+    location->pose.orientation=(XrQuaternionf){0,0,0,1};
+    return XR_SUCCESS;
+}
+/* OpenXR's standard { TYPE } initializer intentionally zeroes every other
+   member. Suppress only Clang's warning about this established API idiom. */
+#ifdef __clang__
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wmissing-field-initializers"
+#endif
+@@PRODUCTION@@
+#ifdef __clang__
+#pragma clang diagnostic pop
+#endif
+static void fixture(void) {
+    int slot;
+    memset(&vr,0,sizeof(vr)); vr.frame_begun=1;
+    vr.frame.predictedDisplayTime=123456;
+    vr.session=(XrSession)(uintptr_t)1; vr.play_space=(XrSpace)(uintptr_t)1;
+    vr.view_space=(XrSpace)(uintptr_t)2;
+    vr.aim_spaces[0]=(XrSpace)(uintptr_t)3; vr.grip_spaces[0]=(XrSpace)(uintptr_t)4;
+    vr.aim_spaces[1]=(XrSpace)(uintptr_t)5; vr.grip_spaces[1]=(XrSpace)(uintptr_t)6;
+    views_result=XR_SUCCESS; view_count=2;
+    view_flags=XR_VIEW_STATE_ORIENTATION_VALID_BIT|XR_VIEW_STATE_POSITION_VALID_BIT;
+    for(slot=0;slot<5;slot++) {
+        space_result[slot]=XR_SUCCESS;
+        space_flags[slot]=XR_SPACE_LOCATION_ORIENTATION_VALID_BIT|XR_SPACE_LOCATION_POSITION_VALID_BIT;
+    }
+    view_calls=space_calls=0; generation=1;
+}
+static struct vr_host_pose *space_pose(struct vr_host_views *views,int slot) {
+    switch(slot) {
+    case 0: return &views->head;
+    case 1: return &views->aim[0];
+    case 2: return &views->grip[0];
+    case 3: return &views->aim[1];
+    default: return &views->grip[1];
+    }
+}
+static void all_valid(struct vr_host_views *views,int expected) {
+    int eye,slot;
+    for(eye=0;eye<2;eye++) CHECK(views->eye[eye].valid==expected);
+    for(slot=0;slot<5;slot++) CHECK(space_pose(views,slot)->valid==expected);
+    CHECK(views->should_render==1 && views->focused==1 && views->display_elapsed==0.01f);
+}
+static void success(struct vr_host_views *views) {
+    int eye,slot;
+    CHECK(host_vr_locate(views)); all_valid(views,1);
+    for(eye=0;eye<2;eye++) CHECK(views->eye[eye].position[0]==(float)(10*generation+eye));
+    for(slot=0;slot<5;slot++) CHECK(space_pose(views,slot)->position[0]==(float)(100*generation+slot));
+}
+int main(void) {
+    struct vr_host_views views;
+    unsigned mask; int slot,eye;
+    memset(&views,0,sizeof(views)); views.should_render=1; views.focused=1; views.display_elapsed=0.01f;
+    fixture(); success(&views);
+    views_result=XR_ERROR_RUNTIME_FAILURE; generation=2;
+    CHECK(!host_vr_locate(&views)); all_valid(&views,0);
+    CHECK(space_calls==5); /* A view failure must not query individual spaces. */
+    views_result=XR_SUCCESS; success(&views);
+    view_count=1; CHECK(!host_vr_locate(&views)); all_valid(&views,0);
+    view_count=2; success(&views);
+    vr.frame_begun=0; view_calls=space_calls=0;
+    CHECK(!host_vr_locate(&views)); all_valid(&views,0); CHECK(view_calls==0 && space_calls==0);
+    vr.frame_begun=1; success(&views);
+    for(mask=1;mask<32;mask++) {
+        fixture(); success(&views); generation=2;
+        for(slot=0;slot<5;slot++) if(mask&(1u<<slot)) space_result[slot]=XR_ERROR_RUNTIME_FAILURE;
+        CHECK(host_vr_locate(&views));
+        for(eye=0;eye<2;eye++) CHECK(views.eye[eye].valid==1 && views.eye[eye].position[0]==(float)(20+eye));
+        for(slot=0;slot<5;slot++) {
+            struct vr_host_pose *pose=space_pose(&views,slot);
+            CHECK(pose->valid==((mask&(1u<<slot)) ? 0 : 1));
+            CHECK(pose->position[0]==(float)(((mask&(1u<<slot)) ? 100 : 200)+slot));
+        }
+        for(slot=0;slot<5;slot++) space_result[slot]=XR_SUCCESS;
+        generation=3; success(&views);
+    }
+    fixture(); success(&views); view_flags=XR_VIEW_STATE_POSITION_VALID_BIT;
+    for(slot=0;slot<5;slot++) space_flags[slot]=XR_SPACE_LOCATION_POSITION_VALID_BIT;
+    CHECK(host_vr_locate(&views)); all_valid(&views,0);
+    view_flags=XR_VIEW_STATE_ORIENTATION_VALID_BIT;
+    for(slot=0;slot<5;slot++) space_flags[slot]=XR_SPACE_LOCATION_ORIENTATION_VALID_BIT;
+    CHECK(host_vr_locate(&views)); all_valid(&views,0);
+    view_flags|=XR_VIEW_STATE_ORIENTATION_VALID_BIT;
+    view_flags|=XR_VIEW_STATE_POSITION_VALID_BIT;
+    for(slot=0;slot<5;slot++) space_flags[slot]|=XR_SPACE_LOCATION_POSITION_VALID_BIT;
+    generation=2; success(&views);
+    for(slot=0;slot<5;slot++) {
+        int other;
+        space_flags[slot]=XR_SPACE_LOCATION_ORIENTATION_VALID_BIT;
+        CHECK(host_vr_locate(&views));
+        CHECK(views.eye[0].valid && views.eye[1].valid);
+        for(other=0;other<5;other++) CHECK(space_pose(&views,other)->valid==(other!=slot));
+        space_flags[slot]|=XR_SPACE_LOCATION_POSITION_VALID_BIT;
+        success(&views);
+    }
+    printf("PASS: %u production OpenXR tracking assertions\n",checks); return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc')
+    parser.add_argument('--vcvarsall', type=Path)
+    args = parser.parse_args()
+    source_text = (ROOT / 'port/linux/arm64/host_vr.c').read_text()
+    harness = HARNESS.replace('@@PRODUCTION@@', '\n\n'.join(
+        function(source_text, name) for name in ('pose_from_xr', 'host_vr_locate')))
+    compiler = args.cc or os.environ.get('CC')
+    vcvars = args.vcvarsall
+    if not compiler and os.name == 'nt':
+        installations = Path(os.environ.get('ProgramFiles', 'C:/Program Files')) / 'Microsoft Visual Studio'
+        candidates = sorted(installations.glob('*/**/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe'))
+        if candidates:
+            compiler = str(candidates[-1])
+            vcvars = vcvars or candidates[-1].parents[6] / 'Auxiliary/Build/vcvarsall.bat'
+    compiler = compiler or shutil.which('cc') or shutil.which('clang') or shutil.which('gcc')
+    if not compiler:
+        raise SystemExit('No C11 host compiler found; select one with --cc.')
+    include_paths = [ROOT / 'port/third_party/openxr', ROOT / 'port/linux/src']
+    with tempfile.TemporaryDirectory(prefix='halo-vr-tracking-check-', ignore_cleanup_errors=True) as directory:
+        temp = Path(directory)
+        source = temp / 'test.c'
+        executable = temp / ('test.exe' if os.name == 'nt' else 'test')
+        source.write_text(harness)
+        if Path(compiler).name.lower() in ('cl', 'cl.exe'):
+            command = [compiler, '/nologo', '/std:c11', '/W4', '/WX', '/D_CRT_SECURE_NO_WARNINGS',
+                       '/Fe:' + str(executable), '/Fo:' + str(temp / 'test.obj')]
+            command.extend('/I' + str(path) for path in include_paths)
+            command.append(str(source))
+            if vcvars:
+                for path in (vcvars, Path(compiler), temp):
+                    if any(character in str(path) for character in '\r\n"&|<>^%!'):
+                        raise SystemExit('Unsupported shell metacharacter in compiler/temp path.')
+                batch = temp / 'compile.cmd'
+                batch.write_text('@echo off\ncall "' + str(vcvars) + '" x64 >nul\nif errorlevel 1 exit /b 1\n' +
+                                 subprocess.list2cmdline(command) + '\n')
+                command = ['cmd.exe', '/d', '/c', str(batch)]
+        else:
+            command = [compiler, '-std=c11', '-Wall', '-Wextra', '-Werror']
+            command.extend('-I' + str(path) for path in include_paths)
+            command.append(str(source))
+            if os.name != 'nt':
+                command.append('-lm')
+            command.extend(['-o', str(executable)])
+        subprocess.run(command, cwd=temp, check=True)
+        subprocess.run([str(executable)], cwd=temp, check=True)
+
+
+if __name__ == '__main__':
+    main()
