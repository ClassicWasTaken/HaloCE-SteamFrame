+#!/usr/bin/env python3
+"""Exercise production native upload/fence functions against fault-injected GL.
+
+Requires a host C11 compiler, no headset or assets. This verifies ownership,
+fallback, bounds and ring ordering; it does not measure driver performance.
+"""
+import argparse
