+  CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_BLACK]==255&&pad.bAnalogButtons[XINPUT_GAMEPAD_WHITE]==255);
+  CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_LEFT_TRIGGER]==102&&pad.bAnalogButtons[XINPUT_GAMEPAD_RIGHT_TRIGGER]==204);
