+int halo_vr_frame_active(void) { return vr.frame; }
+int host_vr_locate(struct vr_host_views *views) { (void)views; return 1; }
+static void test_head_apply(void) {}
+static void jitter_apply(void) {}
+static void test_hands_apply(void) {}
+static void weapon_pointing(float forward[3],float up[3]);
+@@PLATFORM@@
+static void weapon_pointing(float forward[3],float up[3]) {
+    static const float f[3]={0,0,-1}, u[3]={0,1,0};
+    quaternion_rotate(vr.views.aim[1].orientation,f,forward);
+    quaternion_rotate(vr.views.aim[1].orientation,u,up);
+}
+static void pose(float yaw,float x,float y,float z) {
+    int eye;
+    vr.views.head.valid=1;
+    vr.views.head.orientation[0]=vr.views.head.orientation[2]=0;
+    vr.views.head.orientation[1]=sinf(yaw/2); vr.views.head.orientation[3]=cosf(yaw/2);
+    vr.views.head.position[0]=x; vr.views.head.position[1]=y; vr.views.head.position[2]=z;
