+	facing offset once: a moving turret marker must not feed aim back into
+	the view heading each frame. Subsequent yaw follows only the vehicle. */
+	root = object_get_node_matrix(parent_index, 0);
+	if (root)
+	{
+		forward = root->forward;
+		up = root->up;
+	}
+	if (!root || !isfinite(forward.i) || !isfinite(forward.j) || !isfinite(forward.k) ||
+		forward.i * forward.i + forward.j * forward.j < 0.0001f)
+		object_get_orientation(parent_index, &forward, &up);
