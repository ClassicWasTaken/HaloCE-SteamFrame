+        name = data[offset:offset+32].split(b'\0', 1)[0].decode('ascii')
+        if name in ('tutorial_looking', 'tutorial_setup', 'test_looking_tech', 'mission_a10') or name.startswith('test_looking_cycle_'):
+            scripts[name] = expression(u32(offset + 36))
+    def calls(tree, name):
+        found = []
+        if isinstance(tree, list):
+            if tree and tree[0] == name:
+                found.append(tree)
+            for child in tree:
+                found.extend(calls(child, name))
+        return found
