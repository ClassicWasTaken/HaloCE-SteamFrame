+/* The left axis retains a horizontal heading at vertical flight's pole.
+Both the simulation controls and calibrated seat view use the same check. */
+static boolean vr_render_vehicle_yaw(real_vector3d const *forward, real_vector3d const *up, real *heading)
+{
+	real left_i, left_j;
+	if (!isfinite(forward->i) || !isfinite(forward->j) || !isfinite(forward->k))
+		return FALSE;
+	if (forward->i * forward->i + forward->j * forward->j < 0.0001f)
+	{
+		if (!isfinite(up->i) || !isfinite(up->j) || !isfinite(up->k))
+			return FALSE;
+		left_i = up->j * forward->k - up->k * forward->j;
+		left_j = up->k * forward->i - up->i * forward->k;
+		if (!isfinite(left_i) || !isfinite(left_j) || left_i * left_i + left_j * left_j < 0.0001f)
+			return FALSE;
+		*heading = (real)atan2(-left_i, left_j);
+	}
+	else
+		*heading = (real)atan2(forward->j, forward->i);
+	return TRUE;
+}
