+	int mode, align, turn_blocked;
+	/* A is an independent accelerator, armed only after a fresh release. */
+	int accelerator_blocked, accelerator_consumed;
+	int brake_consumed;
+	float hull_yaw;
+	int wheel_valid, wheel_blocked;
+	float wheel_axis[3], wheel_line[3], wheel_steer;
+};
+
+static inline float halo_vr_driving_curve(float lateral)
+{
+	float amount;
+	if (!isfinite(lateral))
+		return 0.0f;
+	amount = fabsf(lateral);
+	if (amount <= 0.10f)
+		return 0.0f;
+	amount = (amount - 0.10f) / 0.90f;
+	if (amount > 1.0f)
+		amount = 1.0f;
+	amount = 0.40f * amount + 0.60f * amount * amount * amount;
+	return lateral < 0.0f ? -amount : amount;
+}
+
+/* Project the left-to-right hand line into the wheel's captured plane.
+The captured axis lets the driver look around without steering the wheel. */
+static inline int halo_vr_driving_line(const float axis[3], const float left[3],
+	const float right[3], float line[3])
+{
+	float distance = 0.0f, along = 0.0f, length = 0.0f;
+	int component;
+	for (component = 0; component < 3; component++)
+	{
+		if (!isfinite(axis[component]) || !isfinite(left[component]) || !isfinite(right[component]))
+			return 0;
+		line[component] = right[component] - left[component];
+		distance += line[component] * line[component];
+		along += line[component] * axis[component];
+	}
+	if (!isfinite(distance) || distance < 0.10f * 0.10f || distance > 1.20f * 1.20f)
+		return 0;
+	for (component = 0; component < 3; component++)
+	{
+		line[component] -= along * axis[component];
+		length += line[component] * line[component];
+	}
+	if (!isfinite(length) || length < 0.05f * 0.05f)
+		return 0;
+	length = sqrtf(length);
+	for (component = 0; component < 3; component++)
+		line[component] /= length;
+	return 1;
+}
+
+static inline int halo_vr_driving_wheel(struct halo_vr_driving_state *state,
+	const float head_forward[3], const float left[3], const float right[3])
+{
+	float axis[3], line[3], cross[3], length = 0.0f, along = 0.0f, across = 0.0f, angle;
+	int component;
+	for (component = 0; component < 3; component++)
+	{
+		axis[component] = state->wheel_valid ? state->wheel_axis[component] : head_forward[component];
+		if (!isfinite(axis[component]))
+			return 0;
+		length += axis[component] * axis[component];
+	}
+	if (!isfinite(length) || length < 0.000001f)
+		return 0;
+	length = sqrtf(length);
+	for (component = 0; component < 3; component++)
+		axis[component] /= length;
+	if (!halo_vr_driving_line(axis, left, right, line))
+		return 0;
+	if (!state->wheel_valid)
+	{
+		memcpy(state->wheel_axis, axis, sizeof(axis));
+		memcpy(state->wheel_line, line, sizeof(line));
+		state->wheel_valid = 1;
+		state->wheel_steer = 0.0f;
+		return 1;
+	}
+	cross[0] = state->wheel_line[1] * line[2] - state->wheel_line[2] * line[1];
+	cross[1] = state->wheel_line[2] * line[0] - state->wheel_line[0] * line[2];
+	cross[2] = state->wheel_line[0] * line[1] - state->wheel_line[1] * line[0];
+	for (component = 0; component < 3; component++)
+	{
+		along += state->wheel_line[component] * line[component];
+		across += axis[component] * cross[component];
+	}
+	angle = atan2f(across, along);
+	if (!isfinite(angle))
+		return 0;
+	/* Clockwise about head-forward means right, hence negative Halo yaw. */
+	state->wheel_steer = -angle / 0.7853981633974483f;
+	if (state->wheel_steer < -1.0f) state->wheel_steer = -1.0f;
+	if (state->wheel_steer > 1.0f) state->wheel_steer = 1.0f;
+	return 1;
+}
+#endif
