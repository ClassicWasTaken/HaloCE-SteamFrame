+ reset();register_driver(1);vr.input.buttons=VR_BUTTON_B;CHECK(halo_vr_vehicle_brake());
+ register_driver(0);memset(&pad,0,sizeof(pad));pad.bAnalogButtons[XINPUT_GAMEPAD_B]=255;
+ halo_vr_gamepad(&pad);CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_B]==0);
+ vr.input.buttons=0;memset(&pad,0,sizeof(pad));halo_vr_gamepad(&pad);CHECK(!driving.brake_consumed);
+ vr.input.buttons=VR_BUTTON_B;halo_vr_gamepad(&pad);CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_B]==255);
+ reset();register_driver(1);vr.input.buttons=VR_BUTTON_B;halo_vr_menus(1);
+ CHECK(!halo_vr_vehicle_brake());memset(&pad,0,sizeof(pad));halo_vr_gamepad(&pad);
+ CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_B]==255);
