+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_right_bit));
+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_down_bit));
+}
+int main(void) {
+    check_directions(); check_pitch_and_recentering(); check_tracking_guards();
+    check_exclusions_and_aim(); check_tutorial(); check_tutorial_tracking_recovery();
+    printf("PASS: %d production VR locomotion / input / tutorial assertions\n", checks);
+    return 0;
+}
