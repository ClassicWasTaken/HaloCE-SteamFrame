+	if (!yaw || local_player_index != 0 || !halo_vr_radar_head_heading() ||
+		(player_index = local_player_get_player_index(0)) == NONE ||
+		!vr_render_player_gaze(player_get(player_index)->unit_index, &origin, &forward))
+		return FALSE;
+	if (!isfinite(forward.i) || !isfinite(forward.j) || !isfinite(forward.k))
+		return FALSE;
+	horizontal_squared = forward.i * forward.i + forward.j * forward.j;
