+ vr.views.grip[1].position[2]-=.4f;input_update();CHECK(vr.melee_frames==0&&!halo_vr_vehicle_brake());
+ register_driver(0);vr.views.grip[1].position[2]-=.4f;input_update();CHECK(vr.melee_frames==3);
