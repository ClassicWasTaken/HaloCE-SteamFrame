+} vr;
+static struct {
+    int vehicle_first_person,vehicle_seat_calibration,vehicle_clear_windshield;
+    int standing,gamepad_aim,gamepad_snap,gamepad_pitch,controller_aim,floating_hands,arms;
+    float player_height,snap_angle,hud_size,world_scale,weapon_offset[3],shoulder_offset[3];
+} settings;
+static void settings_read(void) {}
