+			/* World heading differences are not local seat yaw on a
+			tilted hull. Project both marker axes into that rigid frame. */
+			forward.i = hull_axes[0][0] * marker.matrix.forward.i + hull_axes[0][1] * marker.matrix.forward.j + hull_axes[0][2] * marker.matrix.forward.k;
+			forward.j = hull_axes[1][0] * marker.matrix.forward.i + hull_axes[1][1] * marker.matrix.forward.j + hull_axes[1][2] * marker.matrix.forward.k;
+			forward.k = hull_axes[2][0] * marker.matrix.forward.i + hull_axes[2][1] * marker.matrix.forward.j + hull_axes[2][2] * marker.matrix.forward.k;
+			up.i = hull_axes[0][0] * marker.matrix.up.i + hull_axes[0][1] * marker.matrix.up.j + hull_axes[0][2] * marker.matrix.up.k;
+			up.j = hull_axes[1][0] * marker.matrix.up.i + hull_axes[1][1] * marker.matrix.up.j + hull_axes[1][2] * marker.matrix.up.k;
+			up.k = hull_axes[2][0] * marker.matrix.up.i + hull_axes[2][1] * marker.matrix.up.j + hull_axes[2][2] * marker.matrix.up.k;
