+int halo_vr_vehicle_steering(float hull_yaw, float lateral, float seconds, float *yaw, float *pitch)
+{
+	float steer;
+	if (!yaw || !pitch || !driving_active() || driving.mode != HALO_VR_DRIVING_WARTHOG || !isfinite(hull_yaw))
+		return 0;
+	if (!driving_tracking_valid() || !isfinite(lateral) || !isfinite(seconds) || seconds < 0.0f)
+	{
+		driving_reset(1);
+		driving.accelerator_blocked = 1;
+		*yaw = remainderf(hull_yaw, 2.0f * (float)M_PI);
