+static void corrupt_pose(int corruption) {
+    switch (corruption) {
+    case 0: vr.initialized = 0; break;
+    case 1: vr.views.should_render = 0; break;
+    case 2: vr.views.focused = 0; break;
+    case 3: vr.views.head.valid = 0; break;
+    case 4: vr.views.head.position[0] = NAN; break;
+    case 5: vr.views.head.position[1] = INFINITY; break;
+    case 6: vr.views.head.position[2] = -INFINITY; break;
+    case 7: vr.views.head.orientation[0] = NAN; break;
+    case 8: vr.views.head.orientation[1] = INFINITY; break;
+    case 9: memset(vr.views.head.orientation, 0, sizeof(vr.views.head.orientation)); break;
+    case 10: vr.views.head.orientation[3] = 2.f; break;
+    case 11: settings.menu_distance = NAN; break;
+    case 12: settings.menu_distance = 0.f; break;
+    }
