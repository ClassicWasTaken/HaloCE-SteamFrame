+ CHECK(color_fixture.last_rendered==42);CHECK(vr_gl.frame_failed); /* Failure is latched until present. */
+ vr_present(1);CHECK(submitted==1&&!submitted_eyes&&!submitted_hud&&!depth_copies&&!screenshots);
+ CHECK(!vr_gl.frame_failed&&!vr_gl.eyes_drawn&&!vr_gl.hud_drawn);
