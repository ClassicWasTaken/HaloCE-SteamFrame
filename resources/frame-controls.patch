+#!/usr/bin/env python3
+"""Run production stereo sun projection, dispatch and shader-sampling checks.
+
+Host C11 compiler only; no headset, game data, SDL or OpenXR is required.
+This validates CPU/matrix and shader source contracts, not GPU visual output.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def function(text, name):
+    match = re.search(r'(?:static\s+)?(?:void|float|real|int|boolean)\s+' + re.escape(name) +
+                      r'\s*\([^;]*?\)\s*\{', text)
+    assert match, name
+    masked = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                    lambda item: re.sub(r'[^\n]', ' ', item.group()), text, flags=re.S)
+    end, depth = masked.index('{', match.start()) + 1, 1
+    while depth:
+        depth += (masked[end] == '{') - (masked[end] == '}')
+        end += 1
+    return text[match.start():end]
+
+
+HARNESS = r'''
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+typedef float real;
+typedef int boolean;
+typedef int BOOL;
+typedef unsigned int DWORD;
+#define TRUE 1
+#define FALSE 0
+#define MIN(a,b) ((a) < (b) ? (a) : (b))
+#define D3DRS_PS_MAX 128
+#define SAMPLE_BIAS ""
+static int checks;
+#define CHECK(condition) do { checks++; if (!(condition)) { \
+    fprintf(stderr, "failed line %d: %s\n", __LINE__, #condition); exit(1); } } while (0)
+static int near_float(float a, float b) { return fabsf(a - b) < 0.002f; }
+typedef struct { real x, y, z; } real_point3d;
+typedef struct { real i, j; } real_vector2d;
+typedef struct { short x0, y0, x1, y1; } rectangle2d;
+typedef struct { real n[4][3]; } real_matrix4x3;
+struct render_camera { real_point3d position; rectangle2d viewport_bounds; real marker; };
+struct render_frustum { real_matrix4x3 world_to_view; real projection_matrix[4][4]; real marker; };
+struct rasterizer_lens_flare_submit_parameters { real_point3d position; };
+static struct { struct render_camera camera; struct render_frustum frustum; } global_window_parameters;
+static struct { boolean active; struct render_camera eye_cameras[2]; struct render_frustum eyes[2]; } vr_render;
+static struct { int screen_space, screen_points, eye_alone; unsigned long eye_serial; } vr_gl;
+static int corrections_calls;
+static void halo_vr_set_screen_corrections(const float corrections[2][4]) {
+    static const float identity[2][4] = { { 1.0f, 1.0f, 0.0f, 0.0f }, { 1.0f, 1.0f, 0.0f, 0.0f } };
+    CHECK(memcmp(corrections, identity, sizeof(identity)) == 0);
+    vr_gl.screen_points = 0; corrections_calls++;
+}
+static void matrix4x3_transform_point(const real_matrix4x3 *matrix, const real_point3d *point, real_point3d *out) {
+    out->x = matrix->n[0][0]*point->x + matrix->n[1][0]*point->y + matrix->n[2][0]*point->z + matrix->n[3][0];
+    out->y = matrix->n[0][1]*point->x + matrix->n[1][1]*point->y + matrix->n[2][1]*point->z + matrix->n[3][1];
+    out->z = matrix->n[0][2]*point->x + matrix->n[1][2]*point->y + matrix->n[2][2]*point->z + matrix->n[3][2];
+}
+@@FUNCTIONS@@
+enum { XGPU_MULTIVIEW_NONE, XGPU_MULTIVIEW_EYES, XGPU_MULTIVIEW_LEFT_EYE, XGPU_MULTIVIEW_RIGHT_EYE };
+enum { _xgpu_sampler_none, _xgpu_sampler_2d, _xgpu_sampler_3d, _xgpu_sampler_cube, _xgpu_sampler_2d_layered };
+@@KEY@@
+@@OLD_KEY@@
+struct xgpu_text { char buffer[2048]; unsigned long length; };
+static void xgpu_text_append(struct xgpu_text *text, const char *format, ...) {
+    va_list arguments;
+    int count;
+    va_start(arguments, format);
+    count = vsnprintf(text->buffer + text->length, sizeof(text->buffer) - text->length, format, arguments);
+    va_end(arguments);
+    CHECK(count > 0 && (unsigned long)count < sizeof(text->buffer) - text->length);
+    text->length += (unsigned long)count;
+}
+@@SAMPLE@@
+static void choose_source_eye(struct nv2a_pixel_shader_key *output) {
+    struct nv2a_pixel_shader_key key = *output;
+    @@SAMPLE_BINDING@@
+    *output = key;
+}
+static int draws, draw_eye[2], visible[2];
+static float draw_x[2], draw_y[2], depth[2], wall_depth[2];
+static double configured_glow = 0.5;
+static float composite_strength[2];
+static double config_real(const char *name) {
+    CHECK(strcmp(name, "vr.sun_glow_strength") == 0);
+    return configured_glow;
+}
+@@STRENGTH@@
+static void rasterizer_sun_glow_draw_internal(struct rasterizer_lens_flare_submit_parameters const *flare, real glow_strength) {
+    real_point3d center;
+    real_vector2d axes;
+    struct nv2a_pixel_shader_key key;
+    struct xgpu_text text;
+    int slot = draws++;
+    CHECK(slot < 2); composite_strength[slot] = glow_strength;
+    if (!vr_render.active) return;
+    CHECK(vr_gl.screen_space && !vr_gl.screen_points);
+    CHECK(vr_gl.eye_alone == slot); CHECK(global_window_parameters.camera.marker == (float)(slot + 1));
+    CHECK(rasterizer_project_billboard(&flare->position, 0.5f, &center, &axes));
+    draw_eye[slot] = vr_gl.eye_alone; draw_x[slot] = center.x; draw_y[slot] = center.y; depth[slot] = center.z;
+    /* The unchanged legacy mask uses ZENABLE + LESSEQUAL against this
+    eye's depth, then this eye alone is copied into the shared scratch. */
+    visible[slot] = center.z <= wall_depth[slot];
+    memset(&key, 0, sizeof(key)); memset(&text, 0, sizeof(text));
+    key.sampler_type[0] = _xgpu_sampler_2d_layered; key.multiview = XGPU_MULTIVIEW_NONE;
+    choose_source_eye(&key); sample(&text, &key, 0, "point");
+    CHECK(key.sample_eye == slot);
+    CHECK(strstr(text.buffer, slot ? ", 1.0)" : ", 0.0)") != NULL);
+}
+@@WRAPPER@@
+static void frustum(struct render_frustum *target, float eye, const float fov[4], float near_z, float far_z) {
+    memset(target, 0, sizeof(*target));
+    target->world_to_view.n[0][0] = target->world_to_view.n[1][1] = target->world_to_view.n[2][2] = 1.0f;
+    target->world_to_view.n[3][0] = -eye;
+    target->projection_matrix[0][0] = 2.0f / (fov[1] - fov[0]);
+    target->projection_matrix[1][1] = 2.0f / (fov[2] - fov[3]);
+    target->projection_matrix[2][0] = -(fov[1] + fov[0]) / (fov[1] - fov[0]);
+    target->projection_matrix[2][1] = -(fov[2] + fov[3]) / (fov[2] - fov[3]);
+    target->projection_matrix[2][2] = far_z / (far_z - near_z);
+    target->projection_matrix[3][2] = -near_z * far_z / (far_z - near_z);
+    target->projection_matrix[2][3] = 1.0f;
+}
+static const float fovs[2][4] = { { -1.12f, 0.83f, 1.02f, -0.94f }, { -0.79f, 1.17f, 0.96f, -1.03f } };
+static void reset_state(void) {
+    int eye;
+    memset(&vr_render, 0, sizeof(vr_render)); memset(&vr_gl, 0, sizeof(vr_gl));
+    memset(&global_window_parameters, 0, sizeof(global_window_parameters));
+    vr_render.active = 1; vr_gl.eye_alone = -1;
+    draws = corrections_calls = 0;
+    for (eye = 0; eye < 2; eye++) {
+        struct render_camera *camera = &vr_render.eye_cameras[eye];
+        camera->position.x = eye ? 0.03f : -0.03f;
+        camera->viewport_bounds.x1 = 640; camera->viewport_bounds.y1 = 480; camera->marker = (float)(eye + 1);
+        frustum(&vr_render.eyes[eye], camera->position.x, fovs[eye], 0.0625f, 1024.0f);
+    }
+    global_window_parameters.camera = vr_render.eye_cameras[0];
+    global_window_parameters.camera.marker = 9.0f;
+    frustum(&global_window_parameters.frustum, 0.0f, fovs[0], 0.125f, 4096.0f);
+    global_window_parameters.frustum.marker = 9.0f;
+    wall_depth[0] = 1.0f; wall_depth[1] = 0.0f;
+}
+static void check_projection(void) {
+    int eye, lateral, vertical, distance_step, k;
+    const float distances[4] = { 0.2f, 2.0f, 30.0f, 974.0f };
+    reset_state();
+    for (eye = 0; eye < 2; eye++) {
+        struct render_camera camera = global_window_parameters.camera;
+        struct render_frustum selected = global_window_parameters.frustum;
+        float hardware_depth[4];
+        for (k = 0; k < 4; k++) hardware_depth[k] = selected.projection_matrix[k][2];
+        CHECK(vr_render_sun_glow_begin((short)eye, &camera, &selected));
+        for (k = 0; k < 4; k++) CHECK(hardware_depth[k] == selected.projection_matrix[k][2]);
+        global_window_parameters.camera = camera; global_window_parameters.frustum = selected;
+        for (distance_step = 0; distance_step < 4; distance_step++) {
+            float z = distances[distance_step];
+            for (lateral = -8; lateral <= 8; lateral++) {
+                for (vertical = -5; vertical <= 5; vertical++) {
+                    float tangent_x = (float)lateral * 0.11f, tangent_y = (float)vertical * 0.13f;
+                    real_point3d point = { tangent_x*z, tangent_y*z, z }, center;
+                    real_vector2d axes;
+                    const float *fov = fovs[eye];
+                    float x = tangent_x - camera.position.x / z;
+                    float expected_x = ((2.0f*x - fov[1] - fov[0]) / (fov[1] - fov[0]) + 1.0f) * 320.0f - 0.5f;
+                    float expected_y = (1.0f - (2.0f*tangent_y - fov[2] - fov[3]) / (fov[2] - fov[3])) * 240.0f - 0.5f;
+                    float expected_depth = hardware_depth[2] + hardware_depth[3] / z;
+                    CHECK(rasterizer_project_billboard(&point, 0.1f, &center, &axes));
+                    CHECK(near_float(center.x, expected_x)); CHECK(near_float(center.y, expected_y));
+                    CHECK(near_float(center.z, expected_depth));
+                    CHECK(near_float(axes.i, 64.0f / ((fov[1] - fov[0]) * z)));
+                    CHECK(near_float(axes.j, 48.0f / ((fov[2] - fov[3]) * z)));
+                }
+            }
+        }
+        vr_render_sun_glow_end();
+    }
+}
+static void check_dispatch_and_occlusion(void) {
+    struct rasterizer_lens_flare_submit_parameters flare = { { 2.0f, 0.3f, 5.0f } };
+    struct render_camera saved_camera;
+    struct render_frustum saved_frustum;
+    unsigned long serial;
+    reset_state(); saved_camera = global_window_parameters.camera; saved_frustum = global_window_parameters.frustum;
+    rasterizer_sun_glow_draw(&flare);
+    CHECK(draws == 2 && draw_eye[0] == 0 && draw_eye[1] == 1);
+    CHECK(composite_strength[0] == 0.5f && composite_strength[1] == 0.5f);
+    CHECK(visible[0] && !visible[1]); /* independent eye masks; right wall cannot reuse left visibility */
+    CHECK(fabsf(draw_x[0] - draw_x[1]) > 20.0f && fabsf(draw_y[0] - draw_y[1]) > 5.0f);
+    CHECK(near_float(depth[0], depth[1]));
+    CHECK(memcmp(&saved_camera, &global_window_parameters.camera, sizeof(saved_camera)) == 0);
+    CHECK(memcmp(&saved_frustum, &global_window_parameters.frustum, sizeof(saved_frustum)) == 0);
+    CHECK(vr_gl.eye_alone == -1 && !vr_gl.screen_space && !vr_gl.screen_points);
+    CHECK(vr_gl.eye_serial == 2);
+    serial = vr_gl.eye_serial; halo_vr_screen_space(0); CHECK(vr_gl.eye_serial == serial);
+    halo_vr_screen_space(1); CHECK(vr_gl.eye_serial == serial + 1);
+    halo_vr_screen_space(1); CHECK(vr_gl.eye_serial == serial + 1);
+    halo_vr_screen_space(0); CHECK(vr_gl.eye_serial == serial + 2);
+    CHECK(!vr_render_sun_glow_begin(-1, &saved_camera, &saved_frustum));
+    CHECK(!vr_render_sun_glow_begin(2, &saved_camera, &saved_frustum));
+    reset_state(); vr_render.active = 0; saved_camera = global_window_parameters.camera; saved_frustum = global_window_parameters.frustum;
+    rasterizer_sun_glow_draw(&flare);
+    CHECK(draws == 1 && corrections_calls == 0);
+    CHECK(composite_strength[0] == 1.0f);
+    CHECK(!vr_gl.screen_space && vr_gl.eye_alone == -1);
+    CHECK(memcmp(&saved_camera, &global_window_parameters.camera, sizeof(saved_camera)) == 0);
+    CHECK(memcmp(&saved_frustum, &global_window_parameters.frustum, sizeof(saved_frustum)) == 0);
+}
+static void check_glow_strength(void) {
+    const double inputs[] = { -1.0, 0.0, 0.2, 0.5, 1.0, 1.5, NAN, INFINITY, -INFINITY };
+    const float expected[] = { 0.0f, 0.0f, 0.2f, 0.5f, 1.0f, 1.0f, 0.5f, 0.5f, 0.5f };
+    struct rasterizer_lens_flare_submit_parameters flare = { { 2.0f, 0.3f, 5.0f } };
+    unsigned int setting;
+    for (setting = 0; setting < sizeof(inputs) / sizeof(inputs[0]); setting++) {
+        reset_state(); configured_glow = inputs[setting];
+        rasterizer_sun_glow_draw(&flare);
+        CHECK(draws == 2);
+        CHECK(near_float(composite_strength[0], expected[setting]));
+        CHECK(near_float(composite_strength[1], expected[setting]));
+        CHECK(visible[0] && !visible[1]);
+        CHECK(vr_gl.eye_alone == -1 && !vr_gl.screen_space);
+    }
+    configured_glow = 0.5;
+}
+static void check_shader_sampling(void) {
+    struct nv2a_pixel_shader_key key;
+    struct xgpu_text text;
+    int view, source_eye;
+    size_t key_size = sizeof(struct nv2a_pixel_shader_key), old_size = sizeof(struct original_pixel_shader_key);
+    CHECK(key_size == old_size);
+    for (view = XGPU_MULTIVIEW_NONE; view <= XGPU_MULTIVIEW_RIGHT_EYE; view++) {
+        for (source_eye = 0; source_eye < 2; source_eye++) {
+            const char *expected = view == XGPU_MULTIVIEW_EYES ? "float(gl_ViewID_OVR)" :
+                view == XGPU_MULTIVIEW_RIGHT_EYE || (view == XGPU_MULTIVIEW_NONE && source_eye) ? ", 1.0)" : ", 0.0)";
+            memset(&key, 0, sizeof(key)); memset(&text, 0, sizeof(text));
+            key.sampler_type[0] = _xgpu_sampler_2d_layered; key.multiview = (unsigned char)view;
+            key.sample_eye = (unsigned char)source_eye; sample(&text, &key, 0, "point");
+            CHECK(strstr(text.buffer, expected) != NULL);
+        }
+    }
+    memset(&key, 0, sizeof(key)); memset(&text, 0, sizeof(text));
+    key.sampler_type[0] = _xgpu_sampler_2d; key.sample_eye = 1;
+    sample(&text, &key, 0, "point"); CHECK(strstr(text.buffer, "vec3") == NULL);
+}
+int main(void) {
+    check_projection(); check_dispatch_and_occlusion(); check_glow_strength(); check_shader_sampling();
+    printf("PASS: %d production stereo sun-glow assertions\n", checks);
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc')
+    parser.add_argument('--vcvarsall', type=Path)
+    args = parser.parse_args()
+    lights_path = 'source/rasterizer/xbox/rasterizer_xbox_lights.c'
+    lights = (ROOT / lights_path).read_text()
+    render = (ROOT / 'port/linux/game/vr_render.c').read_text()
+    gl = (ROOT / 'port/linux/src/d3d8_gl.c').read_text()
+    psh = (ROOT / 'port/linux/src/nv2a_psh.c').read_text()
+    xgpu = (ROOT / 'port/linux/src/xgpu.h').read_text()
+    old_lights = subprocess.check_output(['git', 'show', 'HEAD:' + lights_path], cwd=ROOT, text=True)
+    old_xgpu = subprocess.check_output(['git', 'show', 'HEAD:port/linux/src/xgpu.h'], cwd=ROOT, text=True)
+    old_draw = function(old_lights, 'rasterizer_sun_glow_draw')
+    new_draw = function(lights, 'rasterizer_sun_glow_draw_internal')
+    # The sole change inside the legacy routine is the final composite alpha.
+    original_alpha = 'brightness / (real)(pass + 1)) >= 0 && success)'
+    scaled_alpha = 'brightness * glow_strength / (real)(pass + 1)) >= 0 && success)'
+    assert new_draw.count(scaled_alpha) == 1 and old_draw.count(original_alpha) == 1
+    assert new_draw[new_draw.index('{'):].replace(scaled_alpha, original_alpha) == old_draw[old_draw.index('{'):], 'Legacy mask/blur/depth path changed'
+    assert function(lights, 'rasterizer_project_billboard') == function(old_lights, 'rasterizer_project_billboard')
+    assert 'D3DRS_ZFUNC,\n\t\t\t\tD3DCMP_LESSEQUAL' in new_draw and 'D3DRS_ZENABLE,\n\t\t\t\tTRUE' in new_draw
+    binding = re.search(r'key\.sample_eye = vr_gl\.eye_alone == 1 \? 1 : 0;', gl)
+    assert binding and binding.start() < gl.index('entry = program_get(vertex_shader_get(program, immediate, key.multiview)')
+    assert 'vr_gl.screen_points || vr_gl.screen_space ? 1.0f : 0.0f' in gl
+    assert 'halo_vr_screen_space(0);' in function(render, 'vr_render_end')
+    assert 'vr_render.eye_cameras[eye] = eye_camera;' in render
+    key = re.search(r'struct nv2a_pixel_shader_key\s*\{.*?\};', xgpu, re.S).group()
+    old_key = re.search(r'struct nv2a_pixel_shader_key\s*\{.*?\};', old_xgpu, re.S).group()
+    functions = '\n\n'.join([function(gl, 'halo_vr_screen_space'), function(gl, 'halo_vr_draw_eye'),
+                              function(render, 'vr_render_screen_point_end'), function(render, 'vr_render_sun_glow_begin'),
+                              function(render, 'vr_render_sun_glow_end'), function(lights, 'rasterizer_project_billboard')])
+    harness = HARNESS.replace('@@FUNCTIONS@@', functions).replace('@@WRAPPER@@', function(lights, 'rasterizer_sun_glow_draw'))
+    harness = harness.replace('@@STRENGTH@@', function(lights, 'rasterizer_vr_sun_glow_strength'))
+    harness = harness.replace('@@KEY@@', key).replace('@@OLD_KEY@@', old_key.replace('nv2a_pixel_shader_key', 'original_pixel_shader_key'))
+    harness = harness.replace('@@SAMPLE@@', function(psh, 'sample')).replace('@@SAMPLE_BINDING@@', binding.group())
+    compiler = args.cc or os.environ.get('CC')
+    vcvars = args.vcvarsall
+    if not compiler and os.name == 'nt':
+        installations = Path(os.environ.get('ProgramFiles', 'C:/Program Files')) / 'Microsoft Visual Studio'
+        candidates = sorted(installations.glob('*/**/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe'))
+        if candidates:
+            compiler = str(candidates[-1]); vcvars = vcvars or candidates[-1].parents[6] / 'Auxiliary/Build/vcvarsall.bat'
+    compiler = compiler or shutil.which('cc') or shutil.which('clang') or shutil.which('gcc')
+    if not compiler:
+        raise SystemExit('No C11 host compiler found; select one with --cc.')
+    with tempfile.TemporaryDirectory(prefix='halo-vr-sun-check-', ignore_cleanup_errors=True) as directory:
+        temp = Path(directory); source = temp / 'test.c'; executable = temp / ('test.exe' if os.name == 'nt' else 'test')
+        source.write_text(harness)
+        if Path(compiler).name.lower() in ('cl', 'cl.exe'):
+            command = [compiler, '/nologo', '/std:c11', '/W4', '/WX', '/DHALO_VR', '/D_CRT_SECURE_NO_WARNINGS',
+                       '/Fe:' + str(executable), '/Fo:' + str(temp / 'test.obj'), str(source)]
+            if vcvars:
+                for path in (vcvars, Path(compiler), temp):
+                    if any(character in str(path) for character in '\r\n"&|<>^%!'):
+                        raise SystemExit('Unsupported shell metacharacter in compiler/temp path.')
+                batch = temp / 'compile.cmd'
+                batch.write_text('@echo off\ncall "' + str(vcvars) + '" x64 >nul\nif errorlevel 1 exit /b 1\n' +
+                                 subprocess.list2cmdline(command) + '\n')
+                command = ['cmd.exe', '/d', '/c', str(batch)]
+        else:
+            command = [compiler, '-std=c11', '-Wall', '-Wextra', '-Werror', '-DHALO_VR', str(source), '-lm', '-o', str(executable)]
+        subprocess.run(command, cwd=temp, check=True)
+        subprocess.run([str(executable)], cwd=temp, check=True)
+    print('PASS: original glow/depth pipeline preserved; stereo source and screen-space binding contracts')
+
+
+if __name__ == '__main__':
+    main()
