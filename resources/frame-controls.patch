+#ifdef HALO_VR
+boolean weapon_preview_projectile_ray(
+	long weapon_index,
+	short trigger_index,
+	long player_index,
+	real_point3d *origin,
+	real_vector3d *forward,
+	long *owner_object_index,
+	struct projectile_preview_pose const *pose)
+{
+	struct weapon_datum *weapon;
+	struct weapon_definition *definition;
+	struct weapon_trigger_definition *trigger;
+	struct unit_datum *unit;
+	struct object_marker marker;
+	struct projectile_preview_pose validated_pose;
+	long owner, firing_player;
+	real velocity = 0.0f, error = 0.0f, length;
+
+	if (weapon_index == NONE || player_index == NONE)
+		return FALSE;
+	weapon = weapon_try_and_get(weapon_index);
+	if (!weapon)
+		return FALSE;
+	definition = weapon_definition_get(weapon->definition_index);
+	if (trigger_index < 0 || trigger_index >= MAXIMUM_NUMBER_OF_TRIGGERS_PER_WEAPON ||
+		trigger_index >= definition->weapon.triggers.count)
+		return FALSE;
+	owner = weapon_get_owner_object_index(weapon_index);
+	unit = unit_try_and_get(owner);
+	if (!unit || TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+		return FALSE;
+	firing_player = unit->unit.player_index;
+	if (unit->unit.gunner_object_index != NONE)
+	{
+		struct unit_datum *gunner = unit_try_and_get(unit->unit.gunner_object_index);
+		if (!gunner)
+			return FALSE;
+		firing_player = gunner->unit.player_index;
+	}
+	if (firing_player != player_index)
+		return FALSE;
+	trigger = TAG_BLOCK_GET_ELEMENT(&definition->weapon.triggers, trigger_index, struct weapon_trigger_definition);
+	if (pose)
+	{
+		struct unit_definition *unit_definition = unit_definition_get(unit->definition_index);
+		/* Limited turrets, vehicle seats and unaimed projectiles keep the
+		authoritative path; a render pose cannot bypass their firing rules. */
+		if (unit->object.type != _object_type_biped || unit->object.parent_object_index != NONE ||
+			unit->unit.gunner_object_index != NONE ||
+			!TEST_FLAG(unit_definition->unit.flags, _unit_fires_from_camera_bit) ||
+			unit_definition->unit.aiming_velocity_maximum != 0.0f ||
+			unit_definition->unit.aiming_acceleration_maximum != 0.0f ||
+			TEST_FLAG(trigger->flags, _weapon_trigger_projectiles_cannot_be_aimed_bit))
+			pose = NULL;
+	}
+	if (pose)
+	{
+		length = magnitude3d(&pose->forward);
+		if (!isfinite(pose->camera_position.x) || !isfinite(pose->camera_position.y) ||
+			!isfinite(pose->camera_position.z) || !isfinite(length) || length <= 0.0f)
+			return FALSE;
+		validated_pose = *pose;
+		normalize3d(&validated_pose.forward);
+		pose = &validated_pose;
+	}
+
+	/* object_get_marker_by_name supplies node zero when the named marker
+	is missing, the same fallback used by trigger_create_projectiles. */
+	object_get_marker_by_name(weapon_get_effect_object_index(weapon_index),
+		trigger_index == 0 ? "primary trigger" : "secondary trigger", &marker, 1);
+	*origin = marker.matrix.position;
+	*forward = marker.matrix.forward;
+	trigger_adjust_projectile_ray(owner, unit, trigger, origin, forward, &velocity, &error, TRUE, pose);
+	if (TEST_FLAG(trigger->flags, _weapon_trigger_uses_weapon_origin_bit))
+		*origin = marker.matrix.position;
+	length = magnitude3d(forward);
+	if (!isfinite(origin->x) || !isfinite(origin->y) || !isfinite(origin->z) ||
+		!isfinite(forward->i) || !isfinite(forward->j) || !isfinite(forward->k) ||
+		!isfinite(length) || length <= 0.0f || normalize3d(forward) <= 0.0f)
+		return FALSE;
+	*owner_object_index = object_get_ultimate_parent(weapon_get_projectile_owner_object_index(weapon_index));
+	return TRUE;
+}
+#endif
