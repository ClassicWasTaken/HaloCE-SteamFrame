+}
+'''
+
+
+def main():
+    render = (ROOT / 'port/linux/game/vr_render.c').read_text()
+    lights = (ROOT / 'source/objects/object_lights.c').read_text()
+    first_person = (ROOT / 'source/interface/first_person_weapons.c').read_text()
+    old_first_person = subprocess.check_output(['git', 'show', reticle.ORIGINAL_ENGINE_COMMIT +
