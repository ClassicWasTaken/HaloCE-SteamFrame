+	bounds.x0 = (short)MAX(0, x - 3);
+	bounds.y0 = (short)MAX(0, y - 3);
+	bounds.x1 = (short)MIN(640, x + 4);
+	bounds.y1 = (short)MIN(480, y + 4);
+	draw_quad(&bounds, 0xff000000);
+	bounds.x0 = (short)MAX(0, x - 1);
+	bounds.y0 = (short)MAX(0, y - 1);
+	bounds.x1 = (short)MIN(640, x + 2);
+	bounds.y1 = (short)MIN(480, y + 2);
+	draw_quad(&bounds, 0xffffffff);
+}
