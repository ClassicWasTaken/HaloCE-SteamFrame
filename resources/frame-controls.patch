+/* Neither persistent nor unsynchronized mutable uploads may reuse storage
+after a timeout or lost context. The native renderer can orphan mutable
+storage instead of blocking the render thread; retain an unfinished fence. */
+int host_gl_wait_frame_checked(uint32_t slot)
+{
+	GLenum status;
+
+	if (slot >= FRAME_FENCE_SLOTS || frame_fence_failed[slot])
+		return 0;
+	if (!frame_fences[slot])
+		return 1;
+	status = glClientWaitSync(frame_fences[slot], GL_SYNC_FLUSH_COMMANDS_BIT, 1000000ull);
+	if (status != GL_ALREADY_SIGNALED && status != GL_CONDITION_SATISFIED)
+		return 0;
+	glDeleteSync(frame_fences[slot]);
+	frame_fences[slot] = NULL;
+	return 1;
+}
+
+/* Native desktop GL only. The ordinary GLES path retains its current uploads.
+Six ring buffers fit here; records abandoned after a failed fence remain alive
+until context teardown and are never reused, bounding that retirement to six.
+Every allocation is transactional: no failed immutable object reaches the
+renderer, and no GL object name can be confused with a guest memory address. */
+#define PERSISTENT_BUFFER_SLOTS 16
+static struct
+{
+	GLuint buffer;
+	uint32_t size;
+	unsigned char *mapping;
+} persistent_buffers[PERSISTENT_BUFFER_SLOTS];
+
+uint32_t host_gl_buffer_create_persistent(uint32_t size)
+{
+#ifdef HALO_DESKTOP_GL
+	void (*buffer_storage)(GLenum, GLsizeiptr, const void *, GLbitfield);
+	const GLbitfield flags = GL_MAP_WRITE_BIT | 0x0040 /* PERSISTENT */ | 0x0080 /* COHERENT */;
+	GLint major = 0, minor = 0, previous = 0;
+	GLuint buffer = 0;
+	unsigned char *mapping;
+	int slot;
+
+	if (!size)
+		return 0;
+	glGetIntegerv(GL_MAJOR_VERSION, &major);
+	glGetIntegerv(GL_MINOR_VERSION, &minor);
+	if (!(major > 4 || (major == 4 && minor >= 4) || host_gl_has_extension("GL_ARB_buffer_storage")))
+		return 0;
+	buffer_storage = (void (*)(GLenum, GLsizeiptr, const void *, GLbitfield))host_gl_resolve("glBufferStorage");
+	if (!buffer_storage)
+		return 0;
+	for (slot = 0; slot < PERSISTENT_BUFFER_SLOTS && persistent_buffers[slot].buffer; slot++)
+		;
+	if (slot == PERSISTENT_BUFFER_SLOTS)
+		return 0;
+	glGetIntegerv(GL_COPY_WRITE_BUFFER_BINDING, &previous);
+	glGenBuffers(1, &buffer);
+	if (!buffer)
+		return 0;
+	glBindBuffer(GL_COPY_WRITE_BUFFER, buffer);
+	/* DYNAMIC_STORAGE allows a safe glBufferSubData fallback if a later
+	write cannot find its host record. It never permits glBufferData. */
+	buffer_storage(GL_COPY_WRITE_BUFFER, size, NULL, flags | 0x0100 /* DYNAMIC_STORAGE */);
+	mapping = glMapBufferRange(GL_COPY_WRITE_BUFFER, 0, size, flags);
+	if (!mapping)
+	{
+		/* Storage may already be immutable even when mapping fails. */
+		glDeleteBuffers(1, &buffer);
+		glBindBuffer(GL_COPY_WRITE_BUFFER, (GLuint)previous);
+		return 0;
+	}
+	persistent_buffers[slot].buffer = buffer;
+	persistent_buffers[slot].size = size;
+	persistent_buffers[slot].mapping = mapping;
+	glBindBuffer(GL_COPY_WRITE_BUFFER, (GLuint)previous);
+	return buffer;
+#else
+	(void)size;
+	return 0;
+#endif
+}
+
+/* Used only to roll back initialization, before any draw references the buffer.
+After an uncertain fence, the renderer instead retains the mapped object. */
+void host_gl_buffer_destroy_persistent(uint32_t buffer)
+{
+	int slot;
+
+	for (slot = 0; slot < PERSISTENT_BUFFER_SLOTS; slot++)
+	{
+		if (persistent_buffers[slot].buffer == buffer && buffer)
+		{
+			glDeleteBuffers(1, &persistent_buffers[slot].buffer);
+			memset(&persistent_buffers[slot], 0, sizeof(persistent_buffers[slot]));
+			return;
+		}
+	}
+}
+
+int host_gl_buffer_write_persistent(uint32_t buffer, uint32_t offset, uint32_t size, const void *data)
+{
+	int slot;
+
+	for (slot = 0; slot < PERSISTENT_BUFFER_SLOTS; slot++)
+	{
+		if (persistent_buffers[slot].buffer == buffer && buffer)
+		{
+			if (offset > persistent_buffers[slot].size || size > persistent_buffers[slot].size - offset ||
+				(size && !data))
+				return 0;
+			if (size)
+				memcpy(persistent_buffers[slot].mapping + offset, data, size);
+			return 1;
+		}
+	}
+	return 0;
+}
