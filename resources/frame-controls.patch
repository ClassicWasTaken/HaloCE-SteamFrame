+#!/usr/bin/env python3
+"""Compile and run the production VR walking math and integration on a host.
+
+No headset, game data, SDL or OpenXR is required. Uses cc/clang/gcc on POSIX
+or Visual Studio's C11 compiler on Windows; --cc and --vcvarsall can override.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import textwrap
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def masked(text):
+    return re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                  lambda match: re.sub(r'[^\n]', ' ', match.group()), text, flags=re.S)
+
+
+def function(text, name):
+    match = re.search(r'(?:static\s+)?(?:void|float|int)\s+' + re.escape(name) +
+                      r'\s*\([^;]*?\)\s*\{', text)
+    if not match:
+        raise AssertionError(f"Missing production function: {name}")
+    code = masked(text)
+    depth = 1
+    end = code.index('{', match.start()) + 1
+    while depth:
+        depth += (code[end] == '{') - (code[end] == '}')
+        end += 1
+    return text[match.start():end]
+
+
+def source_checks(vr, player):
+    baseline = subprocess.check_output(['git', 'show', '2ae0ee4e3e8a4dfdadfd528a5b085ca699fc9ea4:port/linux/src/vr.c'],
+                                       cwd=ROOT, text=True)
+    assert function(vr, 'halo_vr_aim') == function(baseline, 'halo_vr_aim'), 'Weapon aim changed'
+    assert function(vr, 'weapon_pointing') == function(baseline, 'weapon_pointing'), 'Long-gun aim changed'
+    old_pad = masked(function(baseline, 'halo_vr_gamepad'))
+    new_pad = masked(function(vr, 'halo_vr_gamepad'))
+    old_pad = old_pad.replace('XINPUT_GAMEPAD_WHITE, buttons & VR_BUTTON_LEFT_BUMPER',
+                             'XINPUT_GAMEPAD_WHITE, buttons & VR_BUTTON_RIGHT_BUMPER')
+    old_pad = old_pad.replace('XINPUT_GAMEPAD_BLACK, buttons & VR_BUTTON_RIGHT_BUMPER',
+                             'XINPUT_GAMEPAD_BLACK, buttons & VR_BUTTON_LEFT_BUMPER')
+    assert re.sub(r'\s+', '', old_pad) == re.sub(r'\s+', '', new_pad), 'Xbox controls changed beyond bumper fix'
+    config = (ROOT / 'port/linux/src/port_config.c').read_text()
+    assert re.search(r'"vr\.movement",\s*_config_string,\s*"\\"head\\"",\s*"HALO_VR_MOVEMENT"', config)
+    hook_start = player.index('if (local_player_index == 0 && unit->object.parent_object_index == NONE &&')
+    hook_open = player.index('{', hook_start)
+    hook_end = player.index('}', hook_open) + 1
+    hook = player[hook_start:hook_end]
+    assert '!director_inhibited_facing(local_player_index)' in hook and '!cinematic_in_progress()' in hook
+    assert 'halo_vr_locomotion(player->desired_angles.yaw, &input.throttle.i, &input.throttle.j)' in hook
+    assert player.index('player->desired_angles.yaw = vr_yaw;') < hook_start
+    assert hook_end < player.index('player->throttle = input.throttle;') < player.index('update_client_queue(&action);')
+    guard = re.search(r'if \(vr_aim == 1 && \(!isfinite\(vr_yaw\) \|\| !isfinite\(vr_pitch\)\)\)\s*vr_aim = 0;', player)
+    assert guard and guard.start() < player.index('while (vr_yaw < 0.f)')
+    # Include the production statement's leading indent before dedenting.
+    # The extracted if body must retain its relative indent in generated C.
+    guard_line_start = player.rfind('\n', 0, guard.start()) + 1
+    guard_source = player[guard_line_start:guard.end()].expandtabs(4)
+    return hook, textwrap.indent(textwrap.dedent(guard_source), '    ')
+
+
+HARNESS = r'''
+#define _USE_MATH_DEFINES
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "vr_host.h"
+#include "vr_locomotion.h"
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#define NONE (-1)
+#define FLAG(bit) (1UL << (bit))
+#define TEST_FLAG(value, bit) (((value) & FLAG(bit)) != 0)
+#define EPSILON 0.00005f
+static int checks;
+#define CHECK(condition) do { checks++; if (!(condition)) { \
+    fprintf(stderr, "failed line %d: %s\n", __LINE__, #condition); exit(1); } } while (0)
+static int close_float(float first, float second) { return fabsf(first - second) <= EPSILON; }
+static struct {
+    int initialized, frame, pending, origin_valid, aim_synced, menus, aiming, long_gun;
+    struct vr_host_views views;
+    float origin_yaw, body_yaw, origin_position[3];
+    struct halo_vr_locomotion_heading movement_heading;
+    int tutorial_head_valid, tutorial_turn_flags, turn_control_allowed;
+    float tutorial_head_yaw, tutorial_head_pitch;
+} vr;
+static struct {
+    int head_movement, controller_aim, gamepad_aim, gamepad_snap, standing;
+    float snap_angle, player_height;
+} settings;
+static void settings_read(void) {}
+static void platform_log(const char *format, const char *height) { (void)format; (void)height; }
+static int weapon_calls;
+/* The production aiming function is unchanged; the host stub supplies the
+controller pose that the unmodified long-gun/weapon_pointing code computes. */
+static void weapon_pointing(float point[3], float up[3]);
+@@FUNCTIONS@@
+static void weapon_pointing(float point[3], float up[3]) {
+    static const float forward[3] = { 0.0f, 0.0f, -1.0f };
+    static const float upwards[3] = { 0.0f, 1.0f, 0.0f };
+    weapon_calls++;
+    quaternion_rotate(vr.views.aim[1].orientation, forward, point);
+    quaternion_rotate(vr.views.aim[1].orientation, upwards, up);
+}
+typedef struct { float yaw, pitch; } real_euler_angles2d;
+typedef struct { float i, j; } real_vector2d;
+typedef float real;
+enum {
+    _unit_control_action_bit, _unit_control_jump_bit, _unit_control_throw_grenade_bit,
+    _player_control_action_bit, _player_control_jump_bit, _player_control_grenade_trigger_bit,
+    _player_control_primary_trigger_bit, _player_control_look_relative_up_bit,
+    _player_control_look_relative_down_bit, _player_control_look_relative_left_bit,
+    _player_control_look_relative_right_bit, _player_control_move_relative_forward_bit,
+    _player_control_move_relative_backward_bit, _player_control_move_relative_right_bit,
+    _player_control_move_relative_left_bit
+};
+struct player_control_globals_data { unsigned long action_flags; } tutorial;
+static struct player_control_globals_data *player_control_globals = &tutorial;
+@@TUTORIAL@@
+static int local_player_index, inhibited, cinematic, dispatch_calls;
+static struct { struct { long parent_object_index; } object; } unit_storage, *unit = &unit_storage;
+static struct { real_euler_angles2d desired_angles; } player_storage, *player = &player_storage;
+static struct { real_vector2d throttle; } input;
+static int director_inhibited_facing(int index) { (void)index; return inhibited; }
+static int cinematic_in_progress(void) { return cinematic; }
+static void record_locomotion(float yaw, float *forward, float *left) {
+    dispatch_calls++;
+    halo_vr_locomotion(yaw, forward, left);
+}
+#define halo_vr_locomotion record_locomotion
+static void dispatch(void) { @@HOOK@@ }
+#undef halo_vr_locomotion
+static int guard_aim(float vr_yaw, float vr_pitch, int vr_aim) {
+@@AIM_GUARD@@
+    return vr_aim;
+}
+
+static void head_pose(float yaw, float pitch) {
+    float cy = cosf(yaw * 0.5f), sy = sinf(yaw * 0.5f);
+    float cp = cosf(pitch * 0.5f), sp = sinf(pitch * 0.5f);
+    vr.views.head.orientation[0] = cy * sp;
+    vr.views.head.orientation[1] = sy * cp;
+    vr.views.head.orientation[2] = -sy * sp;
+    vr.views.head.orientation[3] = cy * cp;
+}
+static void reset_state(void) {
+    memset(&vr, 0, sizeof(vr)); memset(&settings, 0, sizeof(settings));
+    vr.initialized = vr.frame = vr.origin_valid = vr.aim_synced = 1;
+    vr.views.should_render = vr.views.focused = vr.views.head.valid = 1;
+    vr.turn_control_allowed = 1;
+    vr.views.eye[0].valid = vr.views.eye[1].valid = 1;
+    vr.views.eye[0].orientation[3] = vr.views.eye[1].orientation[3] = 1.0f;
+    settings.head_movement = settings.controller_aim = 1;
+    settings.player_height = 1.7f;
+    head_pose(0.0f, 0.0f);
+    tutorial.action_flags = 0;
+}
+static void expect_walk(float aim, float forward, float left, float expected_forward, float expected_left) {
+    halo_vr_locomotion(aim, &forward, &left);
+    CHECK(close_float(forward, expected_forward)); CHECK(close_float(left, expected_left));
+}
+static void check_directions(void) {
+    const float half_pi = (float)M_PI * 0.5f;
+    float angle, aim, forward, left, expected_x, expected_y, actual_x, actual_y;
+    int head_step, aim_step;
+    reset_state(); head_pose(half_pi, 0.0f);
+    expect_walk(0.0f, 1.0f, 0.0f, 0.0f, 1.0f);
+    expect_walk(0.0f, 0.0f, 1.0f, -1.0f, 0.0f);
+    reset_state(); expect_walk(half_pi, 1.0f, 0.0f, 0.0f, -1.0f);
+    /* Compare actual world-space motion, not a second copy of rotation:
+    engine throttle uses weapon facing. Independently form head forward
+    and head left vectors and compare those with engine-applied throttle. */
+    for (head_step = -24; head_step <= 24; head_step++) {
+        angle = (float)head_step * 0.19f;
+        for (aim_step = -24; aim_step <= 24; aim_step++) {
+            aim = (float)aim_step * 0.27f;
+            reset_state(); vr.body_yaw = 0.43f; vr.origin_yaw = -0.31f;
+            head_pose(angle, 0.75f);
+            forward = 0.6f; left = 0.8f;
+            halo_vr_locomotion(aim, &forward, &left);
+            expected_x = 0.6f * cosf(angle + 0.74f) - 0.8f * sinf(angle + 0.74f);
+            expected_y = 0.6f * sinf(angle + 0.74f) + 0.8f * cosf(angle + 0.74f);
+            actual_x = forward * cosf(aim) - left * sinf(aim);
+            actual_y = forward * sinf(aim) + left * cosf(aim);
+            CHECK(close_float(actual_x, expected_x)); CHECK(close_float(actual_y, expected_y));
+            CHECK(close_float(forward * forward + left * left, 1.0f));
+        }
+    }
+    reset_state(); head_pose(0.7f, 0.0f);
+    expect_walk(12.0f * (float)M_PI + 0.7f, -0.6f, 0.4f, -0.6f, 0.4f);
+    vr.body_yaw = half_pi; head_pose(0.0f, 0.0f);
+    expect_walk(0.0f, 1.0f, 0.0f, 0.0f, 1.0f); /* snap turn */
+    vr.body_yaw = 0.25f;
+    expect_walk(0.0f, 1.0f, 0.0f, cosf(0.25f), sinf(0.25f)); /* smooth turn */
+}
+static void check_pitch_and_recentering(void) {
+    float before_forward = 1.0f, before_left = 0.0f;
+    reset_state(); head_pose(0.9f, 0.0f);
+    halo_vr_locomotion(0.2f, &before_forward, &before_left);
+    head_pose(-2.0f, (float)M_PI * 0.5f);
+    expect_walk(0.2f, 1.0f, 0.0f, before_forward, before_left);
+    /* Body turns still move the cached vertical heading; weapon turns do
+    not redirect walking. Recenter adjusts body/origin by opposite amounts. */
+    vr.body_yaw += 0.3f;
+    expect_walk(0.5f, 1.0f, 0.0f, before_forward, before_left);
+    reset_state(); head_pose(2.0f, -(float)M_PI * 0.5f);
+    expect_walk(0.0f, 1.0f, 0.0f, 0.0f, 0.0f);
+    CHECK(!vr.movement_heading.valid);
+    reset_state(); vr.origin_yaw = -0.4f; vr.body_yaw = 0.2f; head_pose(0.7f, 0.0f);
+    before_forward = 1.0f; before_left = 0.0f;
+    halo_vr_locomotion(0.1f, &before_forward, &before_left);
+    recentre(); CHECK(!vr.movement_heading.valid);
+    expect_walk(0.1f, 1.0f, 0.0f, before_forward, before_left);
+    halo_vr_aim_release(); CHECK(!vr.movement_heading.valid);
+}
+static void check_tracking_guards(void) {
+    float forward, left, normalized[4], pose[4] = { 0.0f, 0.0f, 0.0f, 1.01f };
+    int flag;
+    for (flag = 0; flag < 8; flag++) {
+        reset_state(); head_pose(0.9f, 0.0f);
+        forward = 1.0f; left = 0.0f; halo_vr_locomotion(0.0f, &forward, &left);
+        CHECK(vr.movement_heading.valid);
+        switch (flag) {
+            case 0: vr.views.head.valid = 0; break;
+            case 1: vr.views.focused = 0; break;
+            case 2: vr.views.should_render = 0; break;
+            case 3: vr.frame = vr.pending = 0; break;
+            case 4: vr.origin_valid = 0; break;
+            case 5: vr.aim_synced = 0; break;
+            case 6: vr.menus = 1; break;
+            case 7: vr.origin_yaw = NAN; break;
+        }
+        expect_walk(0.0f, 1.0f, 0.4f, 0.0f, 0.0f); CHECK(!vr.movement_heading.valid);
+        vr.views.head.valid = vr.views.focused = vr.views.should_render = vr.frame = 1;
+        vr.origin_valid = vr.aim_synced = 1; vr.menus = 0; vr.origin_yaw = 0.0f;
+        head_pose(-1.0f, (float)M_PI * 0.5f);
+        expect_walk(0.0f, 1.0f, 0.0f, 0.0f, 0.0f); /* no stale yaw after lost tracking */
+    }
+    reset_state(); vr.frame = 0; vr.pending = 1;
+    expect_walk(0.0f, 0.6f, 0.8f, 0.6f, 0.8f);
+    reset_state(); vr.views.head.orientation[1] = NAN;
+    expect_walk(0.0f, 1.0f, 0.2f, 0.0f, 0.0f);
+    reset_state(); vr.views.head.orientation[3] = INFINITY;
+    expect_walk(0.0f, 1.0f, 0.2f, 0.0f, 0.0f);
+    reset_state(); memset(vr.views.head.orientation, 0, sizeof(vr.views.head.orientation));
+    expect_walk(0.0f, 1.0f, 0.2f, 0.0f, 0.0f);
+    reset_state(); expect_walk(NAN, 1.0f, 0.2f, 0.0f, 0.0f);
+    reset_state(); vr.body_yaw = INFINITY; expect_walk(0.0f, 1.0f, 0.2f, 0.0f, 0.0f);
+    reset_state(); expect_walk(0.0f, NAN, 0.2f, 0.0f, 0.0f);
+    reset_state(); expect_walk(0.0f, 0.2f, INFINITY, 0.0f, 0.0f);
+    CHECK(halo_vr_locomotion_orientation(pose, normalized));
+    CHECK(close_float(normalized[3], 1.0f));
+    pose[3] = 10.0f; CHECK(!halo_vr_locomotion_orientation(pose, normalized));
+    pose[3] = 0.0f; CHECK(!halo_vr_locomotion_orientation(pose, normalized));
+}
+static void check_exclusions_and_aim(void) {
+    float aim, pitch, saved_aim, saved_pitch, forward, left;
+    int exclusion;
+    CHECK(guard_aim(0.3f, -0.4f, 1) == 1);
+    CHECK(guard_aim(INFINITY, 0.0f, 1) == 0);
+    CHECK(guard_aim(-INFINITY, 0.0f, 1) == 0);
+    CHECK(guard_aim(NAN, 0.0f, 1) == 0);
+    CHECK(guard_aim(0.0f, NAN, 1) == 0);
+    CHECK(guard_aim(0.0f, INFINITY, 1) == 0);
