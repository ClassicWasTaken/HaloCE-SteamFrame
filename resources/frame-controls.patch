+#!/usr/bin/env python3
+"""Execute production driving query, input hooks and ordinary action queue seam.
+
+Compiles the actual C helpers/hooks with deterministic game/platform services.
+Checks ownership/seat/script guards, simulation hull orientation, registration
+before sampling, refresh after unit changes, handled-only lateral consumption,
+    tracking-loss neutral actions and unchanged non-driver/gamepad actions. This
+does not execute retail vehicle physics or validate headset presentation.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+from test_vr_projectile_reticle import function, block_end
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def integration(player):
+    dispatch = function(player, 'handle_one_player_input')
+    early_start = dispatch.index('if (local_player_index == 0)')
+    early = dispatch[early_start:block_end(dispatch, dispatch.index('{', early_start))]
+    sample = re.search(r'get_local_player_input_blob\(\s*local_player_index,\s*time_delta_sec,\s*&input\);', dispatch)
+    assert sample and early_start < sample.start()
+    start = dispatch.index('extern int halo_vr_aim(')
+    start = dispatch.rfind('{', 0, start)
+    aim = dispatch[start:block_end(dispatch, start)]
+    refresh_start = dispatch.index('if (local_player_index == 0)', sample.end())
+    refresh = dispatch[refresh_start:dispatch.index(';',refresh_start)+1]
+    assert 'player_control_vr_vehicle_controls(' in refresh
+    assert refresh_start < start
+    assert 'halo_vr_vehicle_controls_ready()' in aim
+    assert 'steering > 0 && isfinite(steering_yaw) && isfinite(steering_pitch)' in aim
+    assert 'if (steering == 2)' in aim
+    tail = dispatch[dispatch.index('player->control_flags = input.unit_control_flags;'):dispatch.rindex('\n\treturn;')]
+    assert tail.count('update_client_queue(&action);') == 1
+    assert dispatch.index('halo_vr_vehicle_steering(') < dispatch.index('player->throttle = input.throttle;')
+    return early, sample.group(), refresh, aim, tail
+
+
+HARNESS = r'''
+#include <math.h>
