+#!/usr/bin/env python3
+"""Run production menu placement and OpenXR quad submission on a C11 host.
+
+No game data, headset, runtime or SDL is required. The checked-in guest/host
+ABI and Khronos headers are used; only runtime calls and unrelated logging
+are stubbed. Menu input remains covered by the existing walking/tutorial tests.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+from test_vr_locomotion import function
+
+ROOT = Path(__file__).resolve().parents[1]
+
+HARNESS = r'''
+#define _USE_MATH_DEFINES
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <openxr/openxr.h>
+#include "vr_host.h"
+#include "vr_locomotion.h"
+#include "vr_vehicle.h"
+#include "vr_driving.h"
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#define HUD_WIDTH 1280
+#define HUD_HEIGHT 960
+static unsigned checks;
+#define CHECK(c) do { checks++; if (!(c)) { fprintf(stderr,"failed line %d: %s\n",__LINE__,#c); exit(1); } } while(0)
+static int close_float(float a, float b) { return fabsf(a-b) < 0.00005f; }
+static struct {
+    int initialized, frame, pending, attempted, origin_valid, aim_synced, aiming, aimed;
+    int menus, menu_open, depth_written, render_pose_valid;
+    struct vr_host_pose render_eye[2];
+    float render_fov[2][4];
+    unsigned long presents;
+    int acquired[VR_SWAPCHAIN_COUNT];
+    struct halo_vr_vehicle_reference vehicle;
+    float origin_yaw, body_yaw, origin_position[3], depth_near, depth_far;
+    struct vr_host_views views;
+    struct vr_host_layers pending_layers;
+    struct vr_host_pose menu_pose;
+    struct halo_vr_locomotion_heading movement_heading;
+    int tutorial_turn_flags, tutorial_head_valid;
+} vr;
+static struct {
+    int active, armed, down, blocked, position_valid;
+    short x, y;
+} menu_pointer;
+static struct {
+    int gamepad_aim, standing, vehicle_first_person, vehicle_seat_calibration;
+    float player_height, menu_distance, menu_width, hud_distance, hud_size;
+} settings;
+static void platform_log(const char *format, const char *mode) { (void)format; (void)mode; }
+static void driving_reset(int release_required) { (void)release_required; }
+static struct halo_vr_driving_state driving;
+@@GUEST@@
+
+/* Keep the host's production global separate from the guest's production
+global; this is its only identifier substitution in the extracted functions. */
+static struct {
+    int frame_begun;
+    int has_depth;
+    XrFrameState frame;
+    XrSession session;
+    XrSpace play_space, view_space;
+    XrSwapchain swapchains[VR_SWAPCHAIN_COUNT];
+    int swapchain_width[VR_SWAPCHAIN_COUNT], swapchain_height[VR_SWAPCHAIN_COUNT];
+} runtime;
+static struct { int enabled; double release, end; } timing;
+static XrCompositionLayerQuad submitted_quad;
+static unsigned submitted_quads, submitted_projections, release_calls;
+static double seconds_now(void) { return 0.0; }
+static void timing_frame(void) { CHECK(timing.enabled > 0); }
+static void check(XrResult result, const char *message) { CHECK(result == XR_SUCCESS && message != NULL); }
+void host_vr_release(int swapchain) { CHECK(swapchain >= 0 && swapchain < VR_SWAPCHAIN_RESERVED); release_calls++; }
+XRAPI_ATTR XrResult XRAPI_CALL xrEndFrame(XrSession session, const XrFrameEndInfo *end) {
+    uint32_t index;
+    CHECK(session == runtime.session && end->type == XR_TYPE_FRAME_END_INFO && end->next == NULL);
+    CHECK(end->displayTime == runtime.frame.predictedDisplayTime);
+    CHECK(end->environmentBlendMode == XR_ENVIRONMENT_BLEND_MODE_OPAQUE && end->layerCount <= 2);
+    submitted_quads = submitted_projections = 0;
+    for (index = 0; index < end->layerCount; index++) {
+        const XrCompositionLayerBaseHeader *layer = end->layers[index];
+        if (layer->type == XR_TYPE_COMPOSITION_LAYER_QUAD) {
+            submitted_quad = *(const XrCompositionLayerQuad *)layer; submitted_quads++;
+        } else {
+            CHECK(layer->type == XR_TYPE_COMPOSITION_LAYER_PROJECTION);
+            submitted_projections++;
+        }
+    }
+    return XR_SUCCESS;
+}
+/* OpenXR's conventional { TYPE } initializes the other members to zero. */
+#ifdef __clang__
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wmissing-field-initializers"
+#endif
+@@HOST@@
+#ifdef __clang__
+#pragma clang diagnostic pop
+#endif
+
+/* Execute the exact production swapchain setup fragment. Runtime creation
+ * records explicit kinds; no reserved former-optic slot may be touched. */
+static int created_count, created_kinds[3], creation_failure;
+static int swapchain_create(int kind, int width, int height, int layers, struct vr_host_info *info) {
+    CHECK(kind >= VR_SWAPCHAIN_EYES && kind < VR_SWAPCHAIN_RESERVED);
+    CHECK(width > 0 && height > 0 && layers == (kind == VR_SWAPCHAIN_HUD ? 1 : 2));
+    CHECK(info && created_count < 3);
+    created_kinds[created_count++] = kind;
+    return created_count != creation_failure;
+}
+static int production_swapchains(struct vr_host_info *info) {
+    @@INIT@@
+    return 1;
+}
+static void check_no_optic_swapchain(void) {
+    struct vr_host_info info;
+    int depth, failure;
+    for (depth = 0; depth < 2; depth++) for (failure = 0; failure < 4; failure++) {
+        memset(&info, 0, sizeof(info));
+        info.eye_width = info.eye_height = 1200; info.hud_width = 1280; info.hud_height = 960;
+        runtime.has_depth = depth; creation_failure = failure; created_count = 0;
+        CHECK(production_swapchains(&info) == (failure != 1 && failure != 2));
+        CHECK(created_count == (failure == 1 ? 1 : failure == 2 ? 2 : 2 + depth));
+        CHECK(created_kinds[0] == VR_SWAPCHAIN_EYES);
+        if (created_count >= 2) CHECK(created_kinds[1] == VR_SWAPCHAIN_HUD);
+        if (created_count == 3) CHECK(created_kinds[2] == VR_SWAPCHAIN_DEPTH);
+        CHECK(info.image_count[VR_SWAPCHAIN_RESERVED] == 0);
+    }
+}
+
+static void head_pose(float yaw, float pitch, float roll) {
+    float turn[4] = { 0.f, sinf(yaw*.5f), 0.f, cosf(yaw*.5f) };
+    float tilt[4] = { sinf(pitch*.5f), 0.f, 0.f, cosf(pitch*.5f) };
+    float lean[4] = { 0.f, 0.f, sinf(roll*.5f), cosf(roll*.5f) };
+    float oriented[4];
+    quaternion_multiply(turn, tilt, oriented);
+    quaternion_multiply(oriented, lean, vr.views.head.orientation);
+    vr.views.head.valid = 1;
+}
+static void fixture(void) {
+    int image;
+    memset(&vr, 0, sizeof(vr)); memset(&settings, 0, sizeof(settings));
+    vr.initialized = vr.frame = vr.origin_valid = vr.aim_synced = 1;
+    vr.views.should_render = vr.views.focused = 1;
+    head_pose(0.f, 0.f, 0.f);
+    vr.views.head.position[0] = 1.f; vr.views.head.position[1] = 1.6f; vr.views.head.position[2] = 2.f;
+    vr.origin_position[0] = -500.f; vr.origin_position[1] = 20.f; vr.origin_position[2] = 700.f;
+    vr.origin_yaw = -1.3f; vr.body_yaw = 2.5f;
+    settings.standing = 1; settings.player_height = 1.7f;
+    settings.menu_distance = 1.5f; settings.menu_width = 1.8f;
+    settings.hud_distance = 1.f; settings.hud_size = 60.f;
+    memset(&runtime, 0, sizeof(runtime)); memset(&timing, 0, sizeof(timing));
+    runtime.session = (XrSession)(uintptr_t)1;
+    runtime.play_space = (XrSpace)(uintptr_t)2; runtime.view_space = (XrSpace)(uintptr_t)3;
+    runtime.frame.predictedDisplayTime = 123456;
+    for (image = 0; image < VR_SWAPCHAIN_COUNT; image++) {
+        vr.acquired[image] = 0;
+        runtime.swapchains[image] = (XrSwapchain)(uintptr_t)(image+4);
+        runtime.swapchain_width[image] = HUD_WIDTH; runtime.swapchain_height[image] = HUD_HEIGHT;
+    }
+    release_calls = 0;
+}
+static void commit_world_view(void) {
+    int eye;
+    for(eye=0;eye<2;eye++) {
+        vr.views.eye[eye]=vr.views.head;
+        vr.views.eye[eye].position[0]+=eye ? .032f : -.032f;
+        vr.views.fov[eye][0]=vr.views.fov[eye][3]=-1;
+        vr.views.fov[eye][1]=vr.views.fov[eye][2]=1;
+    }
+    (void)halo_vr_render_view_commit(1);
+}
+static void submit(int eyes, int hud) {
+    unsigned releases_before = release_calls;
+    vr.frame = 1;
+    if(eyes) commit_world_view();
+    halo_vr_present(eyes, hud);
+    runtime.frame_begun = 1;
+    host_vr_frame_end(&vr.pending_layers);
+    CHECK(!runtime.frame_begun && vr.pending && !vr.frame);
+    CHECK(release_calls == releases_before + 3); /* eyes, HUD and depth only */
+    CHECK(submitted_quads == (unsigned)vr.pending_layers.hud);
+    CHECK(submitted_projections == (unsigned)vr.pending_layers.projection);
+    if (submitted_quads) {
