diff --git a/port/linux/src/vr_locomotion.h b/port/linux/src/vr_locomotion.h
new file mode 100644
index 0000000000000000000000000000000000000000..9fb2eeb599ae20ed8e74d4e72a703379e8b7d76c
--- /dev/null
+++ b/port/linux/src/vr_locomotion.h
@@ -0,0 +1,86 @@
+/* Independent head-relative walking. Throttle axes are forward and left;
+the engine applies them relative to the player's (weapon) facing. Keep this
+math separate from OpenXR so the production code can be tested on a host. */
+#ifndef HALO_VR_LOCOMOTION_H
+#define HALO_VR_LOCOMOTION_H
+
+#include <math.h>
+
+struct halo_vr_locomotion_heading
+{
+	int valid;
+	float yaw;
+};
+
+static inline void halo_vr_locomotion_reset(struct halo_vr_locomotion_heading *heading)
+{
+	heading->valid = 0;
+	heading->yaw = 0.0f;
+}
+
+/* A tracking quaternion must be finite and reasonably close to unit length.
+Normalize its small drift before projecting the head's forward direction. */
+static inline int halo_vr_locomotion_orientation(const float pose[4], float normalized[4])
+{
+	float length_squared = 0.0f;
+	float inverse_length;
+	int index;
+	for (index = 0; index < 4; index++)
+	{
+		if (!isfinite(pose[index]))
+			return 0;
+		length_squared += pose[index] * pose[index];
+	}
+	if (!isfinite(length_squared) || length_squared < 0.5f || length_squared > 1.5f)
+		return 0;
+	inverse_length = 1.0f / sqrtf(length_squared);
+	for (index = 0; index < 4; index++)
+		normalized[index] = pose[index] * inverse_length;
+	return 1;
+}
+
+/* Head forward is in the recentred game axes. At nearly vertical pitch its
+horizontal projection has no reliable yaw: keep the last usable heading,
+or wait for one. Tracking loss invalidates that history and stops walking. */
+static inline int halo_vr_locomotion_project(struct halo_vr_locomotion_heading *heading,
+	int tracked, const float head_forward[3], float body_yaw, float aim_yaw,
+	float *forward, float *left)
+{
+	const float tau = 6.2831853071795864769f;
+	float horizontal_squared, length_squared, delta, cosine, sine, original_forward, original_left;
+	if (!tracked || !isfinite(body_yaw) || !isfinite(aim_yaw) ||
+		!isfinite(*forward) || !isfinite(*left) || !isfinite(head_forward[0]) ||
+		!isfinite(head_forward[1]) || !isfinite(head_forward[2]))
+		goto invalid;
+	horizontal_squared = head_forward[0] * head_forward[0] + head_forward[1] * head_forward[1];
+	length_squared = horizontal_squared + head_forward[2] * head_forward[2];
+	if (!isfinite(length_squared) || length_squared < 0.5f || length_squared > 1.5f)
+		goto invalid;
+	if (horizontal_squared >= 0.01f)
+	{
+		heading->yaw = atan2f(head_forward[1], head_forward[0]);
+		heading->valid = 1;
+	}
+	if (!heading->valid || !isfinite(heading->yaw))
+		goto invalid;
+	delta = remainderf(body_yaw + heading->yaw - aim_yaw, tau);
+	if (!isfinite(delta))
+		goto invalid;
+	cosine = cosf(delta);
+	sine = sinf(delta);
+	original_forward = *forward;
+	original_left = *left;
+	*forward = cosine * original_forward - sine * original_left;
+	*left = sine * original_forward + cosine * original_left;
+	if (!isfinite(*forward) || !isfinite(*left))
+		goto invalid;
+	return 1;
+
+invalid:
+	halo_vr_locomotion_reset(heading);
+	*forward = 0.0f;
+	*left = 0.0f;
+	return 0;
+}
+
+#endif
diff --git a/port/linux/src/vr_vehicle.h b/port/linux/src/vr_vehicle.h
new file mode 100644
index 0000000000000000000000000000000000000000..997d6b351e359b07b4d565534921fe0910d5349c
--- /dev/null
+++ b/port/linux/src/vr_vehicle.h
@@ -0,0 +1,171 @@
+/* A seat owns a tracking reference separate from the saved walking origin.
+ * Plain C math/state only, shared by production VR and the host regression. */
+#ifndef HALO_VR_VEHICLE_H
+#define HALO_VR_VEHICLE_H
+#include <math.h>
+#include <string.h>
+
+struct halo_vr_vehicle_reference
+{
+	int active, valid;
+	int unit, vehicle, seat;
+	float origin_position[3], origin_yaw;
+	float forward_yaw, turn;
+	/* 0 before a hull hook, -1 for invalid data, 1 for a rigid rotation. */
+	int orientation_valid;
+	float hull_axes[3][3], hull_yaw;
+};
+
+/* Axes are forward, left, up. Reject stretched/singular data, then remove
+ * small interpolation rounding with an orthonormal, proper rotation. */
+static inline int halo_vr_vehicle_basis(const float axes[3][3], float hull_yaw,
+	float seat_yaw, float basis[3][3])
+{
+	float forward[3], left[3], up[3], length, dot, c, s;
+	int row, other, axis;
+	if (!axes || !basis || !isfinite(hull_yaw) || !isfinite(seat_yaw))
+		return 0;
+	for (row = 0; row < 3; row++)
+		for (other = row; other < 3; other++)
+		{
+			dot = 0.0f;
+			for (axis = 0; axis < 3; axis++)
+			{
+				if (!isfinite(axes[row][axis]) || !isfinite(axes[other][axis]))
+					return 0;
+				dot += axes[row][axis] * axes[other][axis];
+			}
+			if (!isfinite(dot) || fabsf(dot - (row == other ? 1.0f : 0.0f)) > 0.01f)
+				return 0;
+		}
+	length = sqrtf(axes[0][0] * axes[0][0] + axes[0][1] * axes[0][1] + axes[0][2] * axes[0][2]);
+	for (axis = 0; axis < 3; axis++)
+		forward[axis] = axes[0][axis] / length;
+	left[0] = axes[2][1] * forward[2] - axes[2][2] * forward[1];
+	left[1] = axes[2][2] * forward[0] - axes[2][0] * forward[2];
+	left[2] = axes[2][0] * forward[1] - axes[2][1] * forward[0];
+	length = sqrtf(left[0] * left[0] + left[1] * left[1] + left[2] * left[2]);
+	if (!isfinite(length) || length < 0.0001f)
+		return 0;
+	for (axis = 0; axis < 3; axis++)
+		left[axis] /= length;
+	up[0] = forward[1] * left[2] - forward[2] * left[1];
+	up[1] = forward[2] * left[0] - forward[0] * left[2];
+	up[2] = forward[0] * left[1] - forward[1] * left[0];
+	dot = remainderf(seat_yaw, 6.28318530718f) - remainderf(hull_yaw, 6.28318530718f);
+	c = cosf(dot);
+	s = sinf(dot);
+	for (axis = 0; axis < 3; axis++)
+	{
+		basis[0][axis] = forward[axis] * c + left[axis] * s;
+		basis[1][axis] = left[axis] * c - forward[axis] * s;
+		basis[2][axis] = up[axis];
+	}
+	return 1;
+}
+
+static inline void halo_vr_vehicle_rotate(const float basis[3][3],
+	const float local[3], float world[3])
+{
+	int axis;
+	for (axis = 0; axis < 3; axis++)
+		world[axis] = basis[0][axis] * local[0] + basis[1][axis] * local[1] + basis[2][axis] * local[2];
+}
+
+/* A centre cone must contain translated eye cones at its near plane too.
+ * Eye x is engine-left, whereas the horizontal FOV tangents are right. */
+static inline int halo_vr_stereo_union(const float fov[2][4], const float offset[2][3],
+	float units, float near_plane, float margin, float bounds[4])
+{
+	int eye, edge;
+	float x, y, value[4];
+	if (!isfinite(units) || units <= 0.0f || !isfinite(near_plane) || near_plane < 0.000001f ||
+		!isfinite(margin) || margin < 1.0f)
+		return 0;
+	for (eye = 0; eye < 2; eye++)
+	{
+		if (!isfinite(offset[eye][0]) || !isfinite(offset[eye][1]) || !isfinite(offset[eye][2]))
+			return 0;
+		for (edge = 0; edge < 4; edge++)
+			if (!isfinite(fov[eye][edge]))
+				return 0;
+		if (fov[eye][0] >= fov[eye][1] || fov[eye][3] >= fov[eye][2])
+			return 0;
+		x = -offset[eye][1] * units / near_plane;
+		y = offset[eye][2] * units / near_plane;
+		value[0] = fov[eye][0] + x;
+		value[1] = fov[eye][1] + x;
+		value[2] = fov[eye][2] + y;
+		value[3] = fov[eye][3] + y;
+		for (edge = 0; edge < 4; edge++)
+			if ((edge == 0 || edge == 3) ? value[edge] > fov[eye][edge] : value[edge] < fov[eye][edge])
+				value[edge] = fov[eye][edge];
+		for (edge = 0; edge < 4; edge++)
+		{
+			if (!isfinite(value[edge]))
+				return 0;
+			if (!eye || ((edge == 0 || edge == 3) ? value[edge] < bounds[edge] : value[edge] > bounds[edge]))
+				bounds[edge] = value[edge];
+		}
+	}
+	/* Expand outward even for asymmetric fields entirely on one side. */
+	for (edge = 0; edge < 4; edge++)
+	{
+		bounds[edge] += ((edge == 0 || edge == 3) ? -1.0f : 1.0f) * fabsf(bounds[edge]) * (margin - 1.0f);
+		if (!isfinite(bounds[edge]))
+			return 0;
+	}
+	return bounds[0] < bounds[1] && bounds[3] < bounds[2] && bounds[2] > 0.0f && bounds[3] < 0.0f;
+}
+
+static inline int halo_vr_vehicle_capture(struct halo_vr_vehicle_reference *state,
+	const float position[3], float yaw)
+{
+	int axis;
+	if (!state->active || !isfinite(yaw))
+		return 0;
+	for (axis = 0; axis < 3; axis++)
+		if (!isfinite(position[axis]))
+			return 0;
+	memcpy(state->origin_position, position, sizeof(state->origin_position));
+	state->origin_yaw = yaw;
+	state->turn = 0.0f;
+	state->valid = 1;
+	return 1;
+}
+
+/* Return a transition so aim synchronisation can be restarted on exit.
+ * Missing tracking defers entry capture; it never captures every frame. */
+static inline int halo_vr_vehicle_update(struct halo_vr_vehicle_reference *state,
+	int unit, int vehicle, int seat, float yaw, int tracked,
+	const float position[3], float head_yaw)
+{
+	int changed;
+	if (unit == -1 || vehicle == -1 || seat < 0 || !isfinite(yaw))
+	{
+		changed = state->active;
+		memset(state, 0, sizeof(*state));
+		return changed;
+	}
+	changed = !state->active || state->unit != unit || state->vehicle != vehicle || state->seat != seat;
+	if (changed)
+	{
+		memset(state, 0, sizeof(*state));
+		state->active = 1;
+		state->unit = unit;
+		state->vehicle = vehicle;
+		state->seat = seat;
+	}
+	state->forward_yaw = yaw;
+	if (!tracked)
+		state->valid = 0;
+	else if (!state->valid)
+		halo_vr_vehicle_capture(state, position, head_yaw);
+	return changed;
+}
+
+static inline float halo_vr_vehicle_heading(const struct halo_vr_vehicle_reference *state)
+{
+	return state->forward_yaw + state->turn;
+}
+#endif
