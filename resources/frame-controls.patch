+static void driving_reset(int release_required)
+{
+	driving.wheel_valid = 0;
+	driving.wheel_blocked = release_required != 0;
+	driving.wheel_steer = 0.0f;
+	memset(driving.wheel_axis, 0, sizeof(driving.wheel_axis));
