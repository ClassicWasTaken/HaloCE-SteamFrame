+/* Driving uses the simulation hull heading, independently of the rendered
+seat/camera heading and physical gaze. Only the stock local driver's seats
+opt in: passengers, gunner-only seats and scripted/recorded vehicles retain
+their ordinary control paths. The action queue and vehicle physics are unchanged. */
+int vr_render_vehicle_driving(long unit_index, float *hull_yaw)
+{
+	long player_index = local_player_get_player_index(0), parent_index;
+	struct unit_datum *unit, *parent;
+	struct unit_definition *definition;
+	struct unit_seat *seat;
+	real_vector3d forward, up;
+	const char *name;
+	short seat_index;
+	int mode;
+	if (!hull_yaw)
+		return HALO_VR_DRIVING_NONE;
+	*hull_yaw = 0.0f;
+	if (player_index == NONE || unit_index == NONE || !player_input_enabled() ||
+		cinematic_in_progress() || (director_camera_scripted && *director_camera_scripted) ||
+		director_get_perspective(0) == _director_perspective_scripted ||
+		director_inhibited_input(0) || director_inhibited_facing(0) ||
+		ui_widgets_active_for_local_player(0) || player_get(player_index)->unit_index != unit_index ||
+		!(unit = unit_try_and_get(unit_index)) || unit->unit.player_index != player_index ||
+		unit->object.type != _object_type_biped || TEST_FLAG(unit->object.damage_flags, _object_dead_bit) ||
+		TEST_FLAG(unit->unit.flags, _unit_possessed_by_recording_bit) ||
+		unit->unit.animation.state == _unit_state_entering_seat ||
+		unit->unit.animation.state == _unit_state_exiting_seat)
+		return HALO_VR_DRIVING_NONE;
+	parent_index = unit->object.parent_object_index;
+	seat_index = unit->unit.parent_seat_index;
+	if (parent_index == NONE || !(parent = unit_try_and_get(parent_index)) ||
+		parent->object.type != _object_type_vehicle || TEST_FLAG(parent->object.damage_flags, _object_dead_bit) ||
+		parent->object.parent_object_index != NONE ||
+		TEST_FLAG(parent->unit.flags, _unit_possessed_by_recording_bit))
+		return HALO_VR_DRIVING_NONE;
+	definition = unit_definition_get(parent->definition_index);
+	if (seat_index < 0 || seat_index >= definition->unit.seats.count)
+		return HALO_VR_DRIVING_NONE;
+	seat = TAG_BLOCK_GET_ELEMENT(&definition->unit.seats, seat_index, struct unit_seat);
+	if (!TEST_FLAG(seat->flags, _unit_seat_driver_bit))
+		return HALO_VR_DRIVING_NONE;
+	name = tag_get_name(parent->definition_index);
+	if (!name)
+		return HALO_VR_DRIVING_NONE;
+	if (!strcmp(name, "vehicles\\warthog\\warthog"))
+		mode = HALO_VR_DRIVING_WARTHOG;
+	else if (!strcmp(name, "vehicles\\ghost\\ghost") || !strcmp(name, "vehicles\\ghost\\ghost_mp"))
+		mode = HALO_VR_DRIVING_GHOST;
+	else if (!strcmp(name, "vehicles\\scorpion\\scorpion") || !strcmp(name, "vehicles\\scorpion\\scorpion_mp"))
+		mode = HALO_VR_DRIVING_SCORPION;
+	else if (!strcmp(name, "vehicles\\banshee\\banshee"))
+		mode = HALO_VR_DRIVING_BANSHEE;
+	else
+		return HALO_VR_DRIVING_NONE;
+	/* object_get_node_matrix is interpolated while drawing; do not use it
+	for authoritative desired facing or feed a rotating turret back into aim. */
+	object_get_orientation(parent_index, &forward, &up);
+	if (!vr_render_vehicle_yaw(&forward, &up, hull_yaw))
+		return HALO_VR_DRIVING_NONE;
+	return mode;
+}
