+  CHECK(pass_count==2*available);if(available){CHECK(pass_order[0]==HALO_VR_PASS_EYES&&pass_order[1]==HALO_VR_PASS_HUD);CHECK(window.rasterizer_camera.position==17);}
+ }
+}
+int main(void){direct_aim_and_late_poses();controller_pose_ownership();stock_render_passes();printf("PASS: %u direct aiming, stock zoom render schedule and late-pose assertions\n",checks);return 0;}
+'''
+
+def build_source():
+    vr=(ROOT/'port/linux/src/vr.c').read_text()
+    original=subprocess.check_output(['git','show',PIN+':port/linux/src/vr.c'],cwd=ROOT,text=True)
+    assert function(vr,'weapon_pointing_raw').replace('weapon_pointing_raw','weapon_pointing') == function(original,'weapon_pointing')
+    assert re.sub(r'\s+','',function(vr,'weapon_pointing')) == 'staticvoidweapon_pointing(floatforward[3],floatup[3]){weapon_pointing_raw(forward,up);}'
+    # Old true-valued INI/environment settings cannot reactivate removed code.
+    for obsolete in ('vr.scope','vr.scope_size','vr.zoom_stabilization','zoom_aim_pointing','halo_vr_scope_prepare','halo_vr_weapon_zoom'):
+        assert obsolete not in vr, obsolete
+    for path in ('port/linux/game/vr_render.c','port/linux/src/d3d8_gl.c','source/render/render.c',
+                 'source/interface/first_person_weapons.c','source/interface/hud_weapon.c','source/interface/interface.c',
+                 'port/linux/arm64/host_vr.c'):
+        text=(ROOT/path).read_text()
+        for obsolete in ('HALO_VR_PASS_SCOPE','VR_SWAPCHAIN_SCOPE','vr_render_scope','vr_copy_scope','scope_layer_valid'):
+            assert obsolete not in text, (path,obsolete)
+    host=(ROOT/'port/linux/arm64/host_vr.c').read_text()
+    assert 'VR_SWAPCHAIN_RESERVED' not in host, 'Reserved optics slot must never be allocated/acquired/submitted'
+    assert 'reserved_optic' not in host, 'Reserved optics payload must never be submitted'
+    for path in ('source/interface/first_person_weapons.c','source/interface/hud_weapon.c','source/interface/interface.c'):
+        text=(ROOT/path).read_text()
+        if path.endswith('first_person_weapons.c'):
+            text=without_visibility_guard(text,'vr_render_first_person_visible')
+        elif path.endswith('hud_weapon.c'):
+            text=without_visibility_guard(text,'vr_render_hud_crosshairs_visible')
+        assert text == subprocess.check_output(['git','show',PIN+':'+path],cwd=ROOT,text=True), path
+    state=re.search(r'static struct\s*\{.*?\}\s*vr;',vr,re.S).group()
+    settings=re.search(r'static struct\s*\{\s*unsigned long read_at;.*?\}\s*settings\s*=\s*\{.*?\};',vr,re.S).group()
+    settings=re.sub(r'=\s*\{.*?\};','= {0};',settings,flags=re.S)
+    names=('quaternion_rotate','game_axes','vehicle_view_active','halo_vr_vehicle_orientation','vehicle_basis','normalize','weapon_pointing_raw','weapon_pointing','halo_vr_view','halo_vr_aim')
+    inactive_driver=('static int driving_aim(float *yaw,float *pitch){(void)yaw;(void)pitch;return 0;}\n'
+                     'static void driving_reset(int require_release){(void)require_release;}\n')
+    render=(ROOT/'source/render/render.c').read_text()
+    return HARNESS.replace('@@STATE@@',state+'\n'+settings).replace('@@FUNCTIONS@@',inactive_driver+'\n\n'.join(function(vr,name) for name in names)).replace(
+        '@@LEGACY@@',function(original,'weapon_pointing').replace('weapon_pointing','legacy_weapon_pointing')).replace(
+        '@@RENDER@@',function(render,'render_vr_player_frame'))
+
+def compile_and_run(source, args, extra_includes=()):
+    compiler, vcvars = args.cc or os.environ.get('CC'), args.vcvarsall
+    if not compiler and os.name == 'nt':
+        candidates = sorted((Path(os.environ.get('ProgramFiles', 'C:/Program Files')) / 'Microsoft Visual Studio').glob(
+            '*/**/VC/Tools/MSVC/*/bin/Hostx64/x64/cl.exe'))
+        if candidates:
+            compiler = str(candidates[-1]); vcvars = vcvars or candidates[-1].parents[6] / 'Auxiliary/Build/vcvarsall.bat'
+    compiler = compiler or shutil.which('cc') or shutil.which('clang') or shutil.which('gcc')
+    if not compiler:
+        raise SystemExit('Select a C11 compiler with --cc.')
+    with tempfile.TemporaryDirectory(prefix='halo-vr-zoom-', ignore_cleanup_errors=True) as directory:
+        temp = Path(directory); cfile = temp / 'test.c'; exe = temp / ('test.exe' if os.name == 'nt' else 'test')
+        cfile.write_text(source, encoding='utf-8'); includes = [ROOT / 'port/linux/src', *extra_includes]
+        if Path(compiler).name.lower() in ('cl', 'cl.exe'):
+            command = [compiler, '/nologo', '/std:c11', '/W4', '/WX', '/DHALO_VR', '/D_CRT_SECURE_NO_WARNINGS',
+                       *('/I' + str(include) for include in includes), str(cfile), '/Fe:' + str(exe), '/Fo:' + str(temp / 'test.obj')]
+            if vcvars:
+                for path in (vcvars, Path(compiler), temp, ROOT):
+                    if any(c in str(path) for c in '\r\n"&|<>^%!'):
+                        raise SystemExit('Unsupported compiler/temp path.')
+                batch = temp / 'compile.cmd'
+                batch.write_text('@echo off\ncall "' + str(vcvars) + '" x64 >nul\nif errorlevel 1 exit /b 1\n' + subprocess.list2cmdline(command) + '\n')
+                command = ['cmd.exe', '/d', '/c', str(batch)]
+        else:
+            command = [compiler, '-std=c11', '-Wall', '-Wextra', '-Werror', '-DHALO_VR',
+                       *(item for include in includes for item in ('-I', str(include))),
+                       str(cfile), '-o', str(exe)] + ([] if os.name == 'nt' else ['-lm'])
+        subprocess.run(command, cwd=temp, check=True)
+        subprocess.run([str(exe)], cwd=temp, check=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc')
+    parser.add_argument('--vcvarsall', type=Path)
+    compile_and_run(build_source(), parser.parse_args())
+
+
+if __name__ == '__main__':
+    main()
