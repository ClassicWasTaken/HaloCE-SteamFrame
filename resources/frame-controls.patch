+		reference.yaw_offset = 0.0f;
+		if (seat->marker_name[0] && memchr(seat->marker_name, 0, sizeof(seat->marker_name)) &&
+			object_get_marker_by_name(parent_index, seat->marker_name, &marker, 1))
