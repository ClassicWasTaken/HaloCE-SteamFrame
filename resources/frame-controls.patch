+static boolean vr_render_projectile_pose(long player_index, struct unit_datum *unit,
+	struct projectile_preview_pose *pose)
+{
+	return vr_render_pointing_pose(player_index, unit, &vr_render.view, vr_render.base_yaw, pose);
+}
