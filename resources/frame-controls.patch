+	if (!isfinite(origin->x) || !isfinite(origin->y) || !isfinite(origin->z) ||
+		!isfinite(forward->i) || !isfinite(forward->j) || !isfinite(forward->k) ||
+		!isfinite(length) || length <= 0.0f || normalize3d(forward) <= 0.0f)
+		return FALSE;
+	*owner_object_index = object_get_ultimate_parent(weapon_get_projectile_owner_object_index(weapon_index));
+	return TRUE;
+}
