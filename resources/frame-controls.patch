+#define TEST_FLAG(v,b) ((v) & (1u<<(b)))
+#define SET_FLAG(v,b,on) ((on)?((v)|=1u<<(b)):((v)&=~(1u<<(b))))
+#define PIN(v,lo,hi) ((v)<(lo)?(lo):(v)>(hi)?(hi):(v))
+#define DEGREES_TO_RADIANS(v) ((v)*0.017453292519943295f)
+#define _pi 3.14159265358979323846f
+typedef int boolean;
+typedef float real;
+typedef struct { float i,j,k; } real_vector3d;
+typedef struct { float i,j; } real_vector2d;
+typedef struct { float yaw,pitch; } real_euler_angles2d;
+enum { _object_type_biped=0, _object_type_vehicle=1, _object_type_other=2 };
+enum { _object_dead_bit=0, _unit_possessed_by_recording_bit=1 };
+enum { _unit_state_idle=0, _unit_state_entering_seat=1, _unit_state_exiting_seat=2 };
+enum { _unit_seat_driver_bit=2, _unit_seat_gunner_bit=3 };
+enum { _unit_control_jump_bit=1, _unit_control_use_equipment_bit=7 };
+enum { _director_perspective_first_person=0, _director_perspective_third_person=1, _director_perspective_scripted=2 };
+struct unit_seat { unsigned flags; };
+struct tag_block { int count; struct unit_seat *address; };
+#define TAG_BLOCK_GET_ELEMENT(block,index,type) ((type*)(block)->address+(index))
+struct unit_definition { struct { struct tag_block seats; } unit; };
+struct unit_datum {
+    int definition_index;
+    struct { int type; long parent_object_index; unsigned damage_flags; } object;
+    struct { long player_index; short parent_seat_index; unsigned flags; struct { int state; } animation; } unit;
+};
+struct player_datum { long unit_index; };
+struct player_control {
+    long unit_index; real_euler_angles2d desired_angles; unsigned control_flags;
+    real_vector2d throttle; float primary_trigger; short zoom_level;
+    long desired_weapon_index,desired_grenade_index;
+};
