+            scripts[name] = expression(u32(offset + 36))
+    def calls(tree, name):
+        found = []
+        if isinstance(tree, list):
+            if tree and tree[0] == name:
+                found.append(tree)
+            for child in tree:
+                found.extend(calls(child, name))
+        return found
+    look = scripts['tutorial_looking']
+    assert calls(look, 'player_action_test_reset')
+    for direction in ('left', 'right', 'up', 'down'):
