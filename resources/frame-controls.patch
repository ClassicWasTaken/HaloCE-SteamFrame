+				eye's temporary camera/frustum. Scratch textures are overwritten. */
+				global_window_parameters.camera = camera;
+				global_window_parameters.frustum = frustum;
+				vr_render_sun_glow_begin(eye, &global_window_parameters.camera, &global_window_parameters.frustum);
