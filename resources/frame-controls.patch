+def symbols(path):
+    data = path.read_bytes()
+    assert data[:7] == b'\x7fELF\x02\x01\x01'
+    assert struct.unpack_from('<HH', data, 16) == (1, 183), path
+    offset = struct.unpack_from('<Q', data, 40)[0]
+    size, count = struct.unpack_from('<HH', data, 58)
+    assert size == 64 and 0 < count < 65536 and offset <= len(data)-size*count
+    sections = [struct.unpack_from('<IIQQQQIIQQ', data, offset+i*size) for i in range(count)]
+    result = {}
+    for section in sections:
+        if section[1] != 2:
+            continue
+        start, length, link, stride = section[4], section[5], section[6], section[9]
+        assert stride == 24 and length % stride == 0 and start <= len(data)-length and link < count
+        strings = sections[link]
+        assert strings[1] == 3 and strings[4] <= len(data)-strings[5]
+        names = data[strings[4]:strings[4]+strings[5]]
+        for p in range(start, start+length, stride):
+            name, info, _, index, _, _ = struct.unpack_from('<IBBHQQ', data, p)
+            if not name or info >> 4 not in (1, 2):
+                continue
+            assert name < len(names)
+            end = names.find(b'\0', name)
+            assert end >= 0
+            result[names[name:end].decode('ascii')] = index != 0
+    assert result, path
+    return result
+
+
+def run(argv):
+    result = subprocess.run([str(x) for x in argv], cwd=ROOT, text=True, capture_output=True)
+    if result.returncode:
+        raise AssertionError(' '.join(str(x) for x in argv) + '\n' + result.stdout + result.stderr)
+
+
+def strip_comments(text):
+    return re.sub(r'/\*.*?\*/|//[^\n]*', '', text, flags=re.S)
+
+
+def has_provider(text, name, allow_static=False):
+    # A prototype or another translation unit's static function cannot supply
+    # an external symbol (the missing owner API is such a static function).
+    guard = '' if allow_static else r'(?!static\b)'
+    return bool(re.search(r'^[ \t]*'+guard+r'(?!#)[A-Za-z_][A-Za-z_ \t\n*]*?\b'+
+                         re.escape(name)+r'\s*\([^;{}]*\)\s*\{', text, re.M) or
+                re.search(r'^\s*#define\s+'+re.escape(name)+r'\b', text, re.M))
+
+
+def resolve_tool(command, description):
+    """Accept a PATH command name or an explicit absolute/relative tool path."""
+    candidate = shutil.which(str(command)) or str(command)
+    try:
+        path = Path(candidate).resolve(strict=True)
+    except (OSError, ValueError):
+        raise ValueError(description+' was not found: '+str(command)+'. Install it or provide its executable path.') from None
+    if not path.is_file() or (os.name != 'nt' and not os.access(path, os.X_OK)):
+        raise ValueError(description+' is not an executable file: '+str(command))
+    return path
+
+
+def source_audit():
+    header = (ROOT/'port/linux/src/gl.h').read_text()
+    renderer = strip_comments((ROOT/'port/linux/src/d3d8_gl.c').read_text())
+    calls = set(re.findall(r'\b(gl[A-Z]\w*)\s*\(', renderer))
+    aliases = set(re.findall(r'^#define\s+(gl\w+)\s+halo_gl\w+', header, re.M))
+    for marker in ('DESKTOP_GL_FUNCTIONS', 'ANDROID_GL_FUNCTIONS'):
+        start, end = header.index('/* '+marker+'_BEGIN */'), header.index('/* '+marker+'_END */')
+        listed = set(re.findall(r'X\((\w+)\)', header[start:end]))
+        assert 'glDeleteProgram' in listed, marker+' is missing glDeleteProgram'
+        if marker == 'DESKTOP_GL_FUNCTIONS':
+            assert not calls-listed, 'Renderer GL calls absent from production desktop list: '+str(sorted(calls-listed))
+    assert not calls-aliases, 'Renderer GL calls missing guest pointer aliases: '+str(sorted(calls-aliases))
+    # The failed mounted-optic owner API was private to weapons.c. Its removed
+    # renderer code must never return as an external guest call.
+    source = strip_comments((ROOT/'port/linux/game/vr_render.c').read_text())
+    owner = 'weapon_get_owner_object_index'
+    assert owner not in source, 'Renderer calls an unavailable static weapon helper'
+    assert not has_provider('long '+owner+'(long weapon_index);', owner), 'Prototype-only negative was accepted'
+    return header, calls
+
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cc', default=os.environ.get('CC') or 'clang')
+    parser.add_argument('--ld', help='GNU LLD or lld-link (GNU flavor supported)')
+    parser.add_argument('--sdk', type=Path, default=Path('/usr/include'), help='Installed Khronos include directory')
+    parser.add_argument('--sdl', type=Path, help='Already-local SDL source for SDK declarations on Windows')
+    args = parser.parse_args()
+    header, calls = source_audit()
+    try:
+        cc = resolve_tool(args.cc, 'C compiler')
+    except ValueError as error:
+        parser.error(str(error))
+    linker = args.ld or next((str(p) for p in (cc.with_name('ld.lld'), cc.with_name('ld.lld.exe'),
+                          cc.with_name('lld-link.exe')) if p.is_file()), None) or shutil.which('ld.lld')
+    if not linker:
+        parser.error('GNU LLD is required for the actual ARM import link. Install LLVM LLD or pass --ld with its command name or executable path.')
+    try:
+        linker = resolve_tool(linker, 'GNU LLD linker')
+    except ValueError as error:
+        parser.error(str(error))
+    # Ubuntu's ld.lld is a symlink to the generic lld driver. Resolving it
+    # removes the argv[0] flavor, so select GNU explicitly on every host.
+    link_command = [linker, '-flavor', 'gnu', '-m', 'aarch64linux', '-r']
+    resource = Path(subprocess.check_output([str(cc), '-print-resource-dir'], text=True).strip())
+    abi = [x for x in android_build.GUEST_ABI_FLAGS if x not in ('-DHALO_GLES=1', '-DHALO_ANDROID=1')]
+    with tempfile.TemporaryDirectory(prefix='halo-renderer-link-', ignore_cleanup_errors=True) as directory:
+        temp = Path(directory)
+        sdk = temp/'include'; (sdk/'GL').mkdir(parents=True); (sdk/'SDL3').mkdir()
+        glcore = sdk/'GL/glcorearb.h'
+        sdk_includes = []
+        installed = args.sdk.resolve()/'GL/glcorearb.h'
+        if installed.is_file():
+            shutil.copyfile(installed, glcore)
+            sdk_includes += ['-isystem', installed.parent.parent]
+        else:
+            if not args.sdl:
+                parser.error('Khronos GL headers were not found at '+str(installed)+'. Install them, pass --sdk with their include directory, or pass --sdl with an existing local SDL source.')
+            try:
+                sdl_include = args.sdl.resolve(strict=True)/'include'
+                declarations = (sdl_include/'SDL3/SDL_opengl.h').read_text()+'\n'+(sdl_include/'SDL3/SDL_opengl_glext.h').read_text()
+            except (OSError, ValueError) as error:
+                parser.error('SDL GL declarations are unavailable at '+str(args.sdl)+'. Pass --sdl with an existing complete SDL source: '+str(error))
+            glcore.write_text(re.sub(r'\bGLAPIENTRY\b', 'APIENTRY', declarations))
+            sdk_includes += ['-isystem', sdl_include]
+        # Declaration-only boundaries: no fake GL/game provider implementations.
+        (sdk/'string.h').write_text('int strcmp(const char *, const char *);\n')
+        (sdk/'SDL3/SDL_opengl.h').write_text('#include <GL/glcorearb.h>\n')
+        (sdk/'SDL3/SDL.h').write_text('typedef void (*SDL_FunctionPointer)(void);\nSDL_FunctionPointer SDL_GL_GetProcAddress(const char *);\n')
+        (sdk/'platform.h').write_text('#define TRUE 1\n#define FALSE 0\nvoid platform_log(const char *, ...);\n')
+        (sdk/'gl.h').write_text(header)
+        flags = [*abi, *android_build.GUEST_CODE_FLAGS, '-std=gnu11', '-ffreestanding', '-w',
+                 '-I'+str(sdk), '-isystem', resource/'include', *sdk_includes]
+        serial = 0
+        def compile_source(path, extra=()):
+            nonlocal serial
+            serial += 1
+            output = temp/('object-'+str(serial))
+            run([cc, *extra, *flags, '-S', path, '-o', str(output)+'.darwin.s'])
+            run([sys.executable, 'tools/android_asm_convert.py', str(output)+'.darwin.s', str(output)+'.s'])
+            run([cc, '--target=aarch64-linux-gnu', '-c', str(output)+'.s', '-o', str(output)+'.o'])
+            return Path(str(output)+'.o')
+        def link(objects, name):
+            output = temp/(name+'.o')
+            run([*link_command, '-o', output, *objects])
+            return symbols(output)
+        guest_gl, gl_imports, imports = temp/'guest_gl.c', temp/'gl_imports.list', temp/'imports.s'
+        run([sys.executable, 'tools/android_gl_stubs.py', '--desktop', 'port/linux/src/gl.h', glcore, guest_gl, gl_imports])
+        assert 'hostgl_glDeleteProgram' in gl_imports.read_text().splitlines()
+        assert 'guest_glDeleteProgram' in guest_gl.read_text()
+        run([sys.executable, 'tools/android_imports.py', imports, 'port/android/host_imports.list',
+             'port/linux/arm64/host_imports.list', 'port/linux/arm64/vr_imports.list', gl_imports])
+        imports_obj = temp/'imports.o'
+        run([cc, '--target=aarch64-linux-gnu', '-c', imports, '-o', imports_obj])
+        generated_obj = compile_source(guest_gl)
+        loader = temp/'gl_functions.c'
+        loader.write_text((ROOT/'port/linux/src/gl_functions.c').read_text())
+        pointers_obj = compile_source(loader)
+        caller_text = '#include "gl.h"\n'+''.join(
+            'void *renderer_gl_reference_'+name+'(void) { return (void *)&'+name+'; }\n' for name in sorted(calls))
+        caller_text += 'void renderer_delete_program(GLuint program) { glDeleteProgram(program); }\n'
+        caller = temp/'caller.c'; caller.write_text(caller_text)
+        caller_obj = compile_source(caller)
+        merged = link([caller_obj, pointers_obj, generated_obj, imports_obj], 'renderer-current')
+        missing = [n for n, defined in merged.items() if not defined and
+                   (n.startswith(('halo_gl', 'hostgl_')) or re.match(r'^gl[A-Z]', n))]
+        assert not missing, 'Unresolved production GL guest references: '+str(sorted(missing))
+        assert merged.get('hostgl_glDeleteProgram') and merged.get('halo_glDeleteProgram')
+        # Exact pre-repair header: compiles successfully but leaves a raw GL
+        # reference that the real guest imports cannot provide.
+        negative_dir = temp/'negative'; negative_dir.mkdir()
+        broken_header = re.sub(r'^\s*X\(glDeleteProgram\) \\\n', '', header, flags=re.M)
+        broken_header = re.sub(r'^#define glDeleteProgram halo_glDeleteProgram\n', '', broken_header, flags=re.M)
+        (negative_dir/'gl.h').write_text(broken_header)
+        broken_caller = negative_dir/'caller.c'; broken_caller.write_text(caller_text)
+        broken_obj = compile_source(broken_caller)
+        negative = link([broken_obj, pointers_obj, generated_obj, imports_obj], 'broken-gl')
+        assert negative.get('glDeleteProgram') is False, 'Broken GL import negative did not reproduce the failed link'
+        print('PASS: '+str(len(calls))+' renderer GL calls, real generated ARM guest imports/pointer loader, broken GL negative')
+        print('PASS: removed unavailable weapon owner API and prototype-only negative')
+        print('Relocatable partial link only; full game link and headset execution require separate checks.')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
