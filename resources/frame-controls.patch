+static void check_rolled_openings(void) {
+    int roll,pitch;
+    struct vr_host_pose upright;
+    for(pitch=-90;pitch<=90;pitch+=30) {
+        fixture(); head_pose(1.1f,(float)pitch*(float)M_PI/180.f,0.f);
+        halo_vr_menus(1); submit(1,1); check_front(); upright=vr.menu_pose;
+        for(roll=-180;roll<=180;roll+=15) {
+            int axis;
+            halo_vr_menus(0); halo_vr_menus(1);
