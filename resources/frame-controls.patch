+float halo_vr_vehicle_accelerator(float stick_forward)
+{
+	if (!driving_active() || driving.mode != HALO_VR_DRIVING_WARTHOG)
+		return stick_forward;
+	if (!driving_tracking_valid() || !isfinite(stick_forward))
+	{
+		driving.accelerator_blocked = 1;
+		return 0.0f;
+	}
+	if (!vr.input.active[1])
+	{
+		/* An inactive motion controller cannot accelerate. Keep a separately
+		merged ordinary gamepad/stick's original forward request available. */
+		driving.accelerator_blocked = 1;
+		return stick_forward;
