+def verify_xbox_a10(path):
+    """Bounded passive inspection; return facts, never distribute retail scripts."""
+    raw = path.read_bytes()
+    assert 2048 < len(raw) < 600_000_000 and raw[:4] == b'daeh'
+    declared = struct.unpack_from('<I', raw, 8)[0]
+    assert 2048 < declared < 600_000_000
+    stream = zlib.decompressobj()
+    expanded = stream.decompress(raw[2048:], declared - 2048 + 1)
+    assert stream.eof and not stream.unconsumed_tail and len(expanded) == declared - 2048
+    data = raw[:2048] + expanded
+    assert struct.unpack_from('<I', data, 4)[0] == 5
+    def u32(offset):
+        assert 0 <= offset <= len(data) - 4
+        return struct.unpack_from('<I', data, offset)[0]
+    index = u32(16)
+    table = index + 36
+    magic = u32(index) - table
+    tag_count = u32(index + 12)
+    assert 0 < tag_count < 65536 and table + tag_count * 32 <= len(data)
+    scenario_handle = u32(index + 4)
+    scenario = u32(table + (scenario_handle & 65535)*32 + 20) - magic
+    assert 0 <= scenario < len(data) - 1188
+    syntax, strings = u32(scenario + 1152) - magic, u32(scenario + 1172) - magic
+    strings_size, syntax_size = u32(scenario + 1160), u32(scenario + 1140)
+    assert 0 <= strings <= len(data) - strings_size and 0 <= syntax <= len(data) - syntax_size
+    count = struct.unpack_from('<H', data, syntax + 46)[0]
+    assert 56 + count * 20 <= syntax_size
+    nodes = [struct.unpack_from('<4H3I', data, syntax + 56 + n*20) for n in range(count)]
+    def string(offset):
+        assert 0 <= offset < strings_size
+        end = data.index(b'\0', strings + offset, strings + strings_size)
+        return data[strings + offset:end].decode('ascii')
+    def expression(handle, ancestors=frozenset()):
+        n = handle & 65535
+        assert n < count and n not in ancestors
+        node = nodes[n]
+        if node[3] & 1:
+            if node[3] & 4:
+                return string(node[5]) if node[5] < strings_size else node[6]
+            if node[2] == 6:
+                return struct.unpack('<f', struct.pack('<I', node[6]))[0]
+            if node[2] == 5:
+                return bool(node[6] & 1)
+            return string(node[5]) if node[5] < strings_size else node[6]
+        children = []
+        child = node[6]
+        seen = set()
+        while child != 0xffffffff:
+            slot = child & 65535
+            assert slot < count and slot not in seen
+            seen.add(slot)
+            children.append(expression(child, ancestors | {n}))
+            child = nodes[slot][4]
