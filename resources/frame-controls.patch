+#!/usr/bin/env python3
+"""Compile actual nominal firing/preview/reticle functions with a C11 host.
+
+Checks source equivalence to the pinned firing path, camera/trigger offsets,
+read-only aim assist, vehicle collision ignores, unarmed pointing, current hit
+depth and stereo projection. Engine services are deterministic stubs; no headset or maps needed.
+This does not validate random spread, ballistics or GPU/headset presentation.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+ORIGINAL_ENGINE_COMMIT = '2ae0ee4e3e8a4dfdadfd528a5b085ca699fc9ea4'
+
+
+def function(text, name):
+    match = re.search(r'(?:static\s+)?(?:void|float|real|int|boolean|long|short)\s+' +
+                      re.escape(name) + r'\s*\([^;]*?\)\s*\{', text)
+    assert match, name
+    start = text.index('{', match.start())
+    return text[match.start():block_end(text, start)]
+
+
+def block_end(text, start):
+    masked = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                    lambda item: re.sub(r'[^\n]', ' ', item.group()), text, flags=re.S)
+    end, depth = start + 1, 1
+    while depth:
+        depth += (masked[end] == '{') - (masked[end] == '}')
+        end += 1
+    return end
+
+
+def normalized(text):
+    return re.sub(r'\s+', '', text)
+
+
+def verify_refactors(weapons, aim, render, units):
+    old_weapons = subprocess.check_output(['git', 'show', ORIGINAL_ENGINE_COMMIT + ':source/items/weapons.c'], cwd=ROOT, text=True)
+    old_aim = subprocess.check_output(['git', 'show', ORIGINAL_ENGINE_COMMIT + ':source/game/aim_assist.c'], cwd=ROOT, text=True)
+    old_fire = function(old_weapons, 'trigger_create_projectiles')
+    start = old_fire.index('if (!TEST_FLAG(trigger_definition->flags, _weapon_trigger_projectiles_cannot_be_aimed_bit)')
+    end = block_end(old_fire, old_fire.index('{', start))
+    preparation = old_fire[start:end]
+    # Reinsert the shared call into the full real-shot function: everything
+    # after nominal preparation (spread, placement, ammo and RNG) must match.
+    new_fire = function(weapons, 'trigger_create_projectiles')
+    call = 'target_object_index = trigger_adjust_projectile_ray(owner_object_index, unit, trigger_definition,\n\t\t\t&origin, &forward, &velocity, &error, FALSE, NULL);'
+    assert new_fire.count(call) == 1
+    assert normalized(new_fire.replace(call, preparation)) == normalized(old_fire), 'Real firing behavior changed'
+    shared = function(weapons, 'trigger_adjust_projectile_ray')
+    shared_start = shared.index('if (!TEST_FLAG(trigger_definition->flags, _weapon_trigger_projectiles_cannot_be_aimed_bit)')
+    shared_block = shared[shared_start:block_end(shared, shared.index('{', shared_start))]
+    assert 'player_preview_projectile_aim' in shared_block and 'length <= 0.0f' in shared_block
+    shared_block = re.sub(r'#ifdef HALO_VR\n.*?#endif\n', '', shared_block, flags=re.S)
+    expected = preparation
+    for local in ('origin', 'forward', 'velocity', 'error'):
+        expected = re.sub(r'&' + local + r'\b', local, expected)
+    assert normalized(shared_block) == normalized(expected), 'Shared trigger preparation changed math'
+    old_body = function(old_aim, 'player_aim_projectile')
+    old_body = old_body[old_body.index('{'):]
+    new_body = function(aim, 'player_aim_projectile_internal')
+    new_body = new_body[new_body.index('{'):]
+    new_body = re.sub(r'#ifn?def HALO_VR\n.*?#endif\n', '', new_body, flags=re.S)
+    recording = re.search(r'if \(record_target\)\s*\{([^{}]*)\}', new_body)
+    assert recording and 'aim_assist_unit_index' in recording.group(1) and 'aim_assist_timestamp' in recording.group(1)
+    assert normalized(new_body[:recording.start()] + recording.group(1) + new_body[recording.end():]) == normalized(old_body), 'Shared aim math changed'
+    assert 'TRUE' in function(aim, 'player_aim_projectile') and 'FALSE' in function(aim, 'player_preview_projectile_aim')
+    old_units = subprocess.check_output(['git', 'show', ORIGINAL_ENGINE_COMMIT + ':source/units/units.c'], cwd=ROOT, text=True)
+    original_unit = function(old_units, 'unit_adjust_projectile_ray')
+    new_unit = function(units, 'unit_adjust_projectile_ray_internal')
+    new_unit = new_unit[new_unit.index('{'):]
+    new_unit = new_unit.replace('preview_forward ? *preview_forward : unit->unit.aiming_vector', 'unit->unit.aiming_vector')
+    new_unit = new_unit.replace('if (preview_camera)\n\t\t\tcamera_position = *preview_camera;\n\t\telse\n\t\t\tunit_get_camera_position(unit_index, &camera_position);',
+                                'unit_get_camera_position(unit_index, &camera_position);')
+    assert normalized(new_unit) == normalized(original_unit[original_unit.index('{'):]), 'Unit NULL firing math changed'
+    assert 'NULL, NULL' in function(units, 'unit_adjust_projectile_ray')
+    assert function(units, 'unit_clip_to_aiming_bounds') == function(old_units, 'unit_clip_to_aiming_bounds')
+    pose_builder = function(render, 'vr_render_pointing_pose')
+    assert 'render_interpolation_camera(0, observer_get_camera(0))' in pose_builder
+    assert 'hand_position' not in pose_builder and 'base_position' not in pose_builder and 'player_effect_get_camera_effect_matrix' not in pose_builder
+    assert 'DEGREES_TO_RADIANS(85.0f)' in pose_builder and 'unit_clip_to_aiming_bounds' in pose_builder
+    assert 'vr_render_pointing_pose(player_index, unit, &vr_render.view, vr_render.base_yaw, pose)' in function(render, 'vr_render_projectile_pose')
+    preview = function(weapons, 'weapon_preview_projectile_ray')
+    assert 'object_get_ultimate_parent(weapon_get_projectile_owner_object_index(weapon_index))' in preview
+    assert 'MAXIMUM_NUMBER_OF_TRIGGERS_PER_WEAPON' in preview
+    hud = function(render, 'vr_render_hud_camera')
