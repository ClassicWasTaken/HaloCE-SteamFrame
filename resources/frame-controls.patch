+#define HUD_HEIGHT 960
+#define METRES_PER_WORLD_UNIT 3.048f
+#define NONE (-1)
+#define TRUE 1
+#define FALSE 0
+#define TEST_FLAG(v,b) ((v) & (1u<<(b)))
+typedef int boolean;
+typedef float real;
+typedef struct { float i,j,k; } real_vector3d;
+typedef struct { float x,y,z; } real_point3d;
+typedef struct {
+    real scale;
+    union { real n[4][3]; struct { real_vector3d forward,left,up; real_point3d position; }; };
+} real_matrix4x3;
+static unsigned checks;
+#define CHECK(c) do { checks++; if (!(c)) { fprintf(stderr,"line %d: %s\n",__LINE__,#c); exit(1); } } while(0)
+static int near(float a,float b) { return fabsf(a-b)<0.0001f; }
+static struct {
+    int initialized,frame,pending,aim_synced,aiming,origin_valid,long_gun,render_pose_valid;
+    struct vr_host_views views;
