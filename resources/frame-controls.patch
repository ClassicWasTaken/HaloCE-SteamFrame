+#!/usr/bin/env python3
+"""Run production seat/aim/view and occupied-glass code without retail data.
+
+Tracking and game services are mocked; the seat state header, platform functions,
+local-seat guards, glass predicate and transparent draw loop are production code.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+from test_vr_pointer_radar import function
+from test_vr_projectile_reticle import block_end
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def matrix_function(text, name):
+    match = re.search(r'real_point3d\s*\*\s*' + re.escape(name) + r'\s*\([^;]*?\)\s*\{', text)
+    assert match, name
+    return text[match.start():block_end(text, text.index('{', match.start()))]
+
+
+HARNESS = r'''
+#define _USE_MATH_DEFINES
