+        CHECK(submitted_quad.eyeVisibility == XR_EYE_VISIBILITY_BOTH);
+        CHECK(submitted_quad.subImage.swapchain == runtime.swapchains[VR_SWAPCHAIN_HUD]);
+        CHECK(close_float(submitted_quad.pose.position.x, vr.pending_layers.hud_pose.position[0]));
+        CHECK(close_float(submitted_quad.pose.position.y, vr.pending_layers.hud_pose.position[1]));
+        CHECK(close_float(submitted_quad.pose.position.z, vr.pending_layers.hud_pose.position[2]));
+        CHECK(close_float(submitted_quad.pose.orientation.x, vr.pending_layers.hud_pose.orientation[0]));
+        CHECK(close_float(submitted_quad.pose.orientation.y, vr.pending_layers.hud_pose.orientation[1]));
+        CHECK(close_float(submitted_quad.pose.orientation.z, vr.pending_layers.hud_pose.orientation[2]));
+        CHECK(close_float(submitted_quad.pose.orientation.w, vr.pending_layers.hud_pose.orientation[3]));
+        CHECK(close_float(submitted_quad.size.width, vr.pending_layers.hud_size[0]));
+        CHECK(close_float(submitted_quad.size.height, vr.pending_layers.hud_size[1]));
+    }
+}
+static void check_front(void) {
+    static const float forwards[3] = { 0.f, 0.f, -1.f };
+    static const float right[3] = { 1.f, 0.f, 0.f }, up[3] = { 0.f, 1.f, 0.f };
+    float orientation[4], pointing[3], panel_forward[3], panel_right[3], panel_up[3], distance_squared = 0.f;
+    int axis;
+    CHECK(halo_vr_locomotion_orientation(vr.views.head.orientation, orientation));
+    quaternion_rotate(orientation, forwards, pointing);
+    CHECK(vr.menu_open && vr.menu_pose.valid && vr.pending_layers.hud && !vr.pending_layers.hud_head_locked);
+    for (axis = 0; axis < 3; axis++) {
+        float offset = vr.pending_layers.hud_pose.position[axis] - vr.views.head.position[axis];
+        CHECK(close_float(offset, pointing[axis] * settings.menu_distance));
+        distance_squared += offset * offset;
+    }
+    CHECK(close_float(distance_squared, settings.menu_distance * settings.menu_distance));
+    CHECK(halo_vr_locomotion_orientation(vr.pending_layers.hud_pose.orientation, orientation));
+    quaternion_rotate(orientation, forwards, panel_forward);
+    quaternion_rotate(orientation, right, panel_right);
+    quaternion_rotate(orientation, up, panel_up);
+    for (axis = 0; axis < 3; axis++) CHECK(fabsf(panel_forward[axis]-pointing[axis]) < 0.00015f);
+    CHECK(close_float(panel_right[1], 0.f)); /* no sideways text tilt */
+    CHECK(panel_up[1] >= -0.00005f); /* never upside down */
+}
+static void check_open_angles_and_gameplay_state(void) {
+    int yaw, pitch, roll;
+    for (yaw = -180; yaw <= 180; yaw += 15) for (pitch = -90; pitch <= 90; pitch += 15)
+    for (roll = -180; roll <= 180; roll += 30) {
