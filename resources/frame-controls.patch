+#!/usr/bin/env python3
+"""Run production pause-tag construction and existing VR settings events.
+
+No game data, graphics context, headset or network is used. Validate generated
+XML/embedded art, then compile production C helpers with strict host warnings.
+The real guest ABI is checked separately by the native build.
+"""
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import struct
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def block(text, start):
+    masked = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"',
+                    lambda m: re.sub(r'[^\n]', ' ', m.group()), text, flags=re.S)
+    opening = masked.index('{', start)
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (masked[end] == '{') - (masked[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+def function(text, name):
+    match = re.search(r'(?:static\s+)?(?:struct\s+widget_instance\s*\*|boolean|void\s*\*|void|short|int|long)\s*' +
+                      re.escape(name) + r'\s*\([^;]*?\)\s*\{', text)
+    if not match:
+        raise AssertionError('Missing production function: ' + name)
+    return block(text, match.start())
+
+
+def inputs():
+    spec = importlib.util.spec_from_file_location('pause_settings_generator', ROOT / 'tools/port_settings.py')
+    generator = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(generator)
+    widgets = {}
+    for page in ('vr_controls', 'vr_display'):
+        name = f'{generator.PE}/{page}'.replace('/', '.') + '.xml'
+        path = ROOT / 'port/assets/menus/ce' / name
+        assert path.read_text() == '\n'.join(generator.settings_files()[name]), name
+        widgets.update({node.attrib['name']: node for node in ET.parse(path).getroot() if node.tag == 'widget'})
+    controls = widgets[f'{generator.PE}/vr_controls/vr_controls_screen']
+    display = widgets[generator.VR_DISPLAY]
+    for screen in (controls, display):
+        assert 'pause_game' in screen.attrib['flags'].split()
+        assert {node.attrib['event'] for node in screen if node.tag == 'on'} == {'b', 'back'}
+        assert all(node.attrib.get('back') == 'true' for node in screen if node.tag == 'on')
+    link = widgets[f'{generator.PE}/vr_controls/op_vr_display_screen']
+    for button in ('a', 'start'):
