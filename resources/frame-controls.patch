+#ifdef HALO_VR
+/* Only the final sun-ray composite is scaled. Keep the visibility mask,
+ * depth test and per-eye blur at their original strength. */
+static real rasterizer_vr_sun_glow_strength(double configured)
+{
+	if (!isfinite(configured))
+		return 0.5f;
+	if (configured < 0.0)
+		return 0.0f;
+	if (configured > 1.0)
+		return 1.0f;
+	return (real)configured;
+}
+#endif
+
+void rasterizer_sun_glow_draw(
+	struct rasterizer_lens_flare_submit_parameters const *flare)
+{
+#ifdef HALO_VR
+	extern boolean vr_render_sun_glow_begin(short eye, struct render_camera *camera, struct render_frustum *frustum);
+	extern void vr_render_sun_glow_end(void);
+	extern double config_real(const char *name);
+	struct render_camera camera = global_window_parameters.camera;
+	struct render_frustum frustum = global_window_parameters.frustum;
+	short eye;
+	if (vr_render_sun_glow_begin(0, &global_window_parameters.camera, &global_window_parameters.frustum))
+	{
+		real glow_strength = rasterizer_vr_sun_glow_strength(config_real("vr.sun_glow_strength"));
+		for (eye = 0; eye < 2; eye++)
+		{
+			if (eye != 0)
+			{
+				/* Start from the saved depth range, rather than the previous
+				eye's temporary camera/frustum. Scratch textures are overwritten. */
+				global_window_parameters.camera = camera;
+				global_window_parameters.frustum = frustum;
+				vr_render_sun_glow_begin(eye, &global_window_parameters.camera, &global_window_parameters.frustum);
+			}
+			rasterizer_sun_glow_draw_internal(flare, glow_strength);
+		}
+		global_window_parameters.camera = camera;
+		global_window_parameters.frustum = frustum;
+		vr_render_sun_glow_end();
+		return;
+	}
+#endif
+	rasterizer_sun_glow_draw_internal(flare, 1.0f);
+}
