+        CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_left_bit));
+        CHECK(TEST_FLAG(tutorial.action_flags, _player_control_look_relative_up_bit));
+    }
+    reset_state(); player_control_action_test_note(0, &still, &idle, 0.0f);
+    head_pose(0.03f, 0.04f);
+    for (component = 0; component < 4; component++) vr.views.head.orientation[component] *= 1.01f;
+    player_control_action_test_note(0, &still, &idle, 0.0f);
