+/* Prefer the same rigid hull axes as the camera anchor. If the renderer
+has no valid interpolated root, use its current simulation orientation. */
+static boolean vr_render_vehicle_basis(long parent_index, real_matrix4x3 const *root, real heading, float basis[3][3])
+{
+	float axes[3][3];
+	real_vector3d forward, up, left;
+	if (root)
+	{
+		memcpy(axes[0], &root->forward, sizeof(axes[0]));
+		memcpy(axes[1], &root->left, sizeof(axes[1]));
+		memcpy(axes[2], &root->up, sizeof(axes[2]));
+		if (halo_vr_vehicle_basis(axes, heading, heading, basis))
+		{
+			return TRUE;
+		}
+	}
+	object_get_orientation(parent_index, &forward, &up);
+	cross_product3d(&up, &forward, &left);
+	memcpy(axes[0], &forward, sizeof(axes[0]));
+	memcpy(axes[1], &left, sizeof(axes[1]));
+	memcpy(axes[2], &up, sizeof(axes[2]));
+	return halo_vr_vehicle_basis(axes, heading, heading, basis);
+}
