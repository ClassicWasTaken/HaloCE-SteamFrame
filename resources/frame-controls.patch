+  reset();register_driver(mode);vr.input.buttons=VR_BUTTON_B;CHECK(!halo_vr_vehicle_brake());
+  memset(&pad,0,sizeof(pad));halo_vr_gamepad(&pad);CHECK(pad.bAnalogButtons[XINPUT_GAMEPAD_B]==255);
