new file mode 100644
index 0000000000000000000000000000000000000000..cbf5316de2938537be2ea1d4d52c442283279f30
--- /dev/null
+++ b/tools/test_build_sources.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python3
+"""Offline regressions for the production musl digest and SDL commit fetch.
+
+Network/download/git commands are synthetic stubs. Corrupt-download tests use
+the real SHA256 implementation; the successful extraction test supplies a
+deterministic digest stub for synthetic bytes rather than shipping upstream data.
+"""
+import hashlib
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from tools import android_build as build
+
+
+class SyntheticSources:
+    payload = b"synthetic musl archive; no upstream source bytes"
+
+    def __init__(self):
+        self.commands = []
+        self.queries = []
+        self.head = build.SDL_COMMIT
+        self.dirty = ""
+        self.fail_tar = False
+
+    def run(self, argv, *, check, cwd=None):
+        assert check is True
+        self.commands.append(tuple(str(value) for value in argv))
+        if argv[0] == "curl":
+            assert argv[-1] == build.MUSL_URL
+            Path(argv[argv.index("-o") + 1]).write_bytes(self.payload)
+        elif argv[0] == "tar":
+            assert argv[1:] == ["xzf", f"musl-{build.MUSL_VERSION}.tar.gz"]
+            source = Path(cwd) / f"musl-{build.MUSL_VERSION}"
+            source.mkdir()
+            if self.fail_tar:
+                raise subprocess.CalledProcessError(1, argv)
+        elif argv[:3] == ["git", "init", "-q"]:
+            Path(argv[3]).mkdir()
+        elif argv[0] == "git" and argv[3] == "fetch":
+            assert argv[4:] == ["-q", "--depth", "1", build.SDL_URL, build.SDL_COMMIT]
+        elif argv[0] == "git" and argv[3] == "checkout":
+            assert argv[4:] == ["-q", "--detach", build.SDL_COMMIT]
+        else:
+            raise AssertionError(f"Unexpected command {argv!r}")
+        return subprocess.CompletedProcess(argv, 0)
+
+    def check_output(self, argv, *, text):
+        assert text is True
+        self.queries.append(tuple(argv))
+        if argv[3:] == ["rev-parse", "HEAD"]:
+            return self.head + "\n"
+        if argv[3:] == ["status", "--porcelain", "--untracked-files=no"]:
+            return self.dirty
+        raise AssertionError(f"Unexpected query {argv!r}")
+
+
+class PinnedSourcesTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="halo-pinned-sources-")
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name) / "third_party"
+        self.server = SyntheticSources()
+        self.run_patch = patch.object(build.subprocess, "run", self.server.run)
+        self.output_patch = patch.object(build.subprocess, "check_output", self.server.check_output)
+        self.run_patch.start(); self.output_patch.start()
+        self.addCleanup(self.run_patch.stop); self.addCleanup(self.output_patch.stop)
+
+    @property
+    def musl(self):
+        return self.root / f"musl-{build.MUSL_VERSION}"
+
+    def cached_musl(self, stamp=True):
+        self.musl.mkdir(parents=True)
+        if stamp:
+            (self.musl / build.MUSL_STAMP).write_bytes((build.MUSL_SHA256 + "\n").encode("ascii"))
+
+    def synthetic_valid_digest(self):
+        case = self
+        class Digest:
+            def __init__(self):
+                self.bytes = bytearray()
+            def update(self, data):
+                self.bytes.extend(data)
+            def hexdigest(self):
+                case.assertEqual(bytes(self.bytes), case.server.payload)
+                return build.MUSL_SHA256
+        return patch.object(build.hashlib, "sha256", Digest)
+
+    def test_known_upstream_pins_and_guest_abi_are_unchanged(self):
+        self.assertEqual(build.MUSL_VERSION, "1.2.5")
+        self.assertEqual(build.MUSL_SHA256, "a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4")
+        self.assertEqual(build.SDL_TAG, "release-3.4.16")
+        self.assertEqual(build.SDL_COMMIT, "fa2c02bb6e21974a89ea9824bc53c9932abe5f9c")
+        self.assertIn("--target=arm64_32-apple-watchos", build.GUEST_ABI_FLAGS)
+
+    def test_corrupt_download_is_rejected_before_tar_or_git(self):
+        self.assertNotEqual(hashlib.sha256(self.server.payload).hexdigest(), build.MUSL_SHA256)
+        with self.assertRaisesRegex(OSError, "checksum.*Extraction refused"):
+            build.fetch_third_party(self.root)
+        self.assertEqual([command[0] for command in self.server.commands], ["curl"])
+        self.assertFalse(self.musl.exists())
+        self.assertFalse((self.root / f"musl-{build.MUSL_VERSION}.tar.gz").exists())
+
+    def test_verified_download_and_exact_checkout_then_cached_head_recheck(self):
+        with self.synthetic_valid_digest():
+            build.fetch_third_party(self.root)
+        self.assertEqual((self.musl / build.MUSL_STAMP).read_bytes(), (build.MUSL_SHA256 + "\n").encode("ascii"))
+        fetch = next(command for command in self.server.commands if command[0] == "git" and command[3] == "fetch")
+        self.assertEqual(fetch[-2:], (build.SDL_URL, build.SDL_COMMIT))
+        self.assertFalse(any("--branch" in command or "clone" in command for command in self.server.commands))
+        self.assertEqual(self.server.queries[0][3:], ("rev-parse", "HEAD"))
+        before = len(self.server.commands)
+        build.fetch_third_party(self.root)
+        self.assertEqual(len(self.server.commands), before)  # No download or checkout silently replaces a cache.
+        self.assertEqual(len(self.server.queries), 4)  # HEAD and tracked status checked on both calls.
+
+    def test_preexisting_unverified_musl_is_never_reused(self):
+        self.cached_musl(stamp=False)
+        with self.assertRaisesRegex(OSError, "Unverified musl source cache"):
+            build.fetch_third_party(self.root)
+        self.assertFalse(self.server.commands)
+
+    def test_wrong_or_malformed_musl_stamp_is_never_reused(self):
+        self.cached_musl()
+        stamp = self.musl / build.MUSL_STAMP
+        for content in (b"0" * 64 + b"\n", b"not a verified archive\n", (build.MUSL_SHA256 + "\r\n").encode("ascii")):
+            with self.subTest(stamp=content):
+                stamp.write_bytes(content)
+                with self.assertRaisesRegex(OSError, "Unverified musl source cache"):
+                    build.fetch_third_party(self.root)
+        self.assertFalse(self.server.commands)
+
+    def test_partial_extract_cannot_acquire_a_verification_stamp(self):
+        self.server.fail_tar = True
+        with self.synthetic_valid_digest(), self.assertRaises(subprocess.CalledProcessError):
+            build.fetch_third_party(self.root)
+        self.assertTrue(self.musl.is_dir())
+        self.assertFalse((self.musl / build.MUSL_STAMP).exists())
+        with self.assertRaisesRegex(OSError, "Unverified musl source cache"):
+            build.fetch_third_party(self.root)
+        self.assertFalse(any(command[0] == "git" for command in self.server.commands))
+
+    def test_cached_sdl_wrong_head_rejected_without_reset_or_network(self):
+        self.cached_musl()
+        (self.root / "SDL3").mkdir()
+        self.server.head = "0" * 40
+        with self.assertRaisesRegex(OSError, "SDL source cache is not the pinned commit"):
+            build.fetch_third_party(self.root)
+        self.assertFalse(self.server.commands)
+        self.assertEqual(len(self.server.queries), 1)
+
+    def test_new_sdl_fetch_must_also_verify_its_actual_head(self):
+        self.cached_musl()
+        self.server.head = "0" * 40
+        with self.assertRaisesRegex(OSError, "SDL source cache is not the pinned commit"):
+            build.fetch_third_party(self.root)
+        self.assertEqual([command[3] if command[1] == "-C" else command[1]
+                          for command in self.server.commands], ["init", "fetch", "checkout"])
+
+    def test_cached_sdl_with_tracked_changes_is_rejected(self):
+        self.cached_musl()
+        (self.root / "SDL3").mkdir()
+        self.server.dirty = " M CMakeLists.txt\n"
+        with self.assertRaisesRegex(OSError, "tracked local changes"):
+            build.fetch_third_party(self.root)
+        self.assertFalse(self.server.commands)
+
+
+if __name__ == "__main__":
+    unittest.main()
