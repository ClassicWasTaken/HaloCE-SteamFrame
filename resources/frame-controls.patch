+	parent_index = unit->object.parent_object_index;
+	seat_index = unit->unit.parent_seat_index;
+	if (parent_index == NONE || !(parent = unit_try_and_get(parent_index)) ||
+		parent->object.type != _object_type_vehicle || TEST_FLAG(parent->object.damage_flags, _object_dead_bit))
+		goto exit_seat;
+	definition = unit_definition_get(parent->definition_index);
