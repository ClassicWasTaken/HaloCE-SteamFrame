+	quaternion_rotate(inverse, offset, local_origin);
+	quaternion_rotate(inverse, direction, local_direction);
+	if (!isfinite(local_origin[2]) || !isfinite(local_direction[2]) ||
+		local_origin[2] <= 0.0001f || local_direction[2] >= -0.0001f)
+		return 0;
