+        register_calls=0;vr.input.buttons=VR_BUTTON_B|(pressed?VR_BUTTON_A:0);
+        sample.throttle=(real_vector2d){1,(float)direction};sample.unit_control_flags|=1u<<_unit_control_use_equipment_bit;
+        dispatch(0,.016f);
+        CHECK(queued.throttle.i==0&&queued.throttle.j==0);
+        CHECK(TEST_FLAG(queued.control_flags,_unit_control_jump_bit));
+        CHECK(!TEST_FLAG(queued.control_flags,_unit_control_use_equipment_bit));
+        CHECK(near(sinf(queued.desired_facing.yaw),sinf(direction/sqrtf(2)*_pi/3)));
+        CHECK(!driving.accelerator_blocked);
+        register_calls=0;dispatch(0,.016f);CHECK(queued.throttle.i==0&&TEST_FLAG(queued.control_flags,_unit_control_jump_bit));
+        register_calls=0;vr.input.buttons=pressed?VR_BUTTON_A:0;sample.throttle=(real_vector2d){0,(float)direction};
+        dispatch(0,.016f);
+        CHECK(queued.throttle.i==(pressed?1:0)&&!TEST_FLAG(queued.control_flags,_unit_control_jump_bit));
+    }
+    /* B maps only for a handled native VR Warthog driver. Stock gamepad,
+    passenger, other vehicles and focus loss never get synthesized brakes. */
+    for(mode=1;mode<=3;mode++) {
+        reset();tag_name=names[mode];vr.input.buttons=VR_BUTTON_B;
+        sample.unit_control_flags|=1u<<_unit_control_use_equipment_bit;sample.unit_control_flags&=~(1u<<_unit_control_jump_bit);
+        dispatch(0,.016f);
+        CHECK(!TEST_FLAG(queued.control_flags,_unit_control_jump_bit)&&TEST_FLAG(queued.control_flags,_unit_control_use_equipment_bit));
+        CHECK(queued.throttle.i==.75f);
+    }
+    reset();units[1].unit.parent_seat_index=1;vr.input.buttons=VR_BUTTON_B;
+    sample.unit_control_flags|=1u<<_unit_control_use_equipment_bit;sample.unit_control_flags&=~(1u<<_unit_control_jump_bit);
+    dispatch(0,.016f);CHECK(!TEST_FLAG(queued.control_flags,_unit_control_jump_bit)&&TEST_FLAG(queued.control_flags,_unit_control_use_equipment_bit));
+    reset();settings.gamepad_aim=1;steering_result=0;vr.input.buttons=VR_BUTTON_B;
+    sample.unit_control_flags|=1u<<_unit_control_use_equipment_bit;dispatch(0,.016f);
+    CHECK(TEST_FLAG(queued.control_flags,_unit_control_use_equipment_bit)&&queued.throttle.i==.75f);
+    reset();ready=0;steering_result=2;vr.input.buttons=VR_BUTTON_A|VR_BUTTON_B;
+    sample.unit_control_flags|=1u<<_unit_control_use_equipment_bit;dispatch(0,.016f);
+    CHECK(queued.throttle.i==0&&!TEST_FLAG(queued.control_flags,_unit_control_jump_bit)&&!TEST_FLAG(queued.control_flags,_unit_control_use_equipment_bit));
+}
+int main(void) { query_cases();action_cases();accelerator_queue_cases();brake_queue_cases();printf("PASS: %u production driving game assertions\n",checks);return 0; }
