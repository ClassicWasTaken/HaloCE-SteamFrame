+    CHECK(TEST_FLAG(tutorial.action_flags, _player_control_move_relative_left_bit));
+}
+static void check_tutorial_tracking_recovery(void) {
+    const real_euler_angles2d still = { 0.0f, 0.0f };
+    const real_vector2d idle = { 0.0f, 0.0f };
