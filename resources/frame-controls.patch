+	if (!(vr.input.buttons & VR_BUTTON_A))
+	{
+		driving.accelerator_blocked = 0;
+		driving.accelerator_consumed = 0;
+	}
+	else if (!driving.accelerator_blocked)
+		driving.accelerator_consumed = 1;
+	/* Braking wins over both A and reverse, while a released A still rearms
+	above. The game also receives its native brake flag, so this is braking
+	rather than merely removing the gas and coasting. */
+	if (halo_vr_vehicle_brake())
+		return 0.0f;
+	if (!(vr.input.buttons & VR_BUTTON_A) || driving.accelerator_blocked)
+		return stick_forward;
