+        CHECK(near(center.x,position.x+radius*forward.i));
+        /* Missing from stale clusters: included once without partition/datum edits. */
+        lights_vr_include_unarmed_flashlights(); CHECK(lights_globals.scene_point_light_count==1);
+        CHECK(data_next_calls>0);
+        CHECK(lights_globals.scene_point_lights[0]==0);
+        lights_vr_include_unarmed_flashlights(); CHECK(lights_globals.scene_point_light_count==1);
+        lights_render_diffuse(); lights_render_specular();
+        CHECK(diffuse_calls==1 && specular_calls==1 && diffuse_skip && specular_skip && cluster_reads==0);
+        CHECK(near(diffuse_center.x,position.x+diffuse_radius*forward.i));
+        CHECK(near(specular_center.x,position.x+specular_radius*forward.i));
+        CHECK(memcmp(&tick,&fixture_lights[0],sizeof(tick))==0);
+    }
+    /* Full visibility budget stays bounded and keeps the player's flashlight. */
+    flashlight_reset(); lights_globals.scene_point_light_count=MAXIMUM_RENDERED_LIGHTS;
+    lights_globals.scene_point_lights[0]=2; lights_globals.scene_point_lights[1]=3;
+    marked[2]=marked[3]=1; lights_vr_include_unarmed_flashlights();
+    CHECK(lights_globals.scene_point_light_count==MAXIMUM_RENDERED_LIGHTS);
+    CHECK(lights_globals.scene_point_lights[0]==2 && lights_globals.scene_point_lights[1]==0);
+    flashlight_reset(); fixture_light_intensity=0;
+    lights_globals.scene_point_light_count=MAXIMUM_RENDERED_LIGHTS;
+    lights_globals.scene_point_lights[0]=2; lights_globals.scene_point_lights[1]=3;
+    marked[2]=marked[3]=1; lights_vr_include_unarmed_flashlights();
+    CHECK(lights_globals.scene_point_light_count==MAXIMUM_RENDERED_LIGHTS);
+    CHECK(lights_globals.scene_point_lights[0]==2 && lights_globals.scene_point_lights[1]==3);
+    for(scenario=0;scenario<6;scenario++) {
+        real_point3d rendered,tick; real radius,tick_radius;
+        flashlight_reset();
+        switch(scenario) {
+        case 0: fixture_light_definition.flags=0; break; /* ordinary dynamic light */
+        case 1: fixture_lights[0].parent_light_index=5; break; /* transient effect */
+        case 2: fixture_lights[0].flags=0; break; /* static light */
+        case 3: inventory[0]=0; fixture_weapon_count[0]=1; break; /* armed marker path */
+        case 4: vr_render.active=FALSE; break; /* flat/HUD/ended pass */
+        case 5: fixture_lights[0].object_index=1; break; /* remote owner */
+        }
+        light_get_bounding_sphere(0,&rendered,&radius);
+        light_compute_bounding_sphere(0,TRUE,FALSE,TRUE,&tick,&tick_radius);
+        point_equal(rendered,tick); CHECK(near(radius,tick_radius));
+        CHECK(!light_render_skips_clusters(&fixture_lights[0]));
+        lights_vr_include_unarmed_flashlights(); CHECK(lights_globals.scene_point_light_count==0);
+        if(scenario==3 || scenario==4) CHECK(data_next_calls==0);
+    }
+    /* Armed supersize convention remains exactly as before. */
+    flashlight_reset(); inventory[0]=0; fixture_weapon_count[0]=1;
+    fixture_lights[0].flags|=1u<<_point_light_attached_to_first_person_weapon_bit;
+    fixture_light_definition.flags|=1u<<_light_definition_supersize_in_first_person_bit;
+    CHECK(light_render_skips_clusters(&fixture_lights[0]));
+}
+'''
+
+
+def main():
+    render = (ROOT / 'port/linux/game/vr_render.c').read_text()
+    lights = (ROOT / 'source/objects/object_lights.c').read_text()
+    first_person = (ROOT / 'source/interface/first_person_weapons.c').read_text()
+    old_first_person = subprocess.check_output(['git', 'show', reticle.ORIGINAL_ENGINE_COMMIT +
+                                               ':source/interface/first_person_weapons.c'], cwd=ROOT, text=True)
+    assert reticle.function(first_person, 'first_person_weapon_center_flashlight') == reticle.function(old_first_person, 'first_person_weapon_center_flashlight'), 'Armed marker behavior changed'
+    old_lights = subprocess.check_output(['git', 'show', reticle.ORIGINAL_ENGINE_COMMIT +
+                                        ':source/objects/object_lights.c'], cwd=ROOT, text=True)
+    # Preserve recovered cone math and its simulation-only wrapper exactly.
+    old_body = reticle.function(old_lights, 'light_compute_bounding_sphere')
+    old_body = old_body[old_body.index('{'):].replace('struct light_datum *light = light_get(light_index);', '')
+    new_body = reticle.function(lights, 'light_compute_bounding_sphere_from_basis')
+    assert reticle.normalized(old_body) == reticle.normalized(new_body[new_body.index('{'):])
+    reconnect = reticle.function(lights, 'light_reconnect_to_map')
+    assert 'light_compute_render_bounding_sphere' not in reconnect and 'light_compute_bounding_sphere(' in reconnect
+    preprocess = reticle.function(lights, 'lights_preprocess_scene')
+    assert preprocess.index('lights_vr_include_unarmed_flashlights();') < preprocess.index('light_marker_end();')
+    assert preprocess.index('light_vr_unarmed_flashlight_pose(light, &light_parameters.position,') < preprocess.index('rasterizer_light_submit(')
+    helper = reticle.function(render, 'vr_render_player_flashlight_pose')
+    assert 'halo_vr_view(' not in helper and 'weapon_camera.position' in helper
+    names = ['light_vr_unarmed_flashlight_pose', 'lights_vr_include_unarmed_flashlights',
+             'light_compute_bounding_sphere_from_basis', 'light_compute_bounding_sphere',
+             'light_compute_render_bounding_sphere', 'light_render_skips_clusters',
+             'light_get_bounding_sphere', 'lights_render_diffuse', 'lights_render_specular']
+    production = helper + '\n\n' + '\n\n'.join(reticle.function(lights, name) for name in names)
+    extension = LIGHT_FIXTURE.replace('@@FLASHLIGHT_FUNCTIONS@@', production)
+    harness = reticle.HARNESS
+    view_header = (ROOT / 'port/linux/src/vr.h').read_text()
+    view_begin = view_header.index('struct halo_vr_view\n{')
+    view_end = reticle.block_end(view_header, view_header.index('{', view_begin))
+    harness = re.sub(r'struct halo_vr_view \{[^\n]+\};',
+                     lambda match: view_header[view_begin:view_end] + ';', harness)
+    harness = harness.replace('boolean active,crosshairs_drawn;',
+                              'boolean active,crosshairs_drawn,weapon_camera_set,weapon_camera_valid; struct render_camera weapon_camera;')
+    harness = harness.replace('static struct { struct render_camera camera; } render;',
+                              'static struct { struct render_camera camera; short local_player_index; } render;')
+    harness = harness.replace('int main(void) {', extension + '\nint main(void) {\n' +
+                              '    check_flashlight_render_refresh(); check_flashlight_rejection(); check_flashlight_bounds_and_clusters();')
+    reticle.HARNESS = harness
+    reticle.main()
+    print('PASS: actual render-rate flashlight pose, unchanged armed/tick math and read-only visibility/diffuse/specular bounds')
+
+
+if __name__ == '__main__':
+    main()
