+/* Shared pre-spread ray: both real shots and VR previews use these exact
+origin/aim/trigger-offset calculations. A preview may supply a render pose
+and never records an aim-assist target. */
+static long trigger_adjust_projectile_ray(
+	long owner_object_index,
+	struct unit_datum *unit,
+	struct weapon_trigger_definition const *trigger_definition,
+	real_point3d *origin,
+	real_vector3d *forward,
+	real *velocity,
+	real *error,
+	boolean preview,
+	struct projectile_preview_pose const *pose)
+{
+	long target_object_index = NONE;
+#ifndef HALO_VR
+	(void)preview;
+	(void)pose;
+#endif
+	if (!TEST_FLAG(trigger_definition->flags, _weapon_trigger_projectiles_cannot_be_aimed_bit) &&
+		unit &&
+		!TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+	{
+		struct unit_definition *unit_definition= unit_definition_get(unit->definition_index);
+		long player_index= unit->unit.player_index;
+		long actor_index= unit->unit.actor_index;
+		boolean adjust_origin;
+		boolean use_aiming_vector;
+
+		if (unit->unit.gunner_object_index!=NONE)
+		{
+			struct unit_datum *gunner= unit_get(unit->unit.gunner_object_index);
+
+			player_index= gunner->unit.player_index;
+			actor_index= gunner->unit.actor_index;
+		}
+
+		adjust_origin= TEST_FLAG(unit_definition->unit.flags, _unit_fires_from_camera_bit);
+		use_aiming_vector= TRUE;
+		if (actor_index!=NONE && actor_firing_blindly(actor_index))
+		{
+			use_aiming_vector= FALSE;
+		}
+		if (unit->unit.gunner_object_index!=NONE)
+		{
+			use_aiming_vector= FALSE;
+		}
+
+#ifdef HALO_VR
+		if (preview && !use_aiming_vector)
+			pose = NULL;
+		if (preview && pose)
+			unit_preview_projectile_ray(owner_object_index, origin, forward, velocity,
+				adjust_origin, use_aiming_vector, &pose->camera_position, &pose->forward);
+		else
+#endif
+		unit_adjust_projectile_ray(owner_object_index, origin, forward, velocity, adjust_origin, use_aiming_vector);
+
+		if (player_index!=NONE)
+		{
+			real_vector3d right;
+			real_vector3d up;
+
+			cross_product3d(global_up3d, forward, &right);
+			if (normalize3d(&right)==0.0f)
+			{
+				right= *global_left3d;
+			}
+			cross_product3d(forward, &right, &up);
+			normalize3d(&up);
+
+			point_from_line3d(
+				origin,
+				forward,
+				trigger_definition->first_person_weapon_offset.x,
+				origin);
+			point_from_line3d(
+				origin,
+				&right,
+				trigger_definition->first_person_weapon_offset.y,
+				origin);
+			point_from_line3d(
+				origin,
+				&up,
+				trigger_definition->first_person_weapon_offset.z,
+				origin);
+
+#ifdef HALO_VR
+			if (preview)
+			{
+				real length = magnitude3d(forward);
+				if (!isfinite(origin->x) || !isfinite(origin->y) || !isfinite(origin->z) ||
+					!isfinite(forward->i) || !isfinite(forward->j) || !isfinite(forward->k) ||
+					!isfinite(length) || length <= 0.0f)
+				{
+					/* Keep invalid preview data out of the shared aim assertions.
+					A zero output also makes the wrapper suppress this preview. */
+					forward->i = forward->j = forward->k = 0.0f;
+					return NONE;
+				}
+				target_object_index = player_preview_projectile_aim(player_index, origin, forward, pose);
+			}
+			else
+#endif
+				target_object_index = player_aim_projectile(player_index, origin, forward);
+		}
+		else if (actor_index!=NONE)
+		{
+			target_object_index= actor_aim_projectile(actor_index, origin, forward, error);
+		}
+	}
+	return target_object_index;
+}
