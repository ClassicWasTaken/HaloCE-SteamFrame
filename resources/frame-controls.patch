index 4379c9516d90c051e288a68122b522680618906b..cac1ba7b43500f691adb4f5131da9a14905a6aff 100644
--- a/port/linux/arm64/host_vr.c
+++ b/port/linux/arm64/host_vr.c
@@ -875,9 +875,20 @@ int host_vr_locate(struct vr_host_views *views)
 	XrViewState state = { XR_TYPE_VIEW_STATE };
 	XrView located[2] = { { XR_TYPE_VIEW }, { XR_TYPE_VIEW } };
 	XrSpaceLocation location = { XR_TYPE_SPACE_LOCATION };
+	const XrViewStateFlags eye_pose_flags = XR_VIEW_STATE_ORIENTATION_VALID_BIT | XR_VIEW_STATE_POSITION_VALID_BIT;
+	const XrSpaceLocationFlags space_pose_flags = XR_SPACE_LOCATION_ORIENTATION_VALID_BIT | XR_SPACE_LOCATION_POSITION_VALID_BIT;
 	uint32_t count = 0;
 	int eye, hand, valid;
 
+	/* A failed fresh locate must not keep a preceding frame's valid pose. */
+	for (eye = 0; eye < 2; eye++)
+		views->eye[eye].valid = 0;
+	views->head.valid = 0;
+	for (hand = 0; hand < 2; hand++)
+	{
+		views->aim[hand].valid = 0;
+		views->grip[hand].valid = 0;
+	}
 	if (!vr.frame_begun)
 		return 0;
 	locate.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
@@ -885,7 +896,8 @@ int host_vr_locate(struct vr_host_views *views)
 	locate.space = vr.play_space;
 	if (xrLocateViews(vr.session, &locate, &state, 2, &count, located) != XR_SUCCESS || count != 2)
 		return 0;
-	valid = (state.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT) != 0;
+	/* The game consumes both rotation and origin from these 6DoF poses. */
+	valid = (state.viewStateFlags & eye_pose_flags) == eye_pose_flags;
 	for (eye = 0; eye < 2; eye++)
 	{
 		pose_from_xr(&located[eye].pose, valid, &views->eye[eye]);
@@ -895,17 +907,17 @@ int host_vr_locate(struct vr_host_views *views)
 		views->fov[eye][3] = tanf(located[eye].fov.angleDown);
 	}
 	if (xrLocateSpace(vr.view_space, vr.play_space, vr.frame.predictedDisplayTime, &location) == XR_SUCCESS)
-		pose_from_xr(&location.pose, (location.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT) != 0, &views->head);
+		pose_from_xr(&location.pose, (location.locationFlags & space_pose_flags) == space_pose_flags, &views->head);
 	for (hand = 0; hand < 2; hand++)
 	{
 		location.type = XR_TYPE_SPACE_LOCATION;
 		location.next = NULL;
 		if (xrLocateSpace(vr.aim_spaces[hand], vr.play_space, vr.frame.predictedDisplayTime, &location) == XR_SUCCESS)
-			pose_from_xr(&location.pose, (location.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT) != 0,
+			pose_from_xr(&location.pose, (location.locationFlags & space_pose_flags) == space_pose_flags,
 				&views->aim[hand]);
 		location.type = XR_TYPE_SPACE_LOCATION;
 		if (xrLocateSpace(vr.grip_spaces[hand], vr.play_space, vr.frame.predictedDisplayTime, &location) == XR_SUCCESS)
-			pose_from_xr(&location.pose, (location.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT) != 0,
+			pose_from_xr(&location.pose, (location.locationFlags & space_pose_flags) == space_pose_flags,
 				&views->grip[hand]);
 	}
 	return 1;
diff --git a/port/linux/game/menu_functions.c b/port/linux/game/menu_functions.c
