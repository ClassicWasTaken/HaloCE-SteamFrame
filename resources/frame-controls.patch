+/* A weapon's flashlight marker is posed each render frame. Without a
+weapon, use that same rendered controller camera instead of the biped's
+30 Hz attachment. All outputs are presentation copies, shared by both eyes. */
+boolean vr_render_player_flashlight_pose(long unit_index, real_point3d *position,
+	real_vector3d *forward, real_vector3d *up)
+{
+	long player_index = local_player_get_player_index(0);
+	struct unit_datum *unit;
+	real_point3d ignored_origin, source;
+	real_vector3d direction, vertical;
+	real along, length;
+	if (!position || !forward || !up || !vr_render.active ||
+		!vr_render.weapon_camera_set || !vr_render.weapon_camera_valid ||
+		render.local_player_index != 0 || player_index == NONE || unit_index == NONE ||
+		(director_camera_scripted && *director_camera_scripted) ||
+		player_get(player_index)->unit_index != unit_index || !(unit = unit_try_and_get(unit_index)) ||
+		!halo_vr_aiming() || !halo_vr_gaze_tracking_valid() ||
+		!vr_render_unarmed_ray(player_index, unit_index, unit, &vr_render.view, vr_render.base_yaw,
+			&ignored_origin, &direction))
+		return FALSE;
+	source = vr_render.weapon_camera.position;
+	vertical = vr_render.weapon_camera.up;
+	if (!isfinite(source.x) || !isfinite(source.y) || !isfinite(source.z) ||
+		!isfinite(vertical.i) || !isfinite(vertical.j) || !isfinite(vertical.k))
+		return FALSE;
+	/* Preserve controller roll while accommodating the same pitch limits
+	used by the unarmed reticle; never apply body yaw or HMD pitch twice. */
+	along = dot_product3d(&vertical, &direction);
+	vertical.i -= direction.i * along;
+	vertical.j -= direction.j * along;
+	vertical.k -= direction.k * along;
+	length = magnitude3d(&vertical);
+	if (!isfinite(length) || length <= 0.00001f)
+		return FALSE;
+	normalize3d(&vertical);
+	*position = source;
+	*forward = direction;
+	*up = vertical;
+	return TRUE;
+}
