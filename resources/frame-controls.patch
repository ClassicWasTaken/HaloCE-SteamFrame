+static void check_stable_reopen_recentre(void) {
+    struct vr_host_pose anchor;
+    int frame;
+    fixture(); head_pose(2.4f, 0.3f, 0.1f); halo_vr_menus(1); submit(1, 1); check_front();
+    anchor = vr.menu_pose;
+    for (frame = 0; frame < 20; frame++) {
+        head_pose((float)frame*0.2f, -(float)frame*0.03f, 0.f);
+        vr.views.head.position[0] += 0.1f; vr.views.head.position[1] += 0.01f;
+        vr.views.head.position[2] -= 0.1f;
