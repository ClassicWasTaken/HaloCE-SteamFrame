+static boolean vr_render_unarmed_ray(long player_index, long unit_index, struct unit_datum *unit,
+	struct halo_vr_view const *view, real base_yaw, real_point3d *origin, real_vector3d *forward)
+{
+	struct projectile_preview_pose pose;
+	if (unit->unit.player_index != player_index ||
+		TEST_FLAG(unit->object.damage_flags, _object_dead_bit) ||
+		unit_get_weapon_count(unit_index) != 0 || cinematic_in_progress() ||
+		unit_inventory_get_weapon(unit_index, unit->unit.current_weapon_index) != NONE ||
+		!vr_render_pointing_pose(player_index, unit, view, base_yaw, &pose))
+		return FALSE;
+	*origin = pose.camera_position;
+	*forward = pose.forward;
+	return TRUE;
