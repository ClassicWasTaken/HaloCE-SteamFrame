+        fixture(); head_pose((float)yaw*(float)M_PI/180.f, (float)pitch*(float)M_PI/180.f, (float)roll*(float)M_PI/180.f);
+        memcpy(origin, vr.origin_position, sizeof(origin)); body = vr.body_yaw;
