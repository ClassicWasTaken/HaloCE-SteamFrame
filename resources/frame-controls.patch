+static void wheel_geometry_and_head_independence(void){
+ int sample;float yaw,pitch;
+ reset();register_driver(1);engage();
+ for(sample=-100;sample<=100;sample++){
+  float angle=sample*.012f,steer=-angle/((float)M_PI/4);
+  if(steer<-1)steer=-1;if(steer>1)steer=1;
+  wheel(angle);CHECK(halo_vr_vehicle_steering(.7f,1,.016f,&yaw,&pitch)==1);
+  CHECK(near(driving.wheel_steer,steer)&&near(yaw,.7f+steer*(float)M_PI/3)&&near(pitch,0));
+ }
+ wheel(.3f);CHECK(halo_vr_vehicle_steering(.7f,0,.016f,&yaw,&pitch)==1);
+ {
+  float saved=yaw;
+  for(sample=-60;sample<=60;sample++){
+   float angle=sample*.05f;
+   pose(&vr.views.head,angle,sample*.1f,1.2f+sample*.005f,-sample*.02f);
+   CHECK(halo_vr_vehicle_steering(.7f,0,.016f,&yaw,&pitch)==1&&near(yaw,saved));
+   /* Sideways roll and vertical head look also leave the captured plane. */
+   vr.views.head.orientation[0]=sinf(angle/2);vr.views.head.orientation[1]=0;
+   vr.views.head.orientation[2]=0;vr.views.head.orientation[3]=cosf(angle/2);
+   CHECK(halo_vr_vehicle_steering(.7f,0,.016f,&yaw,&pitch)==1&&near(yaw,saved));
+   vr.views.head.orientation[0]=0;vr.views.head.orientation[2]=sinf(angle/2);
+   CHECK(halo_vr_vehicle_steering(.7f,0,.016f,&yaw,&pitch)==1&&near(yaw,saved));
+  }
+ }
+ /* First engagement from a pitched/yawed pose captures that fixed axis. */
+ for(sample=-30;sample<=30;sample++){
+  struct halo_vr_driving_state state={0};float axis[3]={sinf(sample*.05f),0,-cosf(sample*.05f)};
+  float left[3]={-.2f*cosf(sample*.05f),1,-.2f*sinf(sample*.05f)};
+  float right[3]={-left[0],1,-left[2]};
+  CHECK(halo_vr_driving_wheel(&state,axis,left,right)&&near(state.wheel_steer,0));
+  axis[0]=1;axis[1]=axis[2]=0;
+  CHECK(halo_vr_driving_wheel(&state,axis,left,right)&&near(state.wheel_steer,0));
+ }
+ {
+  struct halo_vr_driving_state state={0};float axis[3]={0,0,-1},left[3]={0,0,0},right[3]={0,0,0},line[3];
+  right[0]=.10f;CHECK(halo_vr_driving_line(axis,left,right,line));
+  right[0]=1.20f;CHECK(halo_vr_driving_line(axis,left,right,line));
+  right[0]=.099f;CHECK(!halo_vr_driving_line(axis,left,right,line));
+  right[0]=1.201f;CHECK(!halo_vr_driving_line(axis,left,right,line));
+  right[0]=0;right[2]=.4f;CHECK(!halo_vr_driving_line(axis,left,right,line));
+  right[0]=.4f;right[2]=0;axis[0]=NAN;CHECK(!halo_vr_driving_wheel(&state,axis,left,right));
+  axis[0]=axis[2]=0;CHECK(!halo_vr_driving_wheel(&state,axis,left,right));
+ }
+}
