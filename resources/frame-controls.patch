+    assert any(call[-1] == 20.0 for call in calls(scripts['test_looking_tech'], 'objects_can_see_object'))
+    # The five actual named targets are scenery; success variants are different names.
+    name_count, name_table = u32(scenario + 516), u32(scenario + 520) - magic
+    assert 5 <= name_count < 65536 and 0 <= name_table <= len(data) - name_count*36
