+    assert '_collision_test_for_projectiles_flags' in point and '*point = collision.point;' in point
+    crosshairs = function(render, 'vr_render_crosshairs')
+    assert crosshairs.count('vr_render_projectile_point(') == 1
+    assert 'CROSSHAIR_SMOOTHING' not in render and 'crosshair_inverse_distance' not in render
+    print('PASS: pinned unit/firing/aim NULL math identical; preview/HUD/collision contracts')
