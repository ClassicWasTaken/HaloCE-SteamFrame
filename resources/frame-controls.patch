+static boolean vr_render_pointing_pose(long player_index, struct unit_datum *unit,
+	struct halo_vr_view const *view, real base_yaw, struct projectile_preview_pose *pose)
+{
+	struct unit_definition *definition;
+	struct observer_result const *observer;
+	real length;
+	if (player_index != local_player_get_player_index(0) ||
+		unit->object.type != _object_type_biped || unit->object.parent_object_index != NONE ||
+		unit->unit.gunner_object_index != NONE ||
+		director_get_perspective(0) != _director_perspective_first_person || director_inhibited_facing(0))
+		return FALSE;
+	definition = unit_definition_get(unit->definition_index);
+	if (!TEST_FLAG(definition->unit.flags, _unit_fires_from_camera_bit) ||
+		definition->unit.aiming_velocity_maximum != 0.0f || definition->unit.aiming_acceleration_maximum != 0.0f)
+		return FALSE;
+	if (view->controller_aim)
+	{
+		real yaw, pitch, horizontal;
+		view_vector(view, base_yaw, 0.0f, view->hand_forward, &pose->forward);
+		length = magnitude3d(&pose->forward);
+		if (!isfinite(length) || length <= 0.0f)
+			return FALSE;
+		normalize3d(&pose->forward);
+		yaw = (real)atan2(pose->forward.j, pose->forward.i);
+		pitch = PIN((real)asin(PIN(pose->forward.k, -1.0f, 1.0f)),
+			-DEGREES_TO_RADIANS(85.0f), DEGREES_TO_RADIANS(85.0f));
+		horizontal = (real)cos(pitch);
+		pose->forward.i = horizontal * (real)cos(yaw);
+		pose->forward.j = horizontal * (real)sin(yaw);
+		pose->forward.k = (real)sin(pitch);
