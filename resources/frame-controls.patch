+    CHECK(halo_vr_view(&view)); CHECK(near(view.body_yaw,2.1f));
+    CHECK(near(view.head_forward[0],1) && near(view.head_forward[1],0));
+    for(axis=0;axis<3;axis++) CHECK(near(view.head_position[axis],0));
+    CHECK(halo_vr_aim(-2,0,&yaw,&pitch)==1); CHECK(near(yaw,2.1f));
+    CHECK(near(vr.body_yaw,saved_body)); CHECK(!memcmp(saved_origin,vr.origin_position,sizeof(saved_origin)));
+    /* Lean and look remain relative to the entry pose while the vehicle turns.
