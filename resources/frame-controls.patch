+enum { _light_definition_no_specular_bit=1, _light_definition_supersize_in_first_person_bit=3,
+       _light_definition_is_first_person_flashlight_bit=4 };
+struct light_datum {
+    unsigned flags; long definition_index,object_index,parent_light_index,rasterizer_light_index; short function_index;
+    real_point3d position; real_vector3d forward,up; real radius;
+};
+struct point_light_definition {
+    unsigned flags; real radius,radius_modifier_upper_bound,cutoff_angle,lens_flare_radius;
+    real runtime_cosine_cutoff_angle,runtime_sine_cutoff_angle,specular_radius_multiplier;
+};
+static struct light_datum fixture_lights[4];
+static struct point_light_definition fixture_light_definition;
+static struct { short scene_point_light_count; long scene_point_lights[MAXIMUM_RENDERED_LIGHTS]; } lights_globals;
+static int light_data=1,marked[4],cluster_reads,diffuse_calls,specular_calls,diffuse_skip,specular_skip,data_next_calls;
+static real_point3d diffuse_center,specular_center;
+static real diffuse_radius,specular_radius;
+static real fixture_light_intensity;
+static boolean object_get_function_value(long object_index,short function_index,real *value) {
+    CHECK(object_index==0 && function_index==0); *value=fixture_light_intensity; return TRUE;
+}
+static struct light_datum *light_get(long index) { CHECK(index>=0 && index<4); return &fixture_lights[index]; }
+static struct point_light_definition *light_definition_get(long index) { CHECK(index==0); return &fixture_light_definition; }
+static long data_next_index(int data,long index) { CHECK(data==light_data); data_next_calls++; return index<3 ? index+1 : NONE; }
+static boolean light_unmarked(long index) { CHECK(index>=0 && index<4); return !marked[index]; }
+static boolean light_mark(long index) { CHECK(index>=0 && index<4); marked[index]=1; return TRUE; }
+static boolean should_render_lights(void) { return TRUE; }
+static short light_build_cluster_array(long index,short maximum,short *clusters) {
+    CHECK(index>=0 && index<4 && maximum==MAXIMUM_CLUSTERS_PER_LIGHT); cluster_reads++; clusters[0]=17; return 1;
+}
+static void rasterizer_environment_diffuse_lights_begin(void) { }
+static void rasterizer_environment_diffuse_lights_end(void) { }
+static void rasterizer_environment_specular_lights_begin(void) { }
+static void rasterizer_environment_specular_lights_end(void) { }
+static void structure_render_diffuse_light(long index,real_point3d const *center,real radius,short count,short const *clusters) {
+    CHECK(index==3); diffuse_calls++; diffuse_center=*center; diffuse_radius=radius;
+    diffuse_skip=clusters==NULL; CHECK(count==(diffuse_skip ? 0 : 1));
+}
+static void structure_render_specular_light(long index,real_point3d const *center,real radius,short count,short const *clusters) {
+    CHECK(index==3); specular_calls++; specular_center=*center; specular_radius=radius;
+    specular_skip=clusters==NULL; CHECK(count==(specular_skip ? 0 : 1));
+}
+@@FLASHLIGHT_FUNCTIONS@@
+static void flashlight_reset(void) {
+    int index;
+    reset(); inventory[0]=NONE; fixture_weapon_count[0]=0;
+    unit_definitions[0].unit.flags=1u<<_unit_fires_from_camera_bit;
+    vr_render.weapon_camera_set=TRUE; vr_render.weapon_camera_valid=TRUE;
