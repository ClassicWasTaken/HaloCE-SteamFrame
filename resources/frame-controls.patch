+    data_next_calls=0;
+    fixture_light_intensity=1;
+}
+static void check_flashlight_render_refresh(void) {
+    int frame;
+    real_point3d position,expected_position,ignored_origin;
+    real_vector3d forward,up,expected_forward;
+    struct light_datum tick;
+    flashlight_reset(); tick=fixture_lights[0];
+    /* Ninety rendered poses with a completely unchanged simulation unit/light. */
+    for(frame=0;frame<90;frame++) {
+        real angle=(real)frame*0.025f, pitch=sinf(angle)*0.7f;
+        vr_render.base_yaw=0.5f;
+        vr_render.view.hand_forward[0]=cosf(angle)*cosf(pitch);
+        vr_render.view.hand_forward[1]=sinf(angle)*cosf(pitch);
+        vr_render.view.hand_forward[2]=sinf(pitch);
+        vr_render.weapon_camera.position.z=(real)frame*0.003f;
+        expected_position=vr_render.weapon_camera.position;
+        CHECK(vr_render_unarmed_ray(0,0,&units[0],&vr_render.view,vr_render.base_yaw,&ignored_origin,&expected_forward));
+        CHECK(vr_render_player_flashlight_pose(0,&position,&forward,&up));
+        point_equal(position,expected_position); direction_equal(forward,expected_forward);
+        CHECK(near(dot_product3d(&forward,&up),0)); CHECK(near(magnitude3d(&up),1));
+        CHECK(memcmp(&tick,&fixture_lights[0],sizeof(tick))==0);
+        direction_equal(units[0].unit.aiming_vector,(real_vector3d){1,0,0});
