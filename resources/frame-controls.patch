+/* Seat acceleration animates the biped's head, which is unsuitable as a VR
+camera anchor. Authored camera markers stay attached to the rendered vehicle.
+The stock Warthog driver omits its tag's camera name even though its model
+contains the intended camera driver marker. Use its position, never rotation. */
+static boolean vr_render_vehicle_camera_position(long unit_index, real_point3d *position)
+{
+	static struct { boolean valid; long unit, parent; short seat; real_point3d offset; } fallback;
+	long player_index = local_player_get_player_index(0);
+	struct unit_datum *unit, *parent;
+	struct unit_definition *definition;
+	struct unit_seat *seat;
+	struct object_marker marker;
+	real_matrix4x3 const *root;
+	real_point3d head, result;
+	const char *name, *vehicle_name;
+	long parent_index;
+	short seat_index, row, column, other;
+	real dot;
+	if (!position || player_index == NONE || unit_index == NONE || cinematic_in_progress() ||
+		(director_camera_scripted && *director_camera_scripted) ||
+		director_get_perspective(0) == _director_perspective_scripted ||
+		player_get(player_index)->unit_index != unit_index ||
+		!(unit = unit_try_and_get(unit_index)) || unit->unit.player_index != player_index ||
+		unit->object.type != _object_type_biped || TEST_FLAG(unit->object.damage_flags, _object_dead_bit))
+		goto invalid_seat;
+	parent_index = unit->object.parent_object_index;
+	seat_index = unit->unit.parent_seat_index;
+	if (parent_index == NONE || !(parent = unit_try_and_get(parent_index)) ||
+		parent->object.type != _object_type_vehicle || TEST_FLAG(parent->object.damage_flags, _object_dead_bit))
+		goto invalid_seat;
+	definition = unit_definition_get(parent->definition_index);
+	if (seat_index < 0 || seat_index >= definition->unit.seats.count)
+		goto invalid_seat;
+	seat = TAG_BLOCK_GET_ELEMENT(&definition->unit.seats, seat_index, struct unit_seat);
+	name = seat->camera.marker_name;
+	if (!memchr(name, 0, sizeof(seat->camera.marker_name)))
+		goto invalid_seat;
+	if (!*name)
+	{
+		vehicle_name = tag_get_name(parent->definition_index);
+		if (TEST_FLAG(seat->flags, _unit_seat_driver_bit) && vehicle_name &&
+			!strcmp(vehicle_name, "vehicles\\warthog\\warthog"))
+			name = "camera driver";
+	}
+	if (*name && object_get_marker_by_name(parent_index, name, &marker, 1))
+	{
+		if (!isfinite(marker.matrix.position.x) || !isfinite(marker.matrix.position.y) ||
+			!isfinite(marker.matrix.position.z))
+			goto invalid_seat;
+		fallback.valid = FALSE;
+		*position = marker.matrix.position;
+		return TRUE;
+	}
+	/* Linking precedes boarding animation/interpolation. Until it finishes,
+	let the caller use the live head rather than freezing its outside pose.
+	Afterward retain one head offset in the hull root, not the lean-animated
+	biped or a rotating turret. Full salted identities prevent datum reuse. */
+	if (unit->unit.animation.state == _unit_state_entering_seat ||
+		unit->unit.animation.state == _unit_state_exiting_seat)
+		goto invalid_seat;
+	root = object_get_node_matrix(parent_index, 0);
+	if (!root || !isfinite(root->scale) || fabs(root->scale) < 0.000001f)
+		goto invalid_seat;
+	for (row = 0; row < 4; row++)
+		for (column = 0; column < 3; column++)
+			if (!isfinite(root->n[row][column]))
+				goto invalid_seat;
+	/* The engine's inverse assumes an orthonormal basis and uniform scale.
+	Finite, unit, perpendicular axes make that inverse well-defined (also
+	for a mirrored root). A singular or distorted matrix keeps the old path. */
+	for (row = 0; row < 3; row++)
