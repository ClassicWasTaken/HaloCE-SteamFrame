+		if (!settings.gamepad_aim && (driving.mode != HALO_VR_DRIVING_NONE || mode != HALO_VR_DRIVING_NONE))
+			driving.turn_blocked = 1;
+		driving.mode = mode;
+		driving.align = mode != HALO_VR_DRIVING_NONE;
+		driving_reset(1);
+		driving.accelerator_blocked = 1;
+		if (mode != HALO_VR_DRIVING_NONE && mode != HALO_VR_DRIVING_WARTHOG)
