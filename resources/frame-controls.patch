+static int menu_pointer_panel_valid(const struct vr_host_pose *panel, const float size[2])
+{
+	float orientation[4];
+	int axis;
+	if (!panel || !size || !panel->valid || !isfinite(size[0]) || !isfinite(size[1]) ||
