 	/* a gamepad's Back held (halo_vr_gamepad_back), and for how long */
@@ -1044,6 +1048,47 @@ int halo_vr_view(struct halo_vr_view *view)
 
 /* ---------- aiming */
 
+int halo_vr_tutorial_look(float *yaw, float *pitch)
+{
+	static const float forwards[3] = { 0.0f, 0.0f, -1.0f };
+	const float threshold = 0.01f; /* about half a degree; ignore tracking jitter */
+	float pointing[3], facing[3], head_yaw, head_pitch;
+
+	*yaw = *pitch = 0.0f;
+	if (!vr.initialized || !(vr.frame || vr.pending) || !vr.views.should_render ||
+		!vr.views.focused || !vr.views.head.valid || vr.menus || !settings.controller_aim)
+	{
+		vr.tutorial_head_valid = 0;
+		return 0;
+	}
+	/* Use the tracking space, rather than body_yaw or the recentred origin:
+	stick turns and recentring must not count as physical head movement. */
+	quaternion_rotate(vr.views.head.orientation, forwards, pointing);
+	game_axes(pointing, 0.0f, facing);
+	head_yaw = atan2f(facing[1], facing[0]);
+	head_pitch = asinf(facing[2] < -1.0f ? -1.0f : facing[2] > 1.0f ? 1.0f : facing[2]);
+	if (!vr.tutorial_head_valid)
+	{
+		vr.tutorial_head_valid = 1;
+		vr.tutorial_head_yaw = head_yaw;
+		vr.tutorial_head_pitch = head_pitch;
+		return 0;
+	}
+	*yaw = remainderf(head_yaw - vr.tutorial_head_yaw, 2.0f * (float)M_PI);
+	*pitch = head_pitch - vr.tutorial_head_pitch;
+	/* Keep each anchor until movement crosses the threshold, so a slow
+	look still counts and sub-threshold jitter does not. */
+	if (fabsf(*yaw) >= threshold)
+		vr.tutorial_head_yaw = head_yaw;
+	else
+		*yaw = 0.0f;
+	if (fabsf(*pitch) >= threshold)
+		vr.tutorial_head_pitch = head_pitch;
+	else
+		*pitch = 0.0f;
+	return *yaw != 0.0f || *pitch != 0.0f;
+}
+
